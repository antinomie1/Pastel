// 2D logical geometry primitives for Pastel.

/// A 2D point in logical pixels.
pub struct Point {
    pub x: f64 = 0.0
    pub y: f64 = 0.0
}

/// A 2D size in logical pixels.
pub struct Size {
    pub w: f64 = 0.0
    pub h: f64 = 0.0
}

/// An axis-aligned rectangle in logical pixels.
pub struct Rect {
    pub x: f64 = 0.0
    pub y: f64 = 0.0
    pub w: f64 = 0.0
    pub h: f64 = 0.0
}

pub fn Rect.new(x: f64, y: f64, w: f64, h: f64) -> Rect {
    return Rect { x, y, w: max(w, 0.0), h: max(h, 0.0) }
}

pub fn Rect.right(self) -> f64 {
    return self.x + self.w
}

pub fn Rect.bottom(self) -> f64 {
    return self.y + self.h
}

pub fn Rect.center(self) -> Point {
    return Point { x: self.x + self.w * 0.5, y: self.y + self.h * 0.5 }
}

pub fn Rect.is_empty(self) -> bool {
    return self.w <= 0.0 or self.h <= 0.0
}

pub fn Rect.contains(self, px: f64, py: f64) -> bool {
    return px >= self.x and py >= self.y and px < self.x + self.w and py < self.y + self.h
}

pub fn Rect.overlaps(self, other: Rect) -> bool {
    if self.is_empty() or other.is_empty() {
        return false
    }
    return self.x < other.right() and self.right() > other.x and self.y < other.bottom() and self.bottom() > other.y
}

pub fn Rect.intersect(self, other: Rect) -> Rect {
    let x0 = max(self.x, other.x)
    let y0 = max(self.y, other.y)
    let x1 = min(self.right(), other.right())
    let y1 = min(self.bottom(), other.bottom())
    if x1 <= x0 or y1 <= y0 {
        return Rect {}
    }
    return Rect { x: x0, y: y0, w: x1 - x0, h: y1 - y0 }
}

pub fn Rect.grow(self, delta: f64) -> Rect {
    return Rect.new(self.x - delta, self.y - delta, self.w + delta * 2.0, self.h + delta * 2.0)
}

pub fn Rect.inset(self, margin: f64) -> Rect {
    return self.grow(-margin)
}

pub fn Rect.lerp(self, other: Rect, t: f64) -> Rect {
    return Rect {
        x: self.x + (other.x - self.x) * t,
        y: self.y + (other.y - self.y) * t,
        w: self.w + (other.w - self.w) * t,
        h: self.h + (other.h - self.h) * t,
    }
}
