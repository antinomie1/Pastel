// Retargetable scalar, rectangle, and color animations evaluated at CLOCK_MONOTONIC ns.

import geom
import color
import curve

let ns_to_s: f64 = 1.0e-9

/// A single retargetable animated scalar preserving velocity across target changes.
pub struct Anim {
    pub x0: f64 = 0.0
    pub v0: f64 = 0.0
    pub target: f64 = 0.0
    pub t0: int = 0
    pub spec: curve.CurveSpec = curve.CurveSpec.Spring(curve.Spring {})
    pub active: bool = false
    pub eps: f64 = 0.05
    pub max_duration_s: f64 = 5.0
}

pub fn Anim.new(initial: f64) -> Anim {
    return Anim { x0: initial, target: initial, active: false }
}

/// Normalized animation (0.0..1.0) with tighter settling tolerance.
pub fn Anim.unit(initial: f64) -> Anim {
    return Anim { x0: initial, target: initial, active: false, eps: 0.001 }
}

/// Immediately jump to `value` and stop animating.
pub fn Anim.snap(mut self, value: f64) {
    self.x0 = value
    self.v0 = 0.0
    self.target = value
    self.active = false
}

/// Retarget smoothly toward `next_target` from the current position and velocity at `now_ns`.
pub fn Anim.retarget(mut self, next_target: f64, spec: curve.CurveSpec, now_ns: int, enabled: bool, slowdown: f64) {
    if not enabled {
        self.snap(next_target)
        return
    }
    if not self.active and (self.target - next_target).abs() <= self.eps * 0.25 {
        self.snap(next_target)
        return
    }
    if self.active and (self.target - next_target).abs() <= self.eps * 0.25 {
        return
    }
    let (cur_pos, cur_vel) = self.sample(now_ns)
    self.x0 = cur_pos
    self.v0 = cur_vel
    self.target = next_target
    self.t0 = now_ns
    self.spec = spec.scaled(slowdown)
    self.max_duration_s = 5.0 * max(slowdown, 1.0)
    self.active = true
}

/// Evaluate `(position, velocity)` at `now_ns` without mutating state.
pub fn Anim.sample(self, now_ns: int) -> (f64, f64) {
    guard self.active else {
        return (self.target, 0.0)
    }
    let elapsed = max(f64(now_ns - self.t0) * ns_to_s, 0.0)
    return self.spec.eval(elapsed, self.x0, self.v0, self.target)
}

/// Evaluate position at `now_ns` and settle to `target` if done.
pub fn Anim.tick(mut self, now_ns: int) -> f64 {
    guard self.active else {
        return self.target
    }
    let elapsed = max(f64(now_ns - self.t0) * ns_to_s, 0.0)
    let (pos, vel) = self.spec.eval(elapsed, self.x0, self.v0, self.target)
    let done = match self.spec {
        Ease => self.spec.settled(elapsed, self.x0, self.v0, self.target)
        Spring => elapsed >= self.max_duration_s or ((pos - self.target).abs() <= self.eps and vel.abs() <= self.eps * 10.0)
    }
    if done {
        self.snap(self.target)
        return self.target
    }
    return pos
}

/// Retargetable 4-channel rectangle animation.
pub struct AnimRect {
    pub x: Anim
    pub y: Anim
    pub w: Anim
    pub h: Anim
}

pub fn AnimRect.new(r: geom.Rect) -> AnimRect {
    return AnimRect { x: Anim.new(r.x), y: Anim.new(r.y), w: Anim.new(r.w), h: Anim.new(r.h) }
}

pub fn AnimRect.snap(mut self, r: geom.Rect) {
    self.x.snap(r.x)
    self.y.snap(r.y)
    self.w.snap(r.w)
    self.h.snap(r.h)
}

pub fn AnimRect.retarget(mut self, r: geom.Rect, spec: curve.CurveSpec, now_ns: int, enabled: bool, slowdown: f64) {
    self.x.retarget(r.x, spec, now_ns, enabled, slowdown)
    self.y.retarget(r.y, spec, now_ns, enabled, slowdown)
    self.w.retarget(r.w, spec, now_ns, enabled, slowdown)
    self.h.retarget(r.h, spec, now_ns, enabled, slowdown)
}

pub fn AnimRect.tick(mut self, now_ns: int) -> geom.Rect {
    return geom.Rect {
        x: self.x.tick(now_ns),
        y: self.y.tick(now_ns),
        w: max(self.w.tick(now_ns), 1.0),
        h: max(self.h.tick(now_ns), 1.0),
    }
}

pub fn AnimRect.is_active(self) -> bool {
    return self.x.active or self.y.active or self.w.active or self.h.active
}

pub fn AnimRect.target_center(self) -> geom.Point {
    return geom.Point { x: self.x.target + self.w.target * 0.5, y: self.y.target + self.h.target * 0.5 }
}

/// Retargetable RGBA color transition (e.g. focus ring color).
pub struct AnimColor {
    pub from: color.Color
    pub to: color.Color
    pub progress: Anim
}

pub fn AnimColor.new(initial: color.Color) -> AnimColor {
    return AnimColor { from: initial, to: initial, progress: Anim.unit(1.0) }
}

pub fn AnimColor.snap(mut self, c: color.Color) {
    self.from = c
    self.to = c
    self.progress.snap(1.0)
}

pub fn AnimColor.retarget(mut self, target: color.Color, spec: curve.CurveSpec, now_ns: int, enabled: bool, slowdown: f64) {
    if self.to == target {
        return
    }
    let cur = self.sample(now_ns)
    if not enabled {
        self.snap(target)
        return
    }
    self.from = cur
    self.to = target
    self.progress.snap(0.0)
    self.progress.retarget(1.0, spec, now_ns, true, slowdown)
}

pub fn AnimColor.sample(self, now_ns: int) -> color.Color {
    let (p, _) = self.progress.sample(now_ns)
    return self.from.lerp(self.to, f32(p))
}

pub fn AnimColor.tick(mut self, now_ns: int) -> color.Color {
    let p = self.progress.tick(now_ns)
    return self.from.lerp(self.to, f32(p))
}

pub fn AnimColor.is_active(self) -> bool {
    return self.progress.active
}
