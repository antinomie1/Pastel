// Thread-safe Visual Effect Sheet shared between the compositor loop and PastelRenderer.

import std.sync
import pastel_core as core

/// Dual-Kawase blur parameters.
pub struct BlurSettings {
    pub enabled: bool = true
    pub xray: bool = true
    pub passes: int = 2
    pub offset: f32 = 2.0
}

/// Visual decoration attached to a window or overlay in output-pixel coordinates.
pub struct WindowEffect {
    /// Non-zero for compositor images (e.g. hotkey overlay: `(1<<63) | (idx<<32) | gen`).
    /// Zero for client windows (matched by output-pixel geometry).
    pub key: u64 = 0
    pub x: f32 = 0.0
    pub y: f32 = 0.0
    pub w: f32 = 0.0
    pub h: f32 = 0.0
    /// Corner radius in output pixels (0.0 = crisp square corners).
    pub radius: f32 = 0.0
    /// Hollow border width in output pixels (0.0 disables).
    pub border_width: f32 = 0.0
    /// Straight-alpha RGBA border color.
    pub border_color: vec4 = zeroed()
    /// Soft drop shadow spread in output pixels.
    pub shadow_size: f32 = 0.0
    /// Straight-alpha RGBA shadow color.
    pub shadow_color: vec4 = zeroed()
    /// Enable frosted-glass backdrop blur behind this element.
    pub blur: bool = false
    /// True = blur only background/wallpaper (X-Ray); false = live backdrop blur.
    pub blur_xray: bool = true
    /// Blur backdrop opacity (0..1, follows window/overlay fade animation).
    pub blur_opacity: f32 = 1.0
    /// True when this element is a floating window or overlay (drawn above tiled windows).
    pub is_overlay: bool = false
}

/// Fading visual ghost emitted while a closed window runs its `[animation].window-close` curve.
pub struct ClosingEffect {
    pub x: f32 = 0.0
    pub y: f32 = 0.0
    pub w: f32 = 0.0
    pub h: f32 = 0.0
    pub radius: f32 = 0.0
    pub border_width: f32 = 0.0
    pub border_color: vec4 = zeroed()
    pub shadow_size: f32 = 0.0
    pub shadow_color: vec4 = zeroed()
    pub fill_color: vec4 = zeroed()
    pub opacity: f32 = 0.0
}

/// Compact segmented tab indicator pill bar drawn above a tabbed column in output pixels.
pub struct TabBar {
    pub x: f32 = 0.0
    pub y: f32 = 0.0
    pub w: f32 = 0.0
    pub h: f32 = 0.0
    pub count: int = 1
    pub active_idx: int = 0
    pub active_color: vec4 = zeroed()
    pub inactive_color: vec4 = zeroed()
    pub radius: f32 = 0.0
}

/// Workspace backdrop and highlight frame drawn behind thumbnails in Overview mode.
pub struct OverviewFrame {
    pub x: f32 = 0.0
    pub y: f32 = 0.0
    pub w: f32 = 0.0
    pub h: f32 = 0.0
    pub border_width: f32 = 0.0
    pub border_color: vec4 = zeroed()
    pub fill_color: vec4 = zeroed()
    pub radius: f32 = 0.0
}

/// Per-output visual state pushed from the compositor before each layout update.
pub struct OutputEffects {
    pub background: vec4 = zeroed()
    pub blur: BlurSettings = BlurSettings {}
    pub items: List[WindowEffect] = []
    pub closing: List[ClosingEffect] = []
    pub tabs: List[TabBar] = []
    pub frames: List[OverviewFrame] = []
    pub generation: u64 = 0
}

pub fn same_blur(a: BlurSettings, b: BlurSettings) -> bool {
    return a.enabled == b.enabled and a.xray == b.xray and a.passes == b.passes and a.offset == b.offset
}

pub fn same_effect(a: WindowEffect, b: WindowEffect) -> bool {
    return a.key == b.key and a.x == b.x and a.y == b.y and a.w == b.w and a.h == b.h and a.radius == b.radius and a.border_width == b.border_width and a.border_color == b.border_color and a.shadow_size == b.shadow_size and a.shadow_color == b.shadow_color and a.blur == b.blur and a.blur_xray == b.blur_xray and a.blur_opacity == b.blur_opacity and a.is_overlay == b.is_overlay
}

pub fn same_closing(a: ClosingEffect, b: ClosingEffect) -> bool {
    return a.x == b.x and a.y == b.y and a.w == b.w and a.h == b.h and a.radius == b.radius and a.border_width == b.border_width and a.border_color == b.border_color and a.shadow_size == b.shadow_size and a.shadow_color == b.shadow_color and a.fill_color == b.fill_color and a.opacity == b.opacity
}

pub fn same_tab(a: TabBar, b: TabBar) -> bool {
    return a.x == b.x and a.y == b.y and a.w == b.w and a.h == b.h and a.count == b.count and a.active_idx == b.active_idx and a.active_color == b.active_color and a.inactive_color == b.inactive_color and a.radius == b.radius
}

pub fn same_frame(a: OverviewFrame, b: OverviewFrame) -> bool {
    return a.x == b.x and a.y == b.y and a.w == b.w and a.h == b.h and a.border_width == b.border_width and a.border_color == b.border_color and a.fill_color == b.fill_color and a.radius == b.radius
}

fn same_output_effects(cur: OutputEffects, bgv: vec4, blur: BlurSettings, items: Slice[WindowEffect], closing: Slice[ClosingEffect], tabs: Slice[TabBar], frames: Slice[OverviewFrame]) -> bool {
    guard cur.background == bgv and same_blur(cur.blur, blur) else {
        return false
    }
    guard cur.items.len() == items.len() and cur.closing.len() == closing.len() and cur.tabs.len() == tabs.len() and cur.frames.len() == frames.len() else {
        return false
    }
    for i in 0..items.len() {
        if not same_effect(cur.items[i], items[i]) {
            return false
        }
    }
    for i in 0..closing.len() {
        if not same_closing(cur.closing[i], closing[i]) {
            return false
        }
    }
    for i in 0..tabs.len() {
        if not same_tab(cur.tabs[i], tabs[i]) {
            return false
        }
    }
    for i in 0..frames.len() {
        if not same_frame(cur.frames[i], frames[i]) {
            return false
        }
    }
    return true
}

fn copy_output_effects(src: OutputEffects, mut dst: OutputEffects) {
    dst.background = src.background
    dst.blur = src.blur
    dst.generation = src.generation
    dst.items.clear()
    for it in src.items {
        dst.items.push(it)
    }
    dst.closing.clear()
    for cf in src.closing {
        dst.closing.push(cf)
    }
    dst.tabs.clear()
    for tb in src.tabs {
        dst.tabs.push(tb)
    }
    dst.frames.clear()
    for fr in src.frames {
        dst.frames.push(fr)
    }
}

pub struct SheetData {
    pub outputs: List[OutputEffects] = []
    pub generation: u64 = 0
}

/// Cloneable shared handle to the DWM visual effect sheet.
pub struct EffectSheet {
    inner: sync.Mutex[SheetData]
}

pub fn EffectSheet.new() -> EffectSheet {
    return EffectSheet { inner: sync.mutex(SheetData {}) }
}

pub fn EffectSheet.clone(self) -> EffectSheet {
    return EffectSheet { inner: self.inner.clone() }
}

/// Update output `o`'s window effects atomically, bumping the sheet generation when changed.
pub fn EffectSheet.set_output(self, o: int, bg: core.Color, blur: BlurSettings, take items: List[WindowEffect]) {
    let empty_closing: List[ClosingEffect] = []
    let empty_tabs: List[TabBar] = []
    let empty_frames: List[OverviewFrame] = []
    self.set_output_all(o, bg, blur, items, empty_closing, empty_tabs, empty_frames)
}

/// Update output `o`'s full effect state (windows, closing ghosts, tab bars, overview frames) atomically.
/// Skips generation bumps and list allocations when the output's effect state is unchanged.
pub fn EffectSheet.set_output_all(self, o: int, bg: core.Color, blur: BlurSettings, take items: List[WindowEffect], take closing: List[ClosingEffect], take tabs: List[TabBar], take frames: List[OverviewFrame]) {
    let bgv = bg.premul()
    let copy = items
    let ccopy = closing
    let tcopy = tabs
    let fcopy = frames
    self.inner.write(fn(mut s: SheetData) {
        while s.outputs.len() <= o {
            s.outputs.push(OutputEffects {})
        }
        if s.outputs[o].generation > 0 and same_output_effects(s.outputs[o], bgv, blur, copy, ccopy, tcopy, fcopy) {
            return
        }
        s.generation += 1
        s.outputs[o].background = bgv
        s.outputs[o].blur = blur
        s.outputs[o].generation = s.generation
        s.outputs[o].items.clear()
        for it in copy {
            s.outputs[o].items.push(it)
        }
        s.outputs[o].closing.clear()
        for cf in ccopy {
            s.outputs[o].closing.push(cf)
        }
        s.outputs[o].tabs.clear()
        for tb in tcopy {
            s.outputs[o].tabs.push(tb)
        }
        s.outputs[o].frames.clear()
        for fr in fcopy {
            s.outputs[o].frames.push(fr)
        }
    })
}

/// Copy output `o`'s current effects into `dst` (reusing its list capacities) ONLY if its
/// generation differs from `known_gen`. Returns `true` when `dst` was updated.
pub fn EffectSheet.snapshot_into(self, o: int, known_gen: u64, mut dst: OutputEffects) -> bool {
    var updated = false
    self.inner.read(fn(s: SheetData) {
        if o < 0 or o >= s.outputs.len() {
            if known_gen != 0 {
                dst.background = zeroed()
                dst.blur = BlurSettings {}
                dst.items.clear()
                dst.closing.clear()
                dst.tabs.clear()
                dst.frames.clear()
                dst.generation = 0
                updated = true
            }
            return
        }
        if s.outputs[o].generation == known_gen {
            return
        }
        copy_output_effects(s.outputs[o], mut dst)
        updated = true
    })
    return updated
}

/// Snapshot output `o`'s current effect list.
pub fn EffectSheet.snapshot(self, o: int) -> OutputEffects {
    var out = OutputEffects {}
    self.inner.read(fn(s: SheetData) {
        if o >= 0 and o < s.outputs.len() {
            out = s.outputs[o].clone()
        }
    })
    return out
}
