// Window, workspace, focus-ring, close-transition, and overlay animation state evaluated at vblank_ns.

import std.collections.map
import std.mem
import pastel_core as core
import pastel_config as cfg

/// Per-window animated channels.
pub struct WindowAnim {
    pub rect: core.AnimRect
    pub opacity: core.Anim
    pub scale: core.Anim
    pub border_color: core.AnimColor
}

/// In-flight close transition driven by `[animation].window-close`.
pub struct ClosingAnim {
    pub rect: core.Rect
    pub opacity: core.Anim
    pub scale: core.Anim
    pub border_color: core.Color
    pub radius: f32
    pub border_width: f32
    pub shadow_size: f32
    pub shadow_color: core.Color
    pub monitor_idx: int
}

/// Evaluated closing-window snapshot for a single frame.
pub struct ClosingFrame {
    pub rect: core.Rect
    pub scale: f32
    pub opacity: f32
    pub border_color: core.Color
    pub radius: f32
    pub border_width: f32
    pub shadow_size: f32
    pub shadow_color: core.Color
    pub monitor_idx: int
}

/// Output-level animated channels (workspace vertical slide).
pub struct OutputAnim {
    pub ws_offset_y: core.Anim
    pub last_ws: int = 0
}

/// Complete animation state for the compositor.
pub struct AnimState {
    pub windows: map.Map[u64, WindowAnim]
    pub outputs: map.Map[u64, OutputAnim]
    pub closing: List[ClosingAnim] = []
    pub overlay_alpha: core.Anim
    pub overview: core.Anim
    pub bell_until: map.Map[u64, int]
    pub active: bool = false
    delay_ids: List[u64] = []
}

pub fn AnimState.new() -> AnimState {
    return AnimState {
        windows: map.Map.new(),
        outputs: map.Map.new(),
        overlay_alpha: core.Anim.unit(0.0),
        overview: core.Anim.unit(0.0),
        bell_until: map.Map.new(),
        active: false,
    }
}

/// Register a newly opened window with a subtle niri-style open animation (scale + fade).
pub fn AnimState.open_window(mut self, id: u64, target: core.Rect, target_opacity: f32, focused: bool, ac: cfg.AnimationConfig, wc: cfg.WindowConfig, now_ns: int) {
    let border = if focused { wc.active_color } else { wc.inactive_color }
    var wa = WindowAnim {
        rect: core.AnimRect.new(target),
        opacity: core.Anim.unit(if ac.enabled { 0.0 } else { f64(target_opacity) }),
        scale: core.Anim.unit(if ac.enabled { 0.94 } else { 1.0 }),
        border_color: core.AnimColor.new(border),
    }
    wa.opacity.retarget(f64(target_opacity), ac.window_open, now_ns, ac.enabled, ac.slowdown)
    wa.scale.retarget(1.0, ac.window_open, now_ns, ac.enabled, ac.slowdown)
    discard self.windows.insert(id, wa)
}

/// Update targets for an existing window in place (or initialize it on first sight).
pub fn AnimState.update_window(mut self, id: u64, target: core.Rect, target_opacity: f32, focused: bool, ac: cfg.AnimationConfig, wc: cfg.WindowConfig, now_ns: int) {
    let want_border = if focused { wc.active_color } else { wc.inactive_color }
    let target_op = f64(target_opacity)
    let updated = self.windows.update(id, fn(mut wa) {
        wa.rect.retarget(target, ac.window_movement, now_ns, ac.enabled, ac.slowdown)
        wa.opacity.retarget(target_op, ac.window_open, now_ns, ac.enabled, ac.slowdown)
        wa.border_color.retarget(want_border, ac.focus_ring, now_ns, ac.enabled, ac.slowdown)
    })
    if updated.is_none() {
        self.open_window(id, target, target_opacity, focused, ac, wc, now_ns)
    }
}

/// Transition a closing window into an animated fade+scale exit driven by `[animation].window-close`.
pub fn AnimState.close_window(mut self, id: u64, radius: f32, border_width: f32, shadow_size: f32, shadow_color: core.Color, monitor_idx: int, ac: cfg.AnimationConfig, now_ns: int) {
    discard self.bell_until.remove(id)
    guard let Some(cur) = self.windows.remove(id) else {
        return
    }
    guard ac.enabled else {
        return
    }
    var wa = cur
    let rect = wa.rect.tick(now_ns)
    let cur_op = wa.opacity.tick(now_ns)
    let cur_sc = wa.scale.tick(now_ns)
    let bc = wa.border_color.tick(now_ns)
    guard cur_op > 0.02 and not rect.is_empty() else {
        return
    }
    var op = core.Anim.unit(cur_op)
    var sc = core.Anim.unit(cur_sc)
    op.retarget(0.0, ac.window_close, now_ns, true, ac.slowdown)
    sc.retarget(0.94, ac.window_close, now_ns, true, ac.slowdown)
    self.closing.push(ClosingAnim {
        rect,
        opacity: op,
        scale: sc,
        border_color: bc,
        radius,
        border_width,
        shadow_size,
        shadow_color,
        monitor_idx,
    })
}

/// Trigger a vertical workspace switch slide animation on `output_id`.
pub fn AnimState.switch_workspace(mut self, output_id: u64, new_ws: int, viewport_h: f64, ac: cfg.AnimationConfig, now_ns: int) {
    let updated = self.outputs.update(output_id, fn(mut oa) {
        if oa.last_ws != new_ws {
            let dir = if new_ws > oa.last_ws { 1.0 } else { -1.0 }
            let start = if ac.enabled { dir * min(viewport_h * 0.35, 320.0) } else { 0.0 }
            oa.ws_offset_y.snap(start)
            oa.ws_offset_y.retarget(0.0, ac.workspace_switch, now_ns, ac.enabled, ac.slowdown)
            oa.last_ws = new_ws
        }
    })
    if updated.is_none() and new_ws != 0 {
        var oa = OutputAnim { ws_offset_y: core.Anim.new(0.0), last_ws: 0 }
        let dir = if new_ws > 0 { 1.0 } else { -1.0 }
        let start = if ac.enabled { dir * min(viewport_h * 0.35, 320.0) } else { 0.0 }
        oa.ws_offset_y.snap(start)
        oa.ws_offset_y.retarget(0.0, ac.workspace_switch, now_ns, ac.enabled, ac.slowdown)
        oa.last_ws = new_ws
        discard self.outputs.insert(output_id, oa)
    }
}

/// Show or hide the hotkey overlay smoothly (slides upward 12px as alpha 0->1).
pub fn AnimState.set_overlay(mut self, visible: bool, ac: cfg.AnimationConfig, now_ns: int) {
    let target_a = if visible { 1.0 } else { 0.0 }
    self.overlay_alpha.retarget(target_a, ac.overlay, now_ns, ac.enabled, ac.slowdown)
}

/// Animate smoothly into or out of Overview thumbnail mode (0.0 = normal, 1.0 = overview).
pub fn AnimState.set_overview(mut self, open: bool, ac: cfg.AnimationConfig, now_ns: int) {
    let target = if open { 1.0 } else { 0.0 }
    self.overview.retarget(target, ac.overview, now_ns, ac.enabled, ac.slowdown)
}

/// Trigger a 350 ms visual focus-ring pulse on window `id` (for `Event.Bell`).
pub fn AnimState.trigger_bell(mut self, id: u64, now_ns: int) {
    discard self.bell_until.insert(id, now_ns + 350000000)
}

/// Push every animation in flight `dt_ns` later: what started while a layout
/// transaction held frames back begins with the first frame shown instead
/// of jumping ahead by the wait.
pub fn AnimState.delay(mut self, dt_ns: int) {
    guard dt_ns > 0 else {
        return
    }
    var ids = mem.replace(mut self.delay_ids, [])
    ids.clear()
    for e in self.windows.entries() {
        let wa = e.val
        if wa.rect.x.active or wa.rect.y.active or wa.rect.w.active or wa.rect.h.active or wa.opacity.active or wa.scale.active or wa.border_color.progress.active {
            ids.push(e.key)
        }
    }
    for id in ids {
        discard self.windows.update(id, fn(mut wa) {
            wa.rect.delay(dt_ns)
            wa.opacity.delay(dt_ns)
            wa.scale.delay(dt_ns)
            wa.border_color.delay(dt_ns)
        })
    }
    ids.clear()
    for e in self.outputs.entries() {
        if e.val.ws_offset_y.active {
            ids.push(e.key)
        }
    }
    for id in ids {
        discard self.outputs.update(id, fn(mut oa) {
            oa.ws_offset_y.delay(dt_ns)
        })
    }
    self.delay_ids = ids
    for i in 0..self.closing.len() {
        self.closing[i].opacity.delay(dt_ns)
        self.closing[i].scale.delay(dt_ns)
    }
    self.overlay_alpha.delay(dt_ns)
    self.overview.delay(dt_ns)
}

pub fn AnimState.remove_window(mut self, id: u64) {
    discard self.windows.remove(id)
    discard self.bell_until.remove(id)
}

pub fn AnimState.remove_output(mut self, output_id: u64) {
    discard self.outputs.remove(output_id)
}

/// Evaluate window `id` at `now_ns` in place, returning `(rect, scale, opacity, border_color)`.
pub fn AnimState.tick_window(mut self, id: u64, now_ns: int) -> Option[(core.Rect, f32, f32, core.Color)] {
    guard not self.windows.is_empty() else {
        return None
    }
    var still_active = false
    let res = self.windows.update(id, fn(mut wa) -> (core.Rect, f32, f32, core.Color) {
        let rx_act = wa.rect.x.active
        let ry_act = wa.rect.y.active
        let rw_act = wa.rect.w.active
        let rh_act = wa.rect.h.active
        let op_act = wa.opacity.active
        let sc_act = wa.scale.active
        let bc_act = wa.border_color.progress.active
        if not (rx_act or ry_act or rw_act or rh_act or op_act or sc_act or bc_act) {
            let r = core.Rect {
                x: wa.rect.x.target,
                y: wa.rect.y.target,
                w: max(wa.rect.w.target, 1.0),
                h: max(wa.rect.h.target, 1.0),
            }
            let bc = if wa.border_color.progress.target == 1.0 {
                wa.border_color.to
            } else {
                wa.border_color.from.lerp(wa.border_color.to, f32(wa.border_color.progress.target))
            }
            return (r, f32(wa.scale.target), f32(wa.opacity.target), bc)
        }
        let x = if rx_act { wa.rect.x.tick(now_ns) } else { wa.rect.x.target }
        let y = if ry_act { wa.rect.y.tick(now_ns) } else { wa.rect.y.target }
        let w = max(if rw_act { wa.rect.w.tick(now_ns) } else { wa.rect.w.target }, 1.0)
        let h = max(if rh_act { wa.rect.h.tick(now_ns) } else { wa.rect.h.target }, 1.0)
        let op = f32(if op_act { wa.opacity.tick(now_ns) } else { wa.opacity.target })
        let sc = f32(if sc_act { wa.scale.tick(now_ns) } else { wa.scale.target })
        let bc = if bc_act {
            wa.border_color.tick(now_ns)
        } else if wa.border_color.progress.target == 1.0 {
            wa.border_color.to
        } else {
            wa.border_color.from.lerp(wa.border_color.to, f32(wa.border_color.progress.target))
        }
        if wa.rect.x.active or wa.rect.y.active or wa.rect.w.active or wa.rect.h.active or wa.opacity.active or wa.scale.active or wa.border_color.progress.active {
            still_active = true
        }
        return (core.Rect { x, y, w, h }, sc, op, bc)
    })
    if still_active {
        self.active = true
    }
    return res
}

/// Advance all in-flight closing animations at `now_ns`, pruning finished ones cleanly.
pub fn AnimState.tick_closing(mut self, now_ns: int, mut out: List[ClosingFrame]) {
    out.clear()
    guard not self.closing.is_empty() else {
        return
    }
    var i = 0
    while i < self.closing.len() {
        let op = f32(self.closing[i].opacity.tick(now_ns))
        let sc = f32(self.closing[i].scale.tick(now_ns))
        let alive = self.closing[i].opacity.active or self.closing[i].scale.active
        if not alive or op <= 0.005 {
            discard self.closing.remove(i)
            continue
        }
        self.active = true
        out.push(ClosingFrame {
            rect: self.closing[i].rect,
            scale: sc,
            opacity: op,
            border_color: self.closing[i].border_color,
            radius: self.closing[i].radius,
            border_width: self.closing[i].border_width,
            shadow_size: self.closing[i].shadow_size,
            shadow_color: self.closing[i].shadow_color,
            monitor_idx: self.closing[i].monitor_idx,
        })
        i += 1
    }
}

/// Evaluate workspace vertical slide offset for `output_id` at `now_ns` in place.
pub fn AnimState.tick_output_y(mut self, output_id: u64, now_ns: int) -> f64 {
    guard not self.outputs.is_empty() else {
        return 0.0
    }
    var still_active = false
    let res = self.outputs.update(output_id, fn(mut oa) -> f64 {
        guard oa.ws_offset_y.active else {
            return oa.ws_offset_y.target
        }
        let y = oa.ws_offset_y.tick(now_ns)
        if oa.ws_offset_y.active {
            still_active = true
        }
        return y
    })
    if still_active {
        self.active = true
    }
    return res.unwrap_or(0.0)
}

/// Evaluate overlay `(alpha, slide_y)` at `now_ns` (`slide_y = (1 - alpha) * 12.0`).
pub fn AnimState.tick_overlay(mut self, now_ns: int) -> (f32, f64) {
    let raw = if self.overlay_alpha.active { self.overlay_alpha.tick(now_ns) } else { self.overlay_alpha.target }
    let a = raw.clamp(0.0, 1.0)
    if self.overlay_alpha.active {
        self.active = true
    }
    return (f32(a), (1.0 - a) * 12.0)
}

/// Evaluate Overview progress in `0.0..1.0` at `now_ns`.
pub fn AnimState.tick_overview(mut self, now_ns: int) -> f64 {
    let raw = if self.overview.active { self.overview.tick(now_ns) } else { self.overview.target }
    let v = raw.clamp(0.0, 1.0)
    if self.overview.active {
        self.active = true
    }
    return v
}

/// Evaluate bell pulse intensity in `0.0..1.0` for window `id` at `now_ns`.
pub fn AnimState.bell_alpha(mut self, id: u64, now_ns: int) -> f32 {
    guard not self.bell_until.is_empty() else {
        return 0.0
    }
    guard let Some(end_ns) = self.bell_until.get(id) else {
        return 0.0
    }
    if now_ns >= end_ns {
        discard self.bell_until.remove(id)
        return 0.0
    }
    self.active = true
    let rem = f64(end_ns - now_ns) / 350000000.0
    return f32(rem.clamp(0.0, 1.0))
}

/// Reset per-frame activity accumulator before ticking all visible elements.
pub fn AnimState.begin_frame(mut self) {
    self.active = false
}

pub fn AnimState.is_active(self) -> bool {
    return self.active
}
