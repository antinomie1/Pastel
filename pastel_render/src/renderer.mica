// PastelRenderer: DWM-style visual compositor implementing luminaria.plug.Renderer.
// Reuses luminaria_compose.format, vk_gpu, vk_draw2d, and vk_compose while adding
// GPU Dual-Kawase backdrop blur (X-Ray & Live), SDF hollow borders, configurable
// shadow colors, and live-reloadable backgrounds — while preserving direct scanout
// and hardware MPO overlay fast paths.

import std.collections.map
import std.mem
import vk_gpu as gpu
import vk_draw2d as draw2d
import vk_compose as vc
import luminaria_types as types
import luminaria_compose.format as format
import effects
import blur

let fx_history_len = 4

struct Output {
    scene: vc.Scene
    width: u32 = 1
    height: u32 = 1
    background: vec4 = zeroed()
    dst_color: u32 = 0
    sdr_nits: f32 = 203.0
    max_nits: f32 = 1000.0
    alive: bool = true
    by_key: map.Map[u64, (u32, u64, u64)]
    by_id: map.Map[u32, u64]
    gen: u64 = 0
    last_ps: List[types.Placement] = []
    blur_pyr: blur.BlurPyramid = blur.BlurPyramid {}
    fx_gen: u64 = 0
    has_active_blur: bool = false
    /// Placement index of the first managed window (`fi >= 0`) so X-Ray only captures backdrop/wallpaper layers below it.
    first_window_idx: int = -1
    /// Cached effect snapshot for the current frame.
    fx: effects.OutputEffects = effects.OutputEffects {}
    /// Matched effect index per placement in `last_ps` (-1 if unmatched).
    ps_fx: List[int] = []
    /// Keys currently promoted to hardware KMS overlay planes.
    overlay_keys: List[u64] = []
    /// Partial damage tracking for the effects render path (mirrors `vk_compose.Scene`).
    fx_pending: vc.Region
    fx_history: List[vc.Region] = []
    fx_area: vc.Region
    fx_prev_used: bool = false
}

fn new_output(width: u32, height: u32, background: vec4, alive: bool) -> Output {
    var out = Output {
        scene: vc.Scene.new(width, height, background),
        width,
        height,
        background,
        alive,
        by_key: map.Map.new(),
        by_id: map.Map.new(),
        fx_pending: vc.Region.new(),
        fx_history: [vc.Region.new()],
        fx_area: vc.Region.new(),
    }
    if alive {
        out.fx_pending.add(draw2d.Rect { w: f32(width), h: f32(height) })
    }
    return out
}

fn blank_output() -> Output {
    return new_output(1, 1, vec4(0.0), false)
}

fn screen_rect(out: Output) -> draw2d.Rect {
    return draw2d.Rect { w: f32(out.width), h: f32(out.height) }
}

fn add_fx_damage(mut out: Output, r: draw2d.Rect) {
    out.fx_pending.add(r.intersect(screen_rect(out)))
}

fn is_image_key(key: u64) -> bool {
    return (key & (u64(1) << 63)) != 0
}

fn is_cursor_key(key: u64) -> bool {
    return not is_image_key(key) and key >= u64(0x7fffffffff000000)
}

fn placement_rect(p: types.Placement, t: gpu.Texture) -> draw2d.Rect {
    let has_src = p.src.w > 0.0 and p.src.h > 0.0
    let pw = if p.w > 0.0 { p.w } else if has_src { p.src.w } else { f32(t.width()) }
    let ph = if p.h > 0.0 { p.h } else if has_src { p.src.h } else { f32(t.height()) }
    return draw2d.Rect { x: p.x, y: p.y, w: pw, h: ph }
}

fn effect_bounds(ef: effects.WindowEffect) -> draw2d.Rect {
    let pad = max(ef.border_width, ef.shadow_size) + 4.0
    return draw2d.Rect { x: ef.x - pad, y: ef.y - pad, w: ef.w + pad * 2.0, h: ef.h + pad * 2.0 }
}

fn closing_bounds(cf: effects.ClosingEffect) -> draw2d.Rect {
    let pad = max(cf.border_width, cf.shadow_size) + 4.0
    return draw2d.Rect { x: cf.x - pad, y: cf.y - pad, w: cf.w + pad * 2.0, h: cf.h + pad * 2.0 }
}

fn tab_bounds(tb: effects.TabBar) -> draw2d.Rect {
    return draw2d.Rect { x: tb.x - 2.0, y: tb.y - 2.0, w: tb.w + 4.0, h: tb.h + 4.0 }
}

fn frame_bounds(fr: effects.OverviewFrame) -> draw2d.Rect {
    let pad = fr.border_width + 4.0
    return draw2d.Rect { x: fr.x - pad, y: fr.y - pad, w: fr.w + pad * 2.0, h: fr.h + pad * 2.0 }
}

fn same_effect(a: effects.WindowEffect, b: effects.WindowEffect) -> bool {
    return a.key == b.key and a.x == b.x and a.y == b.y and a.w == b.w and a.h == b.h and a.radius == b.radius and a.border_width == b.border_width and a.border_color == b.border_color and a.shadow_size == b.shadow_size and a.shadow_color == b.shadow_color and a.blur == b.blur and a.blur_xray == b.blur_xray and a.blur_opacity == b.blur_opacity and a.is_overlay == b.is_overlay
}

fn same_closing(a: effects.ClosingEffect, b: effects.ClosingEffect) -> bool {
    return a.x == b.x and a.y == b.y and a.w == b.w and a.h == b.h and a.radius == b.radius and a.border_width == b.border_width and a.border_color == b.border_color and a.shadow_size == b.shadow_size and a.shadow_color == b.shadow_color and a.fill_color == b.fill_color and a.opacity == b.opacity
}

fn same_tab(a: effects.TabBar, b: effects.TabBar) -> bool {
    return a.x == b.x and a.y == b.y and a.w == b.w and a.h == b.h and a.count == b.count and a.active_idx == b.active_idx and a.active_color == b.active_color and a.inactive_color == b.inactive_color and a.radius == b.radius
}

fn same_frame(a: effects.OverviewFrame, b: effects.OverviewFrame) -> bool {
    return a.x == b.x and a.y == b.y and a.w == b.w and a.h == b.h and a.border_width == b.border_width and a.border_color == b.border_color and a.fill_color == b.fill_color and a.radius == b.radius
}

fn same_placement(a: types.Placement, b: types.Placement) -> bool {
    return a.key == b.key and a.x == b.x and a.y == b.y and a.w == b.w and a.h == b.h and a.src.x == b.src.x and a.src.y == b.src.y and a.src.w == b.src.w and a.src.h == b.src.h and a.transform == b.transform and a.opacity == b.opacity and a.radius == b.radius and a.shadow == b.shadow and a.opaque.x == b.opaque.x and a.opaque.y == b.opaque.y and a.opaque.w == b.opaque.w and a.opaque.h == b.opaque.h and a.color_space == b.color_space
}

/// True when `p` with texture `t` has transparency (either reduced opacity or non-opaque surface buffer).
fn surface_translucent(p: types.Placement, t: gpu.Texture) -> bool {
    if p.opacity < 0.995 {
        return true
    }
    if t.opaque() {
        return false
    }
    let r = placement_rect(p, t)
    return p.opaque.w < r.w - 0.5 or p.opaque.h < r.h - 0.5
}

struct Shm {
    format: u32
    x0: i32 = 0
    y0: i32 = 0
    x1: i32 = 0
    y1: i32 = 0
}

pub struct PastelRenderer {
    dev: gpu.Device
    validation: bool = false
    want_priority: gpu.Priority = gpu.Priority.Realtime
    resets: int = 0
    canvas: Option[draw2d.Canvas] = None
    extra_canvases: List[(gpu.Format, draw2d.Canvas)] = []
    blur_pipes: Option[blur.BlurPipelines] = None
    extra_blur_pipes: List[(gpu.Format, blur.BlurPipelines)] = []
    sheet: effects.EffectSheet
    outputs: List[Output] = []
    uploads: Option[gpu.Encoder] = None
    texs: map.Map[u64, gpu.Texture]
    shms: map.Map[u64, Shm]
    targets: map.Map[u64, gpu.Texture]
    next_target: u64 = 1
    order: List[u32] = []
    rm_keys: List[u64] = []
    rm_ids: List[u32] = []
    ov_ids: List[u32] = []
}

/// Open a `PastelRenderer` on the system Vulkan 1.3 GPU, connected to `sheet`.
pub fn PastelRenderer.open(validation: bool, sheet: effects.EffectSheet) -> Result[PastelRenderer, str] {
    let dev = try gpu.Device.open(gpu.Options { headless: true, validation, priority: gpu.Priority.Realtime })
    var r = try PastelRenderer.with(dev, sheet)
    r.validation = validation
    r.want_priority = gpu.Priority.Realtime
    return Ok(r)
}

pub fn PastelRenderer.with(take dev: gpu.Device, sheet: effects.EffectSheet) -> Result[PastelRenderer, str] {
    let prio = dev.priority()
    var r = PastelRenderer {
        dev,
        want_priority: prio,
        sheet: sheet.clone(),
        texs: map.Map.new(),
        shms: map.Map.new(),
        targets: map.Map.new(),
    }
    r.canvas = Some(try draw2d.Canvas.create(mut r.dev, gpu.Format.B8G8R8A8_UNORM))
    r.blur_pipes = Some(try blur.BlurPipelines.create(mut r.dev, gpu.Format.B8G8R8A8_UNORM))
    return Ok(r)
}

pub fn PastelRenderer.formats(self) -> List[(u32, u64)] {
    return format.dmabuf_formats(self.dev)
}

pub fn PastelRenderer.capture_formats(self) -> List[(u32, u64)] {
    return format.capture_formats(self.dev)
}

pub fn PastelRenderer.render_node(self) -> Option[(i64, i64)] {
    return self.dev.drm_node()
}

pub fn PastelRenderer.device_lost(self) -> bool {
    return self.dev.lost()
}

pub fn PastelRenderer.stats(self, mut s: types.Stats) {
    s.gpu_priority = self.dev.priority().as_i32()
    s.gpu_resets = self.resets
}

/// Recover Vulkan device, 2D canvas, Dual-Kawase blur pipelines, and output scenes after device loss.
pub fn PastelRenderer.recover(mut self) -> Result[(), str] {
    var new_dev = try gpu.Device.open(gpu.Options { headless: true, validation: self.validation, priority: self.want_priority })
    let new_canvas = try draw2d.Canvas.create(mut new_dev, gpu.Format.B8G8R8A8_UNORM)
    let new_blur = try blur.BlurPipelines.create(mut new_dev, gpu.Format.B8G8R8A8_UNORM)
    if let Some(u) = self.uploads.take() {
        var enc = u
        self.dev.cancel(take enc)
    }
    if not self.dev.lost() {
        discard self.dev.idle()
        for o in 0..self.outputs.len() {
            var pyr = mem.replace(mut self.outputs[o].blur_pyr, blur.BlurPyramid {})
            pyr.destroy(mut self.dev)
            self.outputs[o].blur_pyr = pyr
        }
    }
    self.texs.clear()
    self.shms.clear()
    self.targets.clear()
    discard self.canvas.take()
    self.extra_canvases.clear()
    discard self.blur_pipes.take()
    self.extra_blur_pipes.clear()
    self.dev = new_dev
    self.canvas = Some(new_canvas)
    self.blur_pipes = Some(new_blur)
    for o in 0..self.outputs.len() {
        let prev = mem.replace(mut self.outputs[o], blank_output())
        if prev.alive {
            var next_out = new_output(prev.width, prev.height, prev.background, true)
            next_out.dst_color = prev.dst_color
            next_out.sdr_nits = prev.sdr_nits
            next_out.max_nits = prev.max_nits
            next_out.scene.set_output_color(prev.dst_color, prev.sdr_nits, prev.max_nits)
            self.outputs[o] = next_out
        }
    }
    self.resets += 1
    return Ok(())
}

/// Set the target color space and luminance parameters for output `o` (SDR or HDR10/scRGB).
pub fn PastelRenderer.set_output_color(mut self, o: int, dst_color: u32, sdr_nits: f32, max_nits: f32) {
    guard o >= 0 and o < self.outputs.len() else {
        return
    }
    var out = mem.replace(mut self.outputs[o], blank_output())
    out.dst_color = dst_color
    out.sdr_nits = sdr_nits
    out.max_nits = max_nits
    out.scene.set_output_color(dst_color, sdr_nits, max_nits)
    out.blur_pyr.invalidate_xray()
    add_fx_damage(mut out, screen_rect(out))
    self.outputs[o] = out
}

pub fn PastelRenderer.add_output(mut self, o: int, width: u32, height: u32, background: vec4) {
    while self.outputs.len() <= o {
        self.outputs.push(blank_output())
    }
    self.outputs[o] = new_output(width, height, background, true)
}

pub fn PastelRenderer.resize(mut self, o: int, width: u32, height: u32) {
    if o < self.outputs.len() {
        var out = mem.replace(mut self.outputs[o], blank_output())
        out.width = width
        out.height = height
        out.scene.resize(width, height)
        out.blur_pyr.invalidate_xray()
        add_fx_damage(mut out, screen_rect(out))
        self.outputs[o] = out
    }
}

pub fn PastelRenderer.remove_output(mut self, o: int) {
    if o < self.outputs.len() {
        var pyr = mem.replace(mut self.outputs[o].blur_pyr, blur.BlurPyramid {})
        pyr.destroy(mut self.dev)
        self.outputs[o].blur_pyr = pyr
        self.outputs[o].alive = false
        self.outputs[o].by_key.clear()
        self.outputs[o].by_id.clear()
        self.outputs[o].last_ps.clear()
        self.outputs[o].ps_fx.clear()
        self.outputs[o].overlay_keys.clear()
        self.outputs[o].fx_pending.clear()
    }
}

fn to_view(p: types.Placement, t: gpu.Texture) -> vc.View {
    let src = vc.Rect { x: p.src.x, y: p.src.y, w: p.src.w, h: p.src.h }
    let opaque = vc.Rect { x: p.opaque.x, y: p.opaque.y, w: p.opaque.w, h: p.opaque.h }
    return vc.View { tex: t, x: p.x, y: p.y, w: p.w, h: p.h, src, transform: vc.Transform(p.transform), opacity: p.opacity, radius: p.radius, shadow: p.shadow, opaque, color_space: p.color_space }
}

/// Match an unused decoration entry against `p`: exact key match first (compositor images),
/// then closest output-pixel bounds among client surface placements (never matching images/cursors).
fn find_effect_unused(fx: effects.OutputEffects, p: types.Placement, used: &[bool]) -> int {
    for i, item in fx.items {
        if not used[i] and item.key != 0 and item.key == p.key {
            return i
        }
    }
    guard not is_image_key(p.key) and not is_cursor_key(p.key) else {
        return -1
    }
    var best = -1
    var best_err: f32 = 1.0e9
    for i, item in fx.items {
        if not used[i] and item.key == 0 {
            let dx = (item.x - p.x).abs()
            let dy = (item.y - p.y).abs()
            let dw = (item.w - p.w).abs()
            let dh = (item.h - p.h).abs()
            if dx <= 2.0 and dy <= 2.0 and dw <= 4.0 and dh <= 4.0 {
                let err = dx + dy + dw + dh
                if err < best_err {
                    best_err = err
                    best = i
                }
            }
        }
    }
    return best
}

fn placement_pad(p: types.Placement, fx: effects.OutputEffects, fi: int) -> f32 {
    if fi >= 0 and fi < fx.items.len() {
        let ef = fx.items[fi]
        return max(max(ef.border_width, ef.shadow_size), p.shadow) + 4.0
    }
    return p.shadow + 2.0
}

fn need_effects_path(out: Output) -> bool {
    if not out.fx.closing.is_empty() or not out.fx.tabs.is_empty() or not out.fx.frames.is_empty() {
        return true
    }
    guard not out.fx.items.is_empty() else {
        return false
    }
    if out.has_active_blur {
        return true
    }
    return out.fx.items.any(fn(it) => it.border_width > 0.0)
}

/// Map luminaria output slot `o` to its dense rank among currently alive outputs,
/// matching the dense index order returned by `Display.outputs()` even after monitor hot-unplug.
fn PastelRenderer.alive_index(self, o: int) -> int {
    var rank = 0
    for i in 0..o {
        if i < self.outputs.len() and self.outputs[i].alive {
            rank += 1
        }
    }
    return rank
}

pub fn PastelRenderer.layout(mut self, o: int, placements: &[types.Placement]) {
    guard o < self.outputs.len() and self.outputs[o].alive else {
        return
    }
    let sheet_idx = self.alive_index(o)
    var out = mem.replace(mut self.outputs[o], blank_output())
    let prev_ps = mem.replace(mut out.last_ps, [])
    let prev_ps_fx = mem.replace(mut out.ps_fx, [])
    let prev_fx = out.fx.clone()
    let prev_first_win = out.first_window_idx

    let snap = self.sheet.snapshot(sheet_idx)
    var blur_settings_changed = false
    if snap.generation != out.fx_gen {
        if snap.generation > 0 and snap.background != out.background {
            out.background = snap.background
            out.scene = vc.Scene.new(out.width, out.height, out.background)
            out.scene.set_output_color(out.dst_color, out.sdr_nits, out.max_nits)
            out.by_key.clear()
            out.by_id.clear()
            out.blur_pyr.invalidate_xray()
            add_fx_damage(mut out, screen_rect(out))
        }
        blur_settings_changed = snap.blur.enabled != prev_fx.blur.enabled or snap.blur.xray != prev_fx.blur.xray or snap.blur.passes != prev_fx.blur.passes or snap.blur.offset != prev_fx.blur.offset
        if blur_settings_changed {
            out.blur_pyr.invalidate_xray()
        }
        // Diff previous vs current decorations so only changed windows are damaged.
        let prev_n = prev_fx.items.len()
        let next_n = snap.items.len()
        if prev_n == next_n and not blur_settings_changed {
            for i in 0..next_n {
                if not same_effect(prev_fx.items[i], snap.items[i]) {
                    let b0 = effect_bounds(prev_fx.items[i])
                    let b1 = effect_bounds(snap.items[i])
                    out.scene.damage(b0)
                    out.scene.damage(b1)
                    add_fx_damage(mut out, b0)
                    add_fx_damage(mut out, b1)
                }
            }
        } else {
            for item in prev_fx.items {
                let b = effect_bounds(item)
                out.scene.damage(b)
                add_fx_damage(mut out, b)
            }
            for item in snap.items {
                let b = effect_bounds(item)
                out.scene.damage(b)
                add_fx_damage(mut out, b)
            }
        }
        // Diff closing window ghost effects.
        let prev_cn = prev_fx.closing.len()
        let next_cn = snap.closing.len()
        if prev_cn == next_cn {
            for i in 0..next_cn {
                if not same_closing(prev_fx.closing[i], snap.closing[i]) {
                    let b0 = closing_bounds(prev_fx.closing[i])
                    let b1 = closing_bounds(snap.closing[i])
                    out.scene.damage(b0)
                    out.scene.damage(b1)
                    add_fx_damage(mut out, b0)
                    add_fx_damage(mut out, b1)
                }
            }
        } else {
            for cf in prev_fx.closing {
                let b = closing_bounds(cf)
                out.scene.damage(b)
                add_fx_damage(mut out, b)
            }
            for cf in snap.closing {
                let b = closing_bounds(cf)
                out.scene.damage(b)
                add_fx_damage(mut out, b)
            }
        }
        // Diff tabbed column indicator bars.
        let prev_tn = prev_fx.tabs.len()
        let next_tn = snap.tabs.len()
        if prev_tn == next_tn {
            for i in 0..next_tn {
                if not same_tab(prev_fx.tabs[i], snap.tabs[i]) {
                    let b0 = tab_bounds(prev_fx.tabs[i])
                    let b1 = tab_bounds(snap.tabs[i])
                    out.scene.damage(b0)
                    out.scene.damage(b1)
                    add_fx_damage(mut out, b0)
                    add_fx_damage(mut out, b1)
                }
            }
        } else {
            for tb in prev_fx.tabs {
                let b = tab_bounds(tb)
                out.scene.damage(b)
                add_fx_damage(mut out, b)
            }
            for tb in snap.tabs {
                let b = tab_bounds(tb)
                out.scene.damage(b)
                add_fx_damage(mut out, b)
            }
        }
        // Diff Overview workspace frames.
        let prev_fn = prev_fx.frames.len()
        let next_fn = snap.frames.len()
        if prev_fn == next_fn {
            for i in 0..next_fn {
                if not same_frame(prev_fx.frames[i], snap.frames[i]) {
                    let b0 = frame_bounds(prev_fx.frames[i])
                    let b1 = frame_bounds(snap.frames[i])
                    out.scene.damage(b0)
                    out.scene.damage(b1)
                    add_fx_damage(mut out, b0)
                    add_fx_damage(mut out, b1)
                }
            }
        } else {
            for fr in prev_fx.frames {
                let b = frame_bounds(fr)
                out.scene.damage(b)
                add_fx_damage(mut out, b)
            }
            for fr in snap.frames {
                let b = frame_bounds(fr)
                out.scene.damage(b)
                add_fx_damage(mut out, b)
            }
        }
        out.fx = snap
        out.fx_gen = out.fx.generation
    }

    out.gen += 1
    let gen = out.gen
    var order = mem.replace(mut self.order, [])
    order.clear()
    var used: List[bool] = []
    for _ in 0..out.fx.items.len() {
        used.push(false)
    }
    var any_blur = false
    var first_window_idx = -1
    let blur_enabled = out.fx.blur.enabled

    for p in placements {
        let pi = out.last_ps.len()
        out.last_ps.push(p)
        let fi = find_effect_unused(out.fx, p, used)
        if fi >= 0 {
            used[fi] = true
            if first_window_idx < 0 {
                first_window_idx = pi
            }
        }
        out.ps_fx.push(fi)
        guard let Some(t) = self.texs.get(p.tex) else {
            continue
        }
        if blur_enabled and fi >= 0 {
            let ef = out.fx.items[fi]
            if ef.blur and ef.blur_opacity > 0.01 and surface_translucent(p, t) {
                any_blur = true
            }
        }
        let v = to_view(p, t)
        if let Some((id, seen_gen, _)) = out.by_key.get(p.key) {
            if seen_gen == gen {
                continue
            }
            out.scene.set(id, v)
            discard out.by_key.insert(p.key, (id, gen, p.tex))
            order.push(id)
        } else {
            let id = out.scene.add(v)
            discard out.by_key.insert(p.key, (id, gen, p.tex))
            discard out.by_id.insert(id, p.key)
            order.push(id)
        }
    }
    out.has_active_blur = any_blur
    out.first_window_idx = first_window_idx

    var rm_keys = mem.replace(mut self.rm_keys, [])
    var rm_ids = mem.replace(mut self.rm_ids, [])
    rm_keys.clear()
    rm_ids.clear()
    for e in out.by_key.entries() {
        if e.val.1 != gen {
            rm_keys.push(e.key)
            rm_ids.push(e.val.0)
        }
    }
    if not rm_keys.is_empty() {
        for i in 0..rm_keys.len() {
            discard out.by_key.remove(rm_keys[i])
            discard out.by_id.remove(rm_ids[i])
        }
        out.scene.remove_many(rm_ids)
    }
    out.scene.reorder(order)

    // Diff previous vs current placements for partial damage on the effects path
    // and invalidate cached X-Ray blur ONLY if a backdrop/wallpaper layer below managed windows changed.
    var backdrop_changed = false
    let new_len = out.last_ps.len()
    let old_len = prev_ps.len()
    let same_len = new_len == old_len
    if same_len {
        for i in 0..new_len {
            let a = prev_ps[i]
            let b = out.last_ps[i]
            if not same_placement(a, b) {
                if let Some(ta) = self.texs.get(a.tex) {
                    let pfi = if i < prev_ps_fx.len() { prev_ps_fx[i] } else { -1 }
                    add_fx_damage(mut out, placement_rect(a, ta).grow(placement_pad(a, prev_fx, pfi)))
                }
                if let Some(tb) = self.texs.get(b.tex) {
                    add_fx_damage(mut out, placement_rect(b, tb).grow(placement_pad(b, out.fx, out.ps_fx[i])))
                }
                if first_window_idx > 0 and i < first_window_idx {
                    backdrop_changed = true
                }
            }
        }
    } else {
        // Placements were added/removed/reordered: damage only entries whose position/content changed.
        for i in 0..old_len {
            let a = prev_ps[i]
            var matched = false
            for j in 0..new_len {
                if out.last_ps[j].key == a.key {
                    matched = true
                    if i != j or not same_placement(a, out.last_ps[j]) {
                        if let Some(ta) = self.texs.get(a.tex) {
                            let pfi = if i < prev_ps_fx.len() { prev_ps_fx[i] } else { -1 }
                            add_fx_damage(mut out, placement_rect(a, ta).grow(placement_pad(a, prev_fx, pfi)))
                        }
                        if (prev_first_win > 0 and i < prev_first_win) or (first_window_idx > 0 and j < first_window_idx) {
                            backdrop_changed = true
                        }
                    }
                    break
                }
            }
            if not matched {
                if let Some(ta) = self.texs.get(a.tex) {
                    let pfi = if i < prev_ps_fx.len() { prev_ps_fx[i] } else { -1 }
                    add_fx_damage(mut out, placement_rect(a, ta).grow(placement_pad(a, prev_fx, pfi)))
                }
                if prev_first_win > 0 and i < prev_first_win {
                    backdrop_changed = true
                }
            }
        }
        for j in 0..new_len {
            let b = out.last_ps[j]
            var matched = false
            for i in 0..old_len {
                if prev_ps[i].key == b.key {
                    matched = true
                    if i != j or not same_placement(prev_ps[i], b) {
                        if let Some(tb) = self.texs.get(b.tex) {
                            add_fx_damage(mut out, placement_rect(b, tb).grow(placement_pad(b, out.fx, out.ps_fx[j])))
                        }
                    }
                    break
                }
            }
            if not matched {
                if let Some(tb) = self.texs.get(b.tex) {
                    add_fx_damage(mut out, placement_rect(b, tb).grow(placement_pad(b, out.fx, out.ps_fx[j])))
                }
                if first_window_idx > 0 and j < first_window_idx {
                    backdrop_changed = true
                }
            }
        }
    }
    if backdrop_changed {
        out.blur_pyr.invalidate_xray()
    }

    self.order = order
    self.rm_keys = rm_keys
    self.rm_ids = rm_ids
    self.outputs[o] = out
}

pub fn PastelRenderer.commit(mut self, key: u64, rects: &[(i32, i32, i32, i32)]) {
    for o in 0..self.outputs.len() {
        guard let Some((id, _, _)) = self.outputs[o].by_key.get(key) else {
            continue
        }
        if rects.is_empty() {
            self.outputs[o].scene.commit(id, None)
        }
        for r in rects {
            self.outputs[o].scene.commit(id, Some(vc.Rect { x: f32(r.0), y: f32(r.1), w: f32(r.2), h: f32(r.3) }))
        }
        var out = mem.replace(mut self.outputs[o], blank_output())
        if not out.overlay_keys.contains(key) {
            for pi in 0..out.last_ps.len() {
                let p = out.last_ps[pi]
                if p.key != key {
                    continue
                }
                if let Some(t) = self.texs.get(p.tex) {
                    let pr = placement_rect(p, t)
                    if rects.is_empty() {
                        add_fx_damage(mut out, pr)
                    } else {
                        let tw = max(f32(t.width()), 1.0)
                        let th = max(f32(t.height()), 1.0)
                        let sx = pr.w / tw
                        let sy = pr.h / th
                        for r in rects {
                            let dr = draw2d.Rect {
                                x: pr.x + f32(r.0) * sx - 1.0,
                                y: pr.y + f32(r.1) * sy - 1.0,
                                w: f32(r.2) * sx + 2.0,
                                h: f32(r.3) * sy + 2.0,
                            }.intersect(pr)
                            add_fx_damage(mut out, dr)
                        }
                    }
                    // A wallpaper / background layer commit below managed windows invalidates X-Ray cache.
                    if out.first_window_idx > 0 and pi < out.first_window_idx {
                        out.blur_pyr.invalidate_xray()
                    }
                }
                break
            }
        }
        self.outputs[o] = out
    }
}

pub fn PastelRenderer.damage_all(mut self) {
    for o in 0..self.outputs.len() {
        var out = mem.replace(mut self.outputs[o], blank_output())
        out.scene.damage_all()
        out.blur_pyr.invalidate_xray()
        add_fx_damage(mut out, screen_rect(out))
        self.outputs[o] = out
    }
}

pub fn PastelRenderer.idle(self, o: int) -> bool {
    guard o < self.outputs.len() and self.outputs[o].alive else {
        return true
    }
    let need_fx = need_effects_path(self.outputs[o])
    if need_fx != self.outputs[o].fx_prev_used {
        return false
    }
    if need_fx {
        return self.outputs[o].fx_pending.is_empty()
    }
    return self.outputs[o].scene.idle()
}

pub fn PastelRenderer.visible(self, o: int, key: u64) -> bool {
    guard o < self.outputs.len() else {
        return false
    }
    guard let Some((id, _, _)) = self.outputs[o].by_key.get(key) else {
        return false
    }
    return self.outputs[o].scene.visible(id)
}

/// Preserve zero-copy direct scanout whenever no active blur, border, closing, tab bar, or overview sits on top.
pub fn PastelRenderer.scanout(self, o: int) -> Option[u64] {
    guard o < self.outputs.len() and not self.outputs[o].has_active_blur and self.outputs[o].fx.closing.is_empty() and self.outputs[o].fx.tabs.is_empty() and self.outputs[o].fx.frames.is_empty() else {
        return None
    }
    if self.outputs[o].fx.items.any(fn(it) => it.border_width > 0.0) {
        return None
    }
    guard let Some(id) = self.outputs[o].scene.scanout() else {
        return None
    }
    return self.outputs[o].by_id.get(id)
}

/// Preserve hardware MPO overlay promotion when no active blur blocks it.
pub fn PastelRenderer.overlay_candidates(self, o: int, max_count: int) -> List[types.OverlayCand] {
    var out: List[types.OverlayCand] = []
    guard o < self.outputs.len() and self.outputs[o].alive and not self.outputs[o].has_active_blur else {
        return out
    }
    for id in self.outputs[o].scene.overlay_candidates(max_count) {
        guard let Some(key) = self.outputs[o].by_id.get(id) else {
            continue
        }
        guard let Some((_, _, tex)) = self.outputs[o].by_key.get(key) else {
            continue
        }
        guard let Some(v) = self.outputs[o].scene.get(id) else {
            continue
        }
        let w = if v.w > 0.0 { v.w } else if not v.src.is_empty() { v.src.w } else { f32(v.tex.width()) }
        let h = if v.h > 0.0 { v.h } else if not v.src.is_empty() { v.src.h } else { f32(v.tex.height()) }
        let src = types.Rect { x: v.src.x, y: v.src.y, w: v.src.w, h: v.src.h }
        let opaque = v.tex.opaque() or (v.opaque.w >= w and v.opaque.h >= h)
        out.push(types.OverlayCand {
            key,
            tex,
            x: i32(v.x),
            y: i32(v.y),
            w: i32(w),
            h: i32(h),
            src,
            transform: u32(v.transform),
            opaque,
        })
    }
    return out
}

pub fn PastelRenderer.set_overlays(mut self, o: int, keys: &[u64]) {
    guard o < self.outputs.len() and self.outputs[o].alive else {
        return
    }
    var out = mem.replace(mut self.outputs[o], blank_output())
    var ids = mem.replace(mut self.ov_ids, [])
    ids.clear()
    for key in keys {
        if let Some((id, _, _)) = out.by_key.get(key) {
            ids.push(id)
        }
    }
    out.scene.set_overlays(ids)
    // Track promoted overlay keys for the effects path and damage any overlay entry/exit transition.
    var next_keys: List[u64] = []
    for k in keys {
        next_keys.push(k)
    }
    for pi in 0..out.last_ps.len() {
        let p = out.last_ps[pi]
        let was = out.overlay_keys.contains(p.key)
        let now = next_keys.contains(p.key)
        if was != now {
            if let Some(t) = self.texs.get(p.tex) {
                add_fx_damage(mut out, placement_rect(p, t).grow(placement_pad(p, out.fx, out.ps_fx[pi])))
            }
        }
    }
    out.overlay_keys = next_keys
    self.ov_ids = ids
    self.outputs[o] = out
}

// ------------------------------------------------------------- textures

fn PastelRenderer.encoder(mut self) -> Result[gpu.Encoder, str] {
    if let Some(e) = self.uploads.take() {
        return Ok(e)
    }
    return self.dev.encoder()
}

fn PastelRenderer.put(mut self, key: u64, t: gpu.Texture) {
    if let Some(old) = self.texs.insert(key, t) {
        self.dev.destroy_texture(old)
    }
}

pub fn PastelRenderer.has(self, key: u64) -> bool {
    return self.texs.contains(key)
}

pub fn PastelRenderer.forget(mut self, key: u64) {
    if let Some(t) = self.texs.remove(key) {
        self.dev.destroy_texture(t)
    }
    discard self.shms.remove(key)
}

pub fn PastelRenderer.import_dmabuf(mut self, key: u64, d: types.Dmabuf) -> bool {
    guard d.planes >= 1 and d.planes <= 4 else {
        return false
    }
    guard let Ok(t) = format.import_dmabuf(mut self.dev, d) else {
        return false
    }
    self.put(key, t)
    return true
}

pub fn PastelRenderer.solid(mut self, key: u64, rgba: [4]u32) -> bool {
    let px: List[u8] = [u8(rgba[0] >> 24), u8(rgba[1] >> 24), u8(rgba[2] >> 24), u8(rgba[3] >> 24)]
    let fourcc = if rgba[3] == 0xFFFFFFFF { types.buffer.xbgr8888 } else { types.buffer.abgr8888 }
    return self.image(key, 1, 1, fourcc, px, 4)
}

pub fn PastelRenderer.image(mut self, key: u64, width: i32, height: i32, fourcc: u32, pixels: &[u8], stride: int) -> bool {
    guard self.target(key, width, height, fourcc) else {
        return false
    }
    let none: List[(i32, i32, i32, i32)] = []
    return self.write(key, pixels, stride, none)
}

pub fn PastelRenderer.update(mut self, key: u64, pixels: &[u8], stride: int, rects: &[(i32, i32, i32, i32)]) -> bool {
    return self.texs.contains(key) and self.write(key, pixels, stride, rects)
}

fn PastelRenderer.target(mut self, key: u64, width: i32, height: i32, fourcc: u32) -> bool {
    if let Some(t) = self.texs.get(key) {
        let same = i32(t.width()) == width and i32(t.height()) == height and self.shms.get(key).map(fn(s) => s.format).unwrap_or(0) == fourcc
        if same {
            return true
        }
    }
    guard let Ok(t) = format.shm_texture(mut self.dev, width, height, fourcc) else {
        self.forget(key)
        return false
    }
    self.put(key, t)
    discard self.shms.insert(key, Shm { format: fourcc, x1: width, y1: height })
    return true
}

fn PastelRenderer.write(mut self, key: u64, pixels: &[u8], stride: int, rects: &[(i32, i32, i32, i32)]) -> bool {
    guard let Some(t) = self.texs.get(key) else {
        return false
    }
    guard let Ok(got) = self.encoder() else {
        return false
    }
    var e = got
    let ok = format.upload(mut self.dev, mut e, t, pixels, stride, rects).is_ok()
    self.uploads = Some(e)
    if let Some(s) = self.shms.get(key) {
        discard self.shms.insert(key, Shm { format: s.format })
    }
    return ok
}

pub fn PastelRenderer.shm_commit(mut self, key: u64, width: i32, height: i32, fourcc: u32, rects: &[(i32, i32, i32, i32)]) -> bool {
    guard self.target(key, width, height, fourcc) else {
        return false
    }
    var s = self.shms.get(key).unwrap()
    if rects.is_empty() {
        s.x0 = 0
        s.y0 = 0
        s.x1 = width
        s.y1 = height
    }
    for r in rects {
        if s.x0 >= s.x1 {
            s.x0 = r.0
            s.y0 = r.1
            s.x1 = r.0 + r.2
            s.y1 = r.1 + r.3
        } else {
            s.x0 = min(s.x0, r.0)
            s.y0 = min(s.y0, r.1)
            s.x1 = max(s.x1, r.0 + r.2)
            s.y1 = max(s.y1, r.1 + r.3)
        }
    }
    discard self.shms.insert(key, s)
    return true
}

pub fn PastelRenderer.shm_upload(mut self, key: u64, bytes: &[u8], stride: int) -> bool {
    guard let Some(s) = self.shms.get(key) else {
        return false
    }
    guard s.x0 < s.x1 and s.y0 < s.y1 else {
        return true
    }
    let rect: List[(i32, i32, i32, i32)] = [(s.x0, s.y0, s.x1 - s.x0, s.y1 - s.y0)]
    return self.write(key, bytes, stride, rect)
}

// ------------------------------------------------------------- targets & render

fn PastelRenderer.flush_uploads(mut self) -> Result[(), str] {
    if let Some(u) = self.uploads.take() {
        var enc = u
        discard try self.dev.submit(take enc)
    }
    return Ok(())
}

pub fn PastelRenderer.targets(mut self, w: types.Want) -> Result[List[types.Target], str] {
    guard let Some((vf, _)) = format.vk_format(w.format) else {
        return Err("render target format {w.format:08x} is not supported")
    }
    let desc = gpu.TextureDesc { width: u32(w.width), height: u32(w.height), format: vf, target: true }
    var mods: List[u64] = []
    if w.export {
        let gpu_mods = self.dev.dmabuf_modifiers(vf, true)
        for m in gpu_mods {
            if w.modifiers.is_empty() or w.modifiers.contains(m) {
                mods.push(m)
            }
        }
        if mods.is_empty() {
            mods.push(0)
        }
    }
    var out: List[types.Target] = []
    for _ in 0..w.count {
        let key = self.next_target
        self.next_target += 1
        if w.export {
            let (t, b) = try self.dev.export_dmabuf_with(desc, mods)
            discard self.targets.insert(key, t)
            let n = b.plane_count()
            var buf = types.Dmabuf { width: w.width, height: w.height, format: w.format, modifier: b.modifier, planes: n }
            for i in 0..n {
                let p = b.plane(i)
                buf.plane[i] = types.Plane { fd: int(p.fd), offset: u32(p.offset), stride: u32(p.stride) }
            }
            out.push(types.Target { key, buf })
        } else {
            discard self.targets.insert(key, try self.dev.texture(desc))
            out.push(types.Target { key })
        }
    }
    return Ok(out)
}

pub fn PastelRenderer.drop_target(mut self, key: u64) {
    if let Some(t) = self.targets.remove(key) {
        self.dev.destroy_texture(t)
    }
}

/// Expand any rect in `reg` that overlaps `target` by `pad`, clamped to `screen`.
fn expand_region_for(mut reg: vc.Region, target: draw2d.Rect, pad: f32, screen: draw2d.Rect) {
    guard reg.overlaps(target) else {
        return
    }
    var extra: List[draw2d.Rect] = []
    for d in reg.rects() {
        if d.overlaps(target) {
            extra.push(d.grow(pad).intersect(screen))
        }
    }
    for r in extra {
        reg.add(r)
    }
}

fn PastelRenderer.take_canvas(mut self, fmt: gpu.Format) -> Result[draw2d.Canvas, str] {
    if fmt == gpu.Format.B8G8R8A8_UNORM {
        guard let Some(cv) = self.canvas.take() else {
            return Err("no canvas")
        }
        return Ok(cv)
    }
    for i in 0..self.extra_canvases.len() {
        if self.extra_canvases[i].0 == fmt {
            let (_, cv) = self.extra_canvases.remove(i)
            return Ok(cv)
        }
    }
    return draw2d.Canvas.create(mut self.dev, fmt)
}

fn PastelRenderer.put_canvas(mut self, fmt: gpu.Format, take cv: draw2d.Canvas) {
    if fmt == gpu.Format.B8G8R8A8_UNORM {
        self.canvas = Some(cv)
    } else {
        self.extra_canvases.push((fmt, cv))
    }
}

fn PastelRenderer.get_blur_pipes(mut self, fmt: gpu.Format) -> Result[blur.BlurPipelines, str] {
    if fmt == gpu.Format.B8G8R8A8_UNORM {
        guard let Some(bp) = self.blur_pipes else {
            return Err("no blur pipelines")
        }
        return Ok(bp)
    }
    for entry in self.extra_blur_pipes {
        if entry.0 == fmt {
            return Ok(entry.1)
        }
    }
    let bp = try blur.BlurPipelines.create(mut self.dev, fmt)
    self.extra_blur_pipes.push((fmt, bp))
    return Ok(bp)
}

fn draw_overview_frames(mut cv: draw2d.Canvas, frames: &[effects.OverviewFrame], area: vc.Region) {
    for fr in frames {
        guard area.overlaps(frame_bounds(fr)) else {
            continue
        }
        let r = draw2d.Rect { x: fr.x, y: fr.y, w: fr.w, h: fr.h }
        if fr.fill_color.w > 0.001 {
            cv.round_rect(r, fr.fill_color, fr.radius)
        }
        if fr.border_width > 0.0 and fr.border_color.w > 0.001 {
            let bw = fr.border_width
            let br = draw2d.Rect { x: r.x - bw, y: r.y - bw, w: r.w + bw * 2.0, h: r.h + bw * 2.0 }
            cv.border(br, fr.border_color, fr.radius, bw)
        }
    }
}

/// Draw `out` into `dst` clipped to `area` with GPU SDF hollow borders, Dual-Kawase blur,
/// closing-window fade ghosts, tab indicator bars, overview workspace frames, occlusion culling,
/// and hardware overlay exclusion.
fn PastelRenderer.render_with_effects(mut self, mut out: Output, mut cv: draw2d.Canvas, pipes: blur.BlurPipelines, mut e: gpu.Encoder, dst: gpu.Texture, area: vc.Region, capture_xray: bool) -> Result[(), str] {
    let w = dst.width()
    let h = dst.height()
    let screen = draw2d.Rect { w: f32(w), h: f32(h) }
    let blur_cfg = out.fx.blur
    let clips = area.rects()
    let ps_len = out.last_ps.len()

    // Acquire only client textures that are actually sampled on the primary plane.
    var acquired: List[bool] = []
    for pi in 0..ps_len {
        let p = out.last_ps[pi]
        var use_tex = false
        if not out.overlay_keys.contains(p.key) {
            if let Some(t) = self.texs.get(p.tex) {
                let fi = if pi < out.ps_fx.len() { out.ps_fx[pi] } else { -1 }
                let bounds = placement_rect(p, t).grow(placement_pad(p, out.fx, fi))
                if area.overlaps(bounds) {
                    e.acquire(t)
                    use_tex = true
                }
            }
        }
        acquired.push(use_tex)
    }

    cv.clear()
    cv.set_output_color(out.dst_color, out.sdr_nits, out.max_nits)
    cv.rect(screen, out.background)
    var xray_captured = not capture_xray
    var frames_drawn = out.fx.frames.is_empty()

    for pi in 0..ps_len {
        // Capture X-Ray blur right before the first managed window so only background + wallpaper
        // layers enter the X-Ray cache (never opaque application windows).
        if not xray_captured and out.first_window_idx >= 0 and pi >= out.first_window_idx {
            try cv.draw(mut self.dev, mut e, gpu.Pass { target: dst, load: gpu.Load.Keep }, clips)
            cv.clear()
            cv.set_output_color(out.dst_color, out.sdr_nits, out.max_nits)
            discard try out.blur_pyr.ensure_xray(mut self.dev, pipes, mut e, dst, w, h, blur_cfg.passes, blur_cfg.offset, out.background)
            xray_captured = true
        }
        if not frames_drawn and out.first_window_idx >= 0 and pi >= out.first_window_idx {
            draw_overview_frames(mut cv, out.fx.frames, area)
            frames_drawn = true
        }
        let p = out.last_ps[pi]
        guard let Some(t) = self.texs.get(p.tex) else {
            continue
        }
        let fi = if pi < out.ps_fx.len() { out.ps_fx[pi] } else { -1 }
        let v = to_view(p, t)
        let r = placement_rect(p, t)
        let bounds = r.grow(placement_pad(p, out.fx, fi))
        guard area.overlaps(bounds) else {
            continue
        }
        let src_rect = if v.src.is_empty() {
            draw2d.Rect { w: 1.0, h: 1.0 }
        } else {
            let tw = f32(t.width())
            let th = f32(t.height())
            let pic = if v.transform.swaps() { vec2(th, tw) } else { vec2(tw, th) }
            draw2d.Rect { x: v.src.x / pic.x, y: v.src.y / pic.y, w: v.src.w / pic.x, h: v.src.h / pic.y }
        }
        let is_hw_overlay = out.overlay_keys.contains(p.key)

        if fi >= 0 and fi < out.fx.items.len() {
            let ef = out.fx.items[fi]

            // If this placement needs backdrop blur and overlaps damaged area:
            // - X-Ray mode: reuse cached blurred background/wallpaper (0 extra steady-state passes).
            // - Live mode (or overlay/floating): flush layers below into `dst` and run Dual-Kawase blur.
            if not is_hw_overlay and blur_cfg.enabled and ef.blur and ef.blur_opacity > 0.01 and surface_translucent(p, t) and area.overlaps(r) {
                try cv.draw(mut self.dev, mut e, gpu.Pass { target: dst, load: gpu.Load.Keep }, clips)
                cv.clear()
                cv.set_output_color(out.dst_color, out.sdr_nits, out.max_nits)
                let use_xray = blur_cfg.xray and ef.blur_xray and not ef.is_overlay
                let blurred = if use_xray {
                    try out.blur_pyr.ensure_xray(mut self.dev, pipes, mut e, dst, w, h, blur_cfg.passes, blur_cfg.offset, out.background)
                } else {
                    try out.blur_pyr.blur_from(mut self.dev, pipes, mut e, dst, w, h, blur_cfg.passes, blur_cfg.offset)
                }
                blur.composite_clips(pipes, mut e, blurred, dst, r, ef.radius, ef.blur_opacity, clips)
            }

            if not is_hw_overlay {
                if ef.shadow_size > 0.0 {
                    let sc = vec4(ef.shadow_color.x, ef.shadow_color.y, ef.shadow_color.z, ef.shadow_color.w * v.opacity)
                    cv.shadow(r, sc, ef.radius, ef.shadow_size)
                }
                cv.texture_color(t, r, src_rect, v.transform, vec4(1.0, 1.0, 1.0, v.opacity), ef.radius, v.color_space)
                if not surface_translucent(p, t) {
                    let opq = if t.opaque() { r } else { draw2d.Rect { x: r.x + p.opaque.x, y: r.y + p.opaque.y, w: p.opaque.w, h: p.opaque.h }.intersect(r) }
                    cv.opaque(opq)
                }
            }
            if ef.border_width > 0.0 {
                let bw = ef.border_width
                let br = draw2d.Rect { x: r.x - bw, y: r.y - bw, w: r.w + bw * 2.0, h: r.h + bw * 2.0 }
                let bc = vec4(ef.border_color.x, ef.border_color.y, ef.border_color.z, ef.border_color.w * v.opacity)
                cv.border(br, bc, ef.radius, bw)
            }
        } else if not is_hw_overlay {
            if v.shadow > 0.0 {
                cv.shadow(r, vec4(0.0, 0.0, 0.0, 0.45 * v.opacity), v.radius, v.shadow)
            }
            cv.texture_color(t, r, src_rect, v.transform, vec4(1.0, 1.0, 1.0, v.opacity), v.radius, v.color_space)
            if not surface_translucent(p, t) {
                let opq = if t.opaque() { r } else { draw2d.Rect { x: r.x + p.opaque.x, y: r.y + p.opaque.y, w: p.opaque.w, h: p.opaque.h }.intersect(r) }
                cv.opaque(opq)
            }
        }
    }

    if not frames_drawn {
        draw_overview_frames(mut cv, out.fx.frames, area)
    }

    // Draw closing-window fade+scale ghost frames driven by `[animation].window-close`.
    for cf in out.fx.closing {
        guard cf.opacity > 0.005 else {
            continue
        }
        let b = closing_bounds(cf)
        guard area.overlaps(b) else {
            continue
        }
        let r = draw2d.Rect { x: cf.x, y: cf.y, w: cf.w, h: cf.h }
        if cf.shadow_size > 0.0 {
            let sc = vec4(cf.shadow_color.x, cf.shadow_color.y, cf.shadow_color.z, cf.shadow_color.w * cf.opacity)
            cv.shadow(r, sc, cf.radius, cf.shadow_size)
        }
        if cf.fill_color.w > 0.001 {
            let fc = vec4(cf.fill_color.x, cf.fill_color.y, cf.fill_color.z, cf.fill_color.w * cf.opacity)
            cv.round_rect(r, fc, cf.radius)
        }
        if cf.border_width > 0.0 {
            let bw = cf.border_width
            let br = draw2d.Rect { x: r.x - bw, y: r.y - bw, w: r.w + bw * 2.0, h: r.h + bw * 2.0 }
            let bc = vec4(cf.border_color.x, cf.border_color.y, cf.border_color.z, cf.border_color.w * cf.opacity)
            cv.border(br, bc, cf.radius, bw)
        }
    }

    // Draw compact GPU SDF tab-indicator pill bars for tabbed columns (zero extra pass, zero font deps).
    for tb in out.fx.tabs {
        guard tb.count > 0 and tb.w > 4.0 and tb.h > 0.5 and area.overlaps(tab_bounds(tb)) else {
            continue
        }
        let gap: f32 = if tb.count > 1 { 4.0 } else { 0.0 }
        let seg_w = max((tb.w - gap * f32(tb.count - 1)) / f32(tb.count), 2.0)
        for ti in 0..tb.count {
            let sr = draw2d.Rect { x: tb.x + f32(ti) * (seg_w + gap), y: tb.y, w: seg_w, h: tb.h }
            let col = if ti == tb.active_idx { tb.active_color } else { tb.inactive_color }
            cv.round_rect(sr, col, tb.radius)
        }
    }

    try cv.draw(mut self.dev, mut e, gpu.Pass { target: dst, load: gpu.Load.Keep }, clips)

    for pi in 0..ps_len {
        if acquired[pi] {
            if let Some(t) = self.texs.get(out.last_ps[pi].tex) {
                e.release(t)
            }
        }
    }
    return Ok(())
}

/// Draw output `o` into target `key` (`age` frames old).
/// Uses partial-damage `vk_compose.Scene.render` on the fast path (no borders/blur),
/// and partial-damage `render_with_effects` (with buffer-age tracking and blur kernel
/// damage expansion) when GPU borders or Dual-Kawase blur are active.
pub fn PastelRenderer.render(mut self, o: int, key: u64, age: u32) -> Result[Option[int], str] {
    try self.flush_uploads()
    guard o < self.outputs.len() else {
        return Ok(None)
    }
    guard let Some(t) = self.targets.get(key) else {
        return Err("no render target {key}")
    }
    let fmt = t.format()
    var canvas = try self.take_canvas(fmt)
    var e = match self.dev.encoder() {
        Ok(e) => e
        Err(err) => {
            self.put_canvas(fmt, canvas)
            return Err(err)
        }
    }
    var out = mem.replace(mut self.outputs[o], blank_output())
    let need_fx = need_effects_path(out)

    var drew = false
    var err_msg = ""
    var ok = true
    if not need_fx {
        if out.fx_prev_used {
            out.scene.damage_all()
        }
        match out.scene.render(mut self.dev, mut canvas, mut e, gpu.Frame.new(t, age)) {
            Ok(d) => drew = d
            Err(err) => {
                ok = false
                err_msg = err
            }
        }
        out.fx_pending.clear()
        out.fx_prev_used = false
    } else {
        let screen = screen_rect(out)
        let switched = not out.fx_prev_used
        if switched {
            add_fx_damage(mut out, screen)
        }
        // Check if an active X-Ray blur needs a full-screen background pass to populate its cache,
        // or if live-blurred regions require kernel-radius damage expansion.
        var need_full_xray = false
        var live_blur_rects: List[draw2d.Rect] = []
        if out.fx.blur.enabled {
            for pi in 0..out.last_ps.len() {
                let fi = if pi < out.ps_fx.len() { out.ps_fx[pi] } else { -1 }
                guard fi >= 0 and fi < out.fx.items.len() else {
                    continue
                }
                let ef = out.fx.items[fi]
                guard ef.blur and ef.blur_opacity > 0.01 else {
                    continue
                }
                let p = out.last_ps[pi]
                guard not out.overlay_keys.contains(p.key) else {
                    continue
                }
                guard let Some(ptex) = self.texs.get(p.tex) else {
                    continue
                }
                guard surface_translucent(p, ptex) else {
                    continue
                }
                let use_xray = out.fx.blur.xray and ef.blur_xray and not ef.is_overlay
                if use_xray {
                    if not out.blur_pyr.xray_valid or out.blur_pyr.xray_bg != out.background or out.blur_pyr.format != fmt {
                        need_full_xray = true
                    }
                } else {
                    live_blur_rects.push(placement_rect(p, ptex))
                }
            }
        }
        if need_full_xray {
            add_fx_damage(mut out, screen)
        }
        let blur_pad = blur.kernel_radius(out.fx.blur.passes, out.fx.blur.offset)
        var pending = mem.replace(mut out.fx_pending, vc.Region.new())
        for br in live_blur_rects {
            expand_region_for(mut pending, br, blur_pad, screen)
        }

        let age_i = int(age)
        var area = mem.replace(mut out.fx_area, vc.Region.new())
        area.clear()
        if age_i == 0 or age_i > out.fx_history.len() + 1 or switched or need_full_xray {
            area.add(screen)
        } else {
            area.add_region(pending)
            for i in 0..age_i - 1 {
                area.add_region(out.fx_history[i])
            }
        }
        for br in live_blur_rects {
            expand_region_for(mut area, br, blur_pad, screen)
        }

        var hist_entry = if out.fx_history.len() >= fx_history_len { out.fx_history.pop().unwrap() } else { vc.Region.new() }
        hist_entry.clear()
        hist_entry.add_region(pending)
        out.fx_history.insert(0, hist_entry)
        pending.clear()
        out.fx_pending = pending
        out.fx_prev_used = true

        if not area.is_empty() {
            match self.get_blur_pipes(fmt) {
                Ok(pipes) => {
                    match self.render_with_effects(mut out, mut canvas, pipes, mut e, t, area, need_full_xray) {
                        Ok => drew = true
                        Err(err) => {
                            ok = false
                            err_msg = err
                        }
                    }
                }
                Err(err) => {
                    ok = false
                    err_msg = err
                }
            }
        }
        out.fx_area = area
    }

    self.outputs[o] = out
    self.put_canvas(fmt, canvas)
    guard ok else {
        self.dev.cancel(take e)
        return Err(err_msg)
    }
    guard drew else {
        self.dev.cancel(take e)
        return Ok(None)
    }
    let (_, fence) = try self.dev.submit_sync_file(take e)
    return Ok(Some(int(fence)))
}

pub fn PastelRenderer.read(mut self, key: u64) -> Result[List[u8], str] {
    guard let Some(t) = self.targets.get(key) else {
        return Err("no render target {key}")
    }
    return self.dev.read_texture(t)
}

fn PastelRenderer.draw_placements(mut self, mut cv: draw2d.Canvas, mut e: gpu.Encoder, dst: gpu.Texture, ps: &[types.Placement]) -> Result[(), str] {
    cv.clear()
    cv.set_output_color(types.dst_sdr, 203.0, 1000.0)
    let w = dst.width()
    let h = dst.height()
    cv.rect(draw2d.Rect { w: f32(w), h: f32(h) }, vec4(0.0))
    for p in ps {
        guard let Some(t) = self.texs.get(p.tex) else {
            continue
        }
        let v = to_view(p, t)
        let pw = if v.w > 0.0 { v.w } else if not v.src.is_empty() { v.src.w } else { f32(t.width()) }
        let ph = if v.h > 0.0 { v.h } else if not v.src.is_empty() { v.src.h } else { f32(t.height()) }
        let r = draw2d.Rect { x: v.x, y: v.y, w: pw, h: ph }
        let src_rect = if v.src.is_empty() {
            draw2d.Rect { w: 1.0, h: 1.0 }
        } else {
            let tw = f32(t.width())
            let th = f32(t.height())
            let pic = if v.transform.swaps() { vec2(th, tw) } else { vec2(tw, th) }
            draw2d.Rect { x: v.src.x / pic.x, y: v.src.y / pic.y, w: v.src.w / pic.x, h: v.src.h / pic.y }
        }
        if v.shadow > 0.0 {
            cv.shadow(r, vec4(0.0, 0.0, 0.0, 0.45 * v.opacity), v.radius, v.shadow)
        }
        cv.texture_color(t, r, src_rect, v.transform, vec4(1.0, 1.0, 1.0, v.opacity), v.radius, v.color_space)
        e.acquire(t)
    }
    let none: List[draw2d.Rect] = []
    try cv.draw(mut self.dev, mut e, gpu.Pass { target: dst, load: gpu.Load.Clear, clear: [0.0, 0.0, 0.0, 0.0] }, none)
    for p in ps {
        if let Some(t) = self.texs.get(p.tex) {
            e.release(t)
        }
    }
    return Ok(())
}

pub fn PastelRenderer.copy_dmabuf(mut self, target_key: u64, dst_buf: types.Dmabuf, sx: i32, sy: i32, w: i32, h: i32) -> Result[int, str] {
    try self.flush_uploads()
    guard let Some(src) = self.targets.get(target_key) else {
        return Err("no render target {target_key}")
    }
    guard w > 0 and h > 0 and w <= dst_buf.width and h <= dst_buf.height else {
        return Err("invalid capture copy rect {w}x{h} into {dst_buf.width}x{dst_buf.height}")
    }
    let dst = try format.import_dmabuf_target(mut self.dev, dst_buf)
    if src.format() != dst.format() {
        self.dev.destroy_texture(dst)
        return Err("capture target format differs from output format")
    }
    var e = match self.dev.encoder() {
        Ok(e) => e
        Err(err) => {
            self.dev.destroy_texture(dst)
            return Err(err)
        }
    }
    e.acquire(dst)
    e.copy_texture(src, dst, sx, sy, 0, 0, u32(w), u32(h))
    e.release(dst)
    let res = self.dev.submit_sync_file(take e)
    self.dev.destroy_texture(dst)
    let (_, fence) = try res
    return Ok(int(fence))
}

pub fn PastelRenderer.render_offscreen(mut self, width: u32, height: u32, ps: &[types.Placement]) -> Result[List[u8], str] {
    try self.flush_uploads()
    guard width > 0 and height > 0 else {
        return Err("invalid offscreen capture size {width}x{height}")
    }
    let dst = try self.dev.texture(gpu.TextureDesc { width, height, format: gpu.Format.B8G8R8A8_UNORM, target: true })
    guard let Some(cv) = self.canvas.take() else {
        self.dev.destroy_texture(dst)
        return Err("no canvas")
    }
    var canvas = cv
    var e = match self.dev.encoder() {
        Ok(e) => e
        Err(err) => {
            self.canvas = Some(canvas)
            self.dev.destroy_texture(dst)
            return Err(err)
        }
    }
    let r = self.draw_placements(mut canvas, mut e, dst, ps)
    self.canvas = Some(canvas)
    guard r.is_ok() else {
        self.dev.cancel(take e)
        self.dev.destroy_texture(dst)
        return Err(r.unwrap_err())
    }
    let ticket = match self.dev.submit(take e) {
        Ok(t) => t
        Err(err) => {
            self.dev.destroy_texture(dst)
            return Err(err)
        }
    }
    if let Err(err) = self.dev.wait(ticket) {
        self.dev.destroy_texture(dst)
        return Err(err)
    }
    let px = self.dev.read_texture(dst)
    self.dev.destroy_texture(dst)
    return px
}

pub fn PastelRenderer.render_offscreen_dmabuf(mut self, dst_buf: types.Dmabuf, ps: &[types.Placement]) -> Result[int, str] {
    try self.flush_uploads()
    guard let Some((vf, _)) = format.vk_format(dst_buf.format) else {
        return Err("capture format {dst_buf.format:08x} is not supported")
    }
    let dst = try format.import_dmabuf_target(mut self.dev, dst_buf)
    let cv_fmt = if dst.can_target() { vf } else { gpu.Format.B8G8R8A8_UNORM }
    var cv = match self.take_canvas(cv_fmt) {
        Ok(c) => c
        Err(err) => {
            self.dev.destroy_texture(dst)
            return Err(err)
        }
    }
    var e = match self.dev.encoder() {
        Ok(e) => e
        Err(err) => {
            self.put_canvas(cv_fmt, cv)
            self.dev.destroy_texture(dst)
            return Err(err)
        }
    }
    if dst.can_target() {
        e.acquire(dst)
        let r = self.draw_placements(mut cv, mut e, dst, ps)
        self.put_canvas(cv_fmt, cv)
        guard r.is_ok() else {
            self.dev.cancel(take e)
            self.dev.destroy_texture(dst)
            return Err(r.unwrap_err())
        }
        e.release(dst)
        let res = self.dev.submit_sync_file(take e)
        self.dev.destroy_texture(dst)
        let (_, fence) = try res
        return Ok(int(fence))
    }
    let tmp = match self.dev.texture(gpu.TextureDesc { width: dst.width(), height: dst.height(), format: gpu.Format.B8G8R8A8_UNORM, target: true }) {
        Ok(t) => t
        Err(err) => {
            self.put_canvas(cv_fmt, cv)
            self.dev.cancel(take e)
            self.dev.destroy_texture(dst)
            return Err(err)
        }
    }
    let r = self.draw_placements(mut cv, mut e, tmp, ps)
    self.put_canvas(cv_fmt, cv)
    guard r.is_ok() else {
        self.dev.cancel(take e)
        self.dev.destroy_texture(tmp)
        self.dev.destroy_texture(dst)
        return Err(r.unwrap_err())
    }
    e.acquire(dst)
    e.copy_texture(tmp, dst, 0, 0, 0, 0, dst.width(), dst.height())
    e.release(dst)
    let res = self.dev.submit_sync_file(take e)
    self.dev.destroy_texture(tmp)
    self.dev.destroy_texture(dst)
    let (_, fence) = try res
    return Ok(int(fence))
}

pub fn PastelRenderer.changed(self, o: int, mut out: List[(i32, i32, i32, i32)]) {
    guard o < self.outputs.len() else {
        return
    }
    if self.outputs[o].fx_prev_used {
        if not self.outputs[o].fx_history.is_empty() {
            for r in self.outputs[o].fx_history[0].rects() {
                out.push((i32(r.x), i32(r.y), i32(r.w), i32(r.h)))
            }
        }
        return
    }
    for r in self.outputs[o].scene.changed() {
        out.push((i32(r.x), i32(r.y), i32(r.w), i32(r.h)))
    }
}

pub fn PastelRenderer.close(mut self) {
    if let Some(u) = self.uploads.take() {
        var enc = u
        self.dev.cancel(take enc)
    }
    if not self.dev.lost() {
        discard self.dev.idle()
    }
    for o in 0..self.outputs.len() {
        var pyr = mem.replace(mut self.outputs[o].blur_pyr, blur.BlurPyramid {})
        pyr.destroy(mut self.dev)
        self.outputs[o].blur_pyr = pyr
    }
    for t in self.texs.values() {
        self.dev.destroy_texture(t)
    }
    self.texs.clear()
    self.shms.clear()
    for t in self.targets.values() {
        self.dev.destroy_texture(t)
    }
    self.targets.clear()
    if let Some(bp) = self.blur_pipes.take() {
        bp.destroy(mut self.dev)
    }
    let extra_bp = mem.replace(mut self.extra_blur_pipes, [])
    for entry in extra_bp {
        entry.1.destroy(mut self.dev)
    }
    if let Some(cv) = self.canvas.take() {
        cv.destroy(mut self.dev)
    }
    let extra_cv = mem.replace(mut self.extra_canvases, [])
    for entry in extra_cv {
        entry.1.destroy(mut self.dev)
    }
}
