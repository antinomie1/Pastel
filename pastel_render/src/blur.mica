// Dual-Kawase GPU backdrop blur pipelines and lazily allocated mip pyramid.

import vk_gpu as gpu
import vk_draw2d as draw2d

/// Push constant block matching `shaders/blur.glsl` (48 bytes).
@derive(Bytes)
struct BlurPush {
    tex: u32 = 0
    dx: f32 = 0.0
    dy: f32 = 0.0
    alpha: f32 = 1.0
    rect: vec4 = zeroed()
    screen: vec2 = zeroed()
    radius: f32 = 0.0
    pad: f32 = 0.0
}

let push_bytes: u64 = 48

/// Dual-Kawase downsample, upsample, and SDF-clipped composite pipelines.
pub struct BlurPipelines {
    pub down: gpu.Pipeline
    pub up: gpu.Pipeline
    pub comp: gpu.Pipeline
}

pub fn BlurPipelines.create(mut dev: gpu.Device, fmt: gpu.Format) -> Result[BlurPipelines, str] {
    assert(u64(size_of[BlurPush]()) == push_bytes)
    let vs = embed("../shaders/blur.vert.spv")
    let opaque_desc = gpu.Graphics { color: fmt, blend: gpu.Blend.Opaque }
    let alpha_desc = gpu.Graphics { color: fmt, blend: gpu.Blend.Alpha }
    let down = try dev.graphics(opaque_desc, vs, embed("../shaders/blur_down.frag.spv"))
    let up = match dev.graphics(opaque_desc, vs, embed("../shaders/blur_up.frag.spv")) {
        Ok(p) => p
        Err(e) => {
            dev.destroy_pipeline(down)
            return Err(e)
        }
    }
    let comp = match dev.graphics(alpha_desc, vs, embed("../shaders/blur_comp.frag.spv")) {
        Ok(p) => p
        Err(e) => {
            dev.destroy_pipeline(down)
            dev.destroy_pipeline(up)
            return Err(e)
        }
    }
    return Ok(BlurPipelines { down, up, comp })
}

pub fn BlurPipelines.destroy(self, mut dev: gpu.Device) {
    dev.destroy_pipeline(self.down)
    dev.destroy_pipeline(self.up)
    dev.destroy_pipeline(self.comp)
}

/// Lazily allocated offscreen pyramid for one output.
/// In X-Ray-only mode, `levels[0]` directly holds the cached X-Ray blur (`xray_in_level0 = true`),
/// avoiding an extra half-resolution VRAM texture and GPU copy. When live blur also runs on the
/// same output (e.g. a floating window or hotkey overlay), `levels[0]` is promoted to `xray_tex`
/// in O(1) without copying, and compacted back once live blur disappears.
pub struct BlurPyramid {
    pub width: u32 = 0
    pub height: u32 = 0
    pub depth: int = 0
    pub format: gpu.Format = gpu.Format.B8G8R8A8_UNORM
    pub levels: List[gpu.Texture] = []
    pub xray_tex: Option[gpu.Texture] = None
    pub xray_bg: vec4 = zeroed()
    pub xray_valid: bool = false
    pub xray_in_level0: bool = false
}

pub fn BlurPyramid.is_allocated(self) -> bool {
    return not self.levels.is_empty() or self.xray_tex.is_some()
}

pub fn BlurPyramid.destroy(mut self, mut dev: gpu.Device) {
    for t in self.levels {
        dev.destroy_texture(t)
    }
    self.levels.clear()
    if let Some(t) = self.xray_tex.take() {
        dev.destroy_texture(t)
    }
    self.width = 0
    self.height = 0
    self.depth = 0
    self.xray_valid = false
    self.xray_in_level0 = false
}

pub fn BlurPyramid.invalidate_xray(mut self) {
    self.xray_valid = false
}

/// True when a valid cached X-Ray blurred texture matches `(w, h, passes, fmt, bg)`.
pub fn BlurPyramid.has_valid_xray(self, w: u32, h: u32, passes: int, fmt: gpu.Format, bg: vec4) -> bool {
    guard self.xray_valid and self.xray_bg == bg and self.format == fmt and self.width == w and self.height == h and self.depth == passes.clamp(1, 4) else {
        return false
    }
    if self.xray_in_level0 {
        return not self.levels.is_empty()
    }
    return self.xray_tex.is_some()
}

/// Return the cached X-Ray texture when valid.
pub fn BlurPyramid.xray_texture(self) -> Option[gpu.Texture] {
    guard self.xray_valid else {
        return None
    }
    if self.xray_in_level0 {
        return if not self.levels.is_empty() { Some(self.levels[0]) } else { None }
    }
    return self.xray_tex
}

/// When live blur is no longer active alongside a valid X-Ray cache, drop the extra half-res
/// live-blur level-0 texture by moving `xray_tex` back into `levels[0]` with zero GPU work.
pub fn BlurPyramid.compact_xray(mut self, mut dev: gpu.Device) {
    guard self.xray_valid and not self.xray_in_level0 and not self.levels.is_empty() else {
        return
    }
    guard let Some(xt) = self.xray_tex.take() else {
        return
    }
    let old_l0 = self.levels[0]
    if xt.width() == old_l0.width() and xt.height() == old_l0.height() and xt.format() == old_l0.format() {
        self.levels[0] = xt
        dev.destroy_texture(old_l0)
        self.xray_in_level0 = true
    } else {
        self.xray_tex = Some(xt)
    }
}

/// Ensure the half/quarter/eighth-resolution mip pyramid matches `(w, h, passes, fmt)`.
pub fn BlurPyramid.ensure(mut self, mut dev: gpu.Device, w: u32, h: u32, passes: int, fmt: gpu.Format) -> Result[(), str] {
    let d = passes.clamp(1, 4)
    if self.width == w and self.height == h and self.depth == d and self.format == fmt and self.levels.len() == d {
        return Ok(())
    }
    self.destroy(mut dev)
    var cw = max(w / 2, u32(1))
    var ch = max(h / 2, u32(1))
    for _ in 0..d {
        let desc = gpu.TextureDesc { width: cw, height: ch, format: fmt, target: true }
        let tex = try dev.texture(desc)
        self.levels.push(tex)
        cw = max(cw / 2, u32(1))
        ch = max(ch / 2, u32(1))
    }
    self.width = w
    self.height = h
    self.depth = d
    self.format = fmt
    self.xray_valid = false
    self.xray_in_level0 = false
    return Ok(())
}

/// Execute the Dual-Kawase downsample -> upsample chain from `src` writing the final half-res
/// level directly into `final_dst` (zero intermediate copy).
fn BlurPyramid.run_chain(self, pipes: BlurPipelines, mut e: gpu.Encoder, src: gpu.Texture, final_dst: gpu.Texture, w: u32, h: u32, passes: int, offset: f32, region: draw2d.Rect) {
    let n = self.levels.len()
    let off = offset.clamp(0.5, 8.0)
    let fw = max(f32(w), 1.0)
    let fh = max(f32(h), 1.0)
    let pad = kernel_radius(passes, off)
    let bx0 = max(region.x - pad, 0.0)
    let by0 = max(region.y - pad, 0.0)
    let bx1 = min(region.x + region.w + pad, fw)
    let by1 = min(region.y + region.h + pad, fh)
    let use_scissor = bx1 > bx0 and by1 > by0 and ((bx1 - bx0) < fw * 0.92 or (by1 - by0) < fh * 0.92)
    let extra = i32(off.ceil()) + 2

    // Downsample chain: src -> level[0] -> level[1] -> ... -> level[n-1]
    // (When n == 1, downsample writes directly into final_dst.)
    var prev = src
    var pw = fw
    var ph = fh
    for i in 0..n {
        let dst = if n == 1 { final_dst } else { self.levels[i] }
        let dw = dst.width()
        let dh = dst.height()
        let push = BlurPush {
            tex: prev.index(),
            dx: off / max(pw, 1.0),
            dy: off / max(ph, 1.0),
        }
        if use_scissor {
            let ux0 = if n == 1 { max(region.x, 0.0) } else { bx0 }
            let uy0 = if n == 1 { max(region.y, 0.0) } else { by0 }
            let ux1 = if n == 1 { min(region.x + region.w, fw) } else { bx1 }
            let uy1 = if n == 1 { min(region.y + region.h, fh) } else { by1 }
            let pad_tx = if n == 1 { i32(2) } else { extra }
            let sx0 = max(i32((ux0 * f32(dw) / fw).floor()) - pad_tx, 0)
            let sy0 = max(i32((uy0 * f32(dh) / fh).floor()) - pad_tx, 0)
            let sx1 = min(i32((ux1 * f32(dw) / fw).ceil()) + pad_tx, i32(dw))
            let sy1 = min(i32((uy1 * f32(dh) / fh).ceil()) + pad_tx, i32(dh))
            let sw = u32(max(sx1 - sx0, 1))
            let sh = u32(max(sy1 - sy0, 1))
            e.render(gpu.Pass { target: dst, load: gpu.Load.Discard }, fn(mut r) {
                r.bind(pipes.down)
                r.scissor(sx0, sy0, sw, sh)
                r.push(bytes_of(push))
                r.draw(3, 1)
            })
        } else {
            e.render(gpu.Pass { target: dst, load: gpu.Load.Discard }, fn(mut r) {
                r.bind(pipes.down)
                r.push(bytes_of(push))
                r.draw(3, 1)
            })
        }
        prev = dst
        pw = f32(dw)
        ph = f32(dh)
    }

    // Upsample chain: level[n-1] -> level[n-2] -> ... -> final_dst
    var i = n - 2
    while i >= 0 {
        let src_t = self.levels[i + 1]
        let dst_t = if i == 0 { final_dst } else { self.levels[i] }
        let dw = dst_t.width()
        let dh = dst_t.height()
        let push = BlurPush {
            tex: src_t.index(),
            dx: off / max(f32(dw), 1.0),
            dy: off / max(f32(dh), 1.0),
        }
        if use_scissor {
            // The final upsample pass (`i == 0`) is only bilinear-sampled inside `region`,
            // so it needs only a 2-texel filter margin rather than the full blur kernel radius.
            let ux0 = if i == 0 { max(region.x, 0.0) } else { bx0 }
            let uy0 = if i == 0 { max(region.y, 0.0) } else { by0 }
            let ux1 = if i == 0 { min(region.x + region.w, fw) } else { bx1 }
            let uy1 = if i == 0 { min(region.y + region.h, fh) } else { by1 }
            let pad_tx = if i == 0 { i32(2) } else { extra }
            let sx0 = max(i32((ux0 * f32(dw) / fw).floor()) - pad_tx, 0)
            let sy0 = max(i32((uy0 * f32(dh) / fh).floor()) - pad_tx, 0)
            let sx1 = min(i32((ux1 * f32(dw) / fw).ceil()) + pad_tx, i32(dw))
            let sy1 = min(i32((uy1 * f32(dh) / fh).ceil()) + pad_tx, i32(dh))
            let sw = u32(max(sx1 - sx0, 1))
            let sh = u32(max(sy1 - sy0, 1))
            e.render(gpu.Pass { target: dst_t, load: gpu.Load.Discard }, fn(mut r) {
                r.bind(pipes.up)
                r.scissor(sx0, sy0, sw, sh)
                r.push(bytes_of(push))
                r.draw(3, 1)
            })
        } else {
            e.render(gpu.Pass { target: dst_t, load: gpu.Load.Discard }, fn(mut r) {
                r.bind(pipes.up)
                r.push(bytes_of(push))
                r.draw(3, 1)
            })
        }
        i -= 1
    }
}

/// Run Dual-Kawase downsample -> upsample on `src` and return the blurred level-0 texture.
pub fn BlurPyramid.blur_from(mut self, mut dev: gpu.Device, pipes: BlurPipelines, mut e: gpu.Encoder, src: gpu.Texture, w: u32, h: u32, passes: int, offset: f32) -> Result[gpu.Texture, str] {
    let full = draw2d.Rect { w: f32(w), h: f32(h) }
    return self.blur_region(mut dev, pipes, mut e, src, w, h, passes, offset, full)
}

/// Run Dual-Kawase downsample -> upsample on `src` scissored to `region` expanded by the
/// blur kernel radius, avoiding full-screen blur passes when moving/resizing floating windows.
pub fn BlurPyramid.blur_region(mut self, mut dev: gpu.Device, pipes: BlurPipelines, mut e: gpu.Encoder, src: gpu.Texture, w: u32, h: u32, passes: int, offset: f32, region: draw2d.Rect) -> Result[gpu.Texture, str] {
    let fmt = src.format()
    try self.ensure(mut dev, w, h, passes, fmt)
    // Preserve an intact X-Ray cache in `levels[0]` by promoting it to `xray_tex` without GPU copy.
    if self.xray_valid and self.xray_in_level0 and not self.levels.is_empty() {
        let l0 = self.levels[0]
        let new_l0 = try dev.texture(gpu.TextureDesc { width: l0.width(), height: l0.height(), format: fmt, target: true })
        if let Some(old_x) = self.xray_tex.take() {
            dev.destroy_texture(old_x)
        }
        self.xray_tex = Some(l0)
        self.levels[0] = new_l0
        self.xray_in_level0 = false
    }
    self.run_chain(pipes, mut e, src, self.levels[0], w, h, passes, offset, region)
    return Ok(self.levels[0])
}

/// Ensure a cached X-Ray blurred texture exists at half resolution, blurring `src` only when invalid
/// and writing the final upsample pass directly into the cache texture (zero GPU copy).
pub fn BlurPyramid.ensure_xray(mut self, mut dev: gpu.Device, pipes: BlurPipelines, mut e: gpu.Encoder, src: gpu.Texture, w: u32, h: u32, passes: int, offset: f32, bg: vec4) -> Result[gpu.Texture, str] {
    let fmt = src.format()
    if self.has_valid_xray(w, h, passes, fmt, bg) {
        if let Some(t) = self.xray_texture() {
            return Ok(t)
        }
    }
    try self.ensure(mut dev, w, h, passes, fmt)
    let bw = self.levels[0].width()
    let bh = self.levels[0].height()
    if let Some(xt) = self.xray_tex {
        if xt.width() != bw or xt.height() != bh or xt.format() != fmt {
            dev.destroy_texture(xt)
            self.xray_tex = None
        }
    }
    let full = draw2d.Rect { w: f32(w), h: f32(h) }
    if let Some(cache) = self.xray_tex {
        self.run_chain(pipes, mut e, src, cache, w, h, passes, offset, full)
        self.xray_bg = bg
        self.xray_valid = true
        self.xray_in_level0 = false
        return Ok(cache)
    }
    let dst0 = self.levels[0]
    self.run_chain(pipes, mut e, src, dst0, w, h, passes, offset, full)
    self.xray_bg = bg
    self.xray_valid = true
    self.xray_in_level0 = true
    return Ok(dst0)
}

/// Conservative screen-pixel blur sampling radius for damage expansion.
pub fn kernel_radius(passes: int, offset: f32) -> f32 {
    let p = passes.clamp(1, 4)
    let off = offset.clamp(0.5, 8.0)
    var scale: f32 = 1.0
    for _ in 0..p {
        scale *= 2.0
    }
    return scale * off * 2.0 + 4.0
}

/// Composite `blurred` into `dst`, scissored to the intersection of `rect` with each damage clip
/// in `clips` (or `rect` itself when `clips` is empty).
pub fn composite_clips(pipes: BlurPipelines, mut e: gpu.Encoder, blurred: gpu.Texture, dst: gpu.Texture, rect: draw2d.Rect, radius: f32, alpha: f32, clips: Slice[draw2d.Rect]) {
    let sw = f32(dst.width())
    let sh = f32(dst.height())
    let rx0 = max(i32(rect.x.floor()), 0)
    let ry0 = max(i32(rect.y.floor()), 0)
    let rx1 = min(i32((rect.x + rect.w).ceil()), i32(dst.width()))
    let ry1 = min(i32((rect.y + rect.h).ceil()), i32(dst.height()))
    guard rx1 > rx0 and ry1 > ry0 and alpha > 0.001 else {
        return
    }
    let push = BlurPush {
        tex: blurred.index(),
        alpha: alpha.clamp(0.0, 1.0),
        rect: vec4(rect.x, rect.y, rect.w, rect.h),
        screen: vec2(sw, sh),
        radius: max(radius, 0.0),
    }
    if clips.is_empty() {
        e.render(gpu.Pass { target: dst, load: gpu.Load.Keep }, fn(mut r) {
            r.bind(pipes.comp)
            r.scissor(rx0, ry0, u32(rx1 - rx0), u32(ry1 - ry0))
            r.push(bytes_of(push))
            r.draw(3, 1)
        })
        return
    }
    var any_hit = false
    for c in clips {
        let cx0 = max(rx0, i32(c.x.floor()))
        let cy0 = max(ry0, i32(c.y.floor()))
        let cx1 = min(rx1, i32((c.x + c.w).ceil()))
        let cy1 = min(ry1, i32((c.y + c.h).ceil()))
        if cx1 > cx0 and cy1 > cy0 {
            any_hit = true
            break
        }
    }
    guard any_hit else {
        return
    }
    e.render(gpu.Pass { target: dst, load: gpu.Load.Keep }, fn(mut r) {
        r.bind(pipes.comp)
        r.push(bytes_of(push))
        for c in clips {
            let cx0 = max(rx0, i32(c.x.floor()))
            let cy0 = max(ry0, i32(c.y.floor()))
            let cx1 = min(rx1, i32((c.x + c.w).ceil()))
            let cy1 = min(ry1, i32((c.y + c.h).ceil()))
            if cx1 > cx0 and cy1 > cy0 {
                r.scissor(cx0, cy0, u32(cx1 - cx0), u32(cy1 - cy0))
                r.draw(3, 1)
            }
        }
    })
}
