// Workspace: combines a ScrollingStrip, floating window layer, and fullscreen state.

import pastel_core as core
import traits
import column
import scrolling

/// A floating window with explicit logical geometry.
pub struct FloatingWin {
    pub id: u64
    pub rect: core.Rect
}

/// One workspace on a monitor.
pub struct Workspace {
    pub id: u64 = 1
    pub strip: scrolling.ScrollingStrip = scrolling.ScrollingStrip {}
    /// Back-to-front floating windows; last element is topmost.
    pub floating: List[FloatingWin] = []
    /// Whether keyboard focus is currently on the floating layer.
    pub focus_floating: bool = false
    /// Window currently fullscreen on this workspace, if any.
    pub fullscreen: Option[u64] = None
}

pub fn Workspace.new(id: u64) -> Workspace {
    return Workspace { id, strip: scrolling.ScrollingStrip.new() }
}

pub fn Workspace.is_empty(self) -> bool {
    return self.strip.is_empty() and self.floating.is_empty()
}

pub fn Workspace.window_count(self) -> int {
    return self.strip.window_count() + self.floating.len()
}

pub fn Workspace.find_floating(self, id: u64) -> int {
    for i, f in self.floating {
        if f.id == id {
            return i
        }
    }
    return -1
}

pub fn Workspace.focused(self) -> Option[u64] {
    if let Some(fs) = self.fullscreen {
        return Some(fs)
    }
    if self.focus_floating and not self.floating.is_empty() {
        return Some(self.floating[self.floating.len() - 1].id)
    }
    if let Some(t) = self.strip.focused() {
        return Some(t)
    }
    if not self.floating.is_empty() {
        return Some(self.floating[self.floating.len() - 1].id)
    }
    return None
}

pub fn Workspace.column_width_for(self, id: u64) -> Option[f64] {
    return self.strip.column_width_for(id)
}

pub fn Workspace.insert_tiled(mut self, id: u64, width_hint: f64) {
    self.fullscreen = None
    self.strip.insert(id, width_hint)
    self.focus_floating = false
}

pub fn Workspace.insert_tiled_unfocused(mut self, id: u64, width_hint: f64) {
    if self.is_empty() {
        self.insert_tiled(id, width_hint)
        return
    }
    self.strip.insert_unfocused(id, width_hint)
}

pub fn Workspace.insert_column(mut self, take col: column.Column) {
    self.fullscreen = None
    self.strip.insert_column(col)
    self.focus_floating = false
}

pub fn Workspace.insert_floating(mut self, id: u64, rect: core.Rect) {
    self.fullscreen = None
    self.floating.push(FloatingWin { id, rect })
    self.focus_floating = true
}

pub fn Workspace.insert_floating_unfocused(mut self, id: u64, rect: core.Rect) {
    if self.is_empty() {
        self.insert_floating(id, rect)
        return
    }
    self.floating.insert(0, FloatingWin { id, rect })
}

pub fn Workspace.remove(mut self, id: u64) -> bool {
    if self.fullscreen == Some(id) {
        self.fullscreen = None
    }
    let fi = self.find_floating(id)
    if fi >= 0 {
        discard self.floating.remove(fi)
        if self.floating.is_empty() {
            self.focus_floating = false
        }
        return true
    }
    let removed = self.strip.remove(id)
    if removed and self.strip.is_empty() and not self.floating.is_empty() {
        self.focus_floating = true
    }
    return removed
}

pub fn Workspace.focus_window(mut self, id: u64) -> bool {
    if self.fullscreen.is_some() and self.fullscreen != Some(id) {
        self.fullscreen = None
    }
    let fi = self.find_floating(id)
    if fi >= 0 {
        if fi != self.floating.len() - 1 {
            let f = self.floating.remove(fi)
            self.floating.push(f)
        }
        self.focus_floating = true
        return true
    }
    if self.strip.focus_window(id) {
        self.focus_floating = false
        return true
    }
    return false
}

pub fn Workspace.switch_focus_layer(mut self) -> Option[u64] {
    self.fullscreen = None
    if self.focus_floating {
        if not self.strip.is_empty() {
            self.focus_floating = false
        }
    } else if not self.floating.is_empty() {
        self.focus_floating = true
    }
    return self.focused()
}

pub fn Workspace.set_column_maximized(mut self, id: u64, on: bool) -> bool {
    return self.strip.set_column_maximized(id, on)
}

pub fn Workspace.move_floating(mut self, id: u64, dx: f64, dy: f64) -> bool {
    let fi = self.find_floating(id)
    guard fi >= 0 else {
        return false
    }
    self.floating[fi].rect.x += dx
    self.floating[fi].rect.y += dy
    return true
}

pub fn Workspace.resize_floating(mut self, id: u64, dx: f64, dy: f64, w: f64, h: f64) -> bool {
    let fi = self.find_floating(id)
    guard fi >= 0 else {
        return false
    }
    self.floating[fi].rect.x += dx
    self.floating[fi].rect.y += dy
    self.floating[fi].rect.w = max(w, 64.0)
    self.floating[fi].rect.h = max(h, 64.0)
    return true
}

/// Compute all targets for this workspace split into strict Z-order layers:
/// `tiled_out` -> `float_out` -> `full_out`.
/// When a window is fullscreen on this workspace, only that fullscreen window is emitted
/// (at `full_rect`, above all layers) so occluded windows never bleed over it and direct
/// scanout can activate cleanly.
pub fn Workspace.compute_layers(mut self, monitor_idx: int, ws_idx: int, is_active_monitor: bool, full_rect: core.Rect, usable_rect: core.Rect, gap: f64, center: traits.CenterMode, mut tiled_out: List[traits.TileTarget], mut float_out: List[traits.TileTarget], mut full_out: List[traits.TileTarget]) {
    if let Some(fs_id) = self.fullscreen {
        full_out.push(traits.TileTarget {
            id: fs_id,
            rect: full_rect,
            focused: is_active_monitor,
            floating: false,
            fullscreen: true,
            maximized: false,
            monitor_idx,
            workspace_idx: ws_idx,
        })
        return
    }
    let active_win = self.focused().unwrap_or(0)
    let start = tiled_out.len()
    self.strip.compute(usable_rect, gap, center, mut tiled_out)
    for i in start..tiled_out.len() {
        tiled_out[i].monitor_idx = monitor_idx
        tiled_out[i].workspace_idx = ws_idx
        tiled_out[i].focused = is_active_monitor and tiled_out[i].id == active_win
    }
    for f in self.floating {
        float_out.push(traits.TileTarget {
            id: f.id,
            rect: f.rect,
            focused: is_active_monitor and f.id == active_win,
            floating: true,
            fullscreen: false,
            maximized: false,
            monitor_idx,
            workspace_idx: ws_idx,
        })
    }
}

fn transform_overview_targets(mut list: List[traits.TileTarget], start: int, full_rect: core.Rect, usable_rect: core.Rect, band_rect: core.Rect, scale: f64) {
    var i = start
    while i < list.len() {
        let r = list[i].rect
        let nx = band_rect.x + (r.x - full_rect.x) * scale
        let ny = band_rect.y + (r.y - full_rect.y) * scale
        let nw = max(r.w * scale, 4.0)
        let nh = max(r.h * scale, 4.0)
        if nx + nw <= usable_rect.x + 1.0 or nx >= usable_rect.right() - 1.0 {
            discard list.remove(i)
            continue
        }
        list[i].rect = core.Rect.new(nx, ny, nw, nh)
        list[i].overview_scale = scale
        i += 1
    }
}

/// Compute scaled thumbnail targets for this workspace inside `band_rect` for Overview mode.
pub fn Workspace.compute_overview_band(mut self, monitor_idx: int, ws_idx: int, is_active_ws: bool, is_active_monitor: bool, full_rect: core.Rect, usable_rect: core.Rect, band_rect: core.Rect, scale: f64, gap: f64, center: traits.CenterMode, mut tiled_out: List[traits.TileTarget], mut float_out: List[traits.TileTarget], mut full_out: List[traits.TileTarget]) {
    let t0 = tiled_out.len()
    let f0 = float_out.len()
    let fs0 = full_out.len()
    self.compute_layers(monitor_idx, ws_idx, is_active_monitor and is_active_ws, full_rect, usable_rect, gap, center, mut tiled_out, mut float_out, mut full_out)
    transform_overview_targets(mut tiled_out, t0, full_rect, usable_rect, band_rect, scale)
    transform_overview_targets(mut float_out, f0, full_rect, usable_rect, band_rect, scale)
    transform_overview_targets(mut full_out, fs0, full_rect, usable_rect, band_rect, scale)
}
