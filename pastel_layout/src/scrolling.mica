// Niri-like infinite horizontal scrolling strip implementing LayoutPolicy.

import std.mem
import pastel_core as core
import traits
import column

/// Horizontal strip of columns with a logical viewport camera.
pub struct ScrollingStrip {
    pub columns: List[column.Column] = []
    pub active_col: int = 0
    /// Horizontal scroll offset of the viewport in strip-local logical pixels.
    pub camera_x: f64 = 0.0
    /// Sticky center request set by `center_column` (cleared on focus/layout/pan changes).
    pub pinned_center: bool = false
    /// True while user is manually panning (suppresses auto-snap until pan_end).
    pub manual_pan: bool = false
    /// When true, a single column on a workspace is always centered horizontally.
    pub always_center_single: bool = false
    /// Reusable per-frame scratch buffer for zero-allocation `compute`.
    col_w_scratch: List[f64] = []
}

pub fn ScrollingStrip.new() -> ScrollingStrip {
    return ScrollingStrip {}
}

pub fn ScrollingStrip.is_empty(self) -> bool {
    return self.columns.is_empty()
}

pub fn ScrollingStrip.window_count(self) -> int {
    var n = 0
    for c in self.columns {
        n += c.windows.len()
    }
    return n
}

/// Insert a new window as a fresh column right after the active column.
pub fn ScrollingStrip.insert(mut self, id: u64, width_hint: f64) {
    let col = column.Column.single(id, width_hint)
    if self.columns.is_empty() {
        self.columns.push(col)
        self.active_col = 0
    } else {
        let at = min(self.active_col + 1, self.columns.len())
        self.columns.insert(at, col)
        self.active_col = at
    }
    self.manual_pan = false
    self.pinned_center = false
}

/// Insert a new window without stealing column focus (unless the strip is empty).
pub fn ScrollingStrip.insert_unfocused(mut self, id: u64, width_hint: f64) {
    let col = column.Column.single(id, width_hint)
    if self.columns.is_empty() {
        self.columns.push(col)
        self.active_col = 0
    } else {
        let at = min(self.active_col + 1, self.columns.len())
        self.columns.insert(at, col)
    }
}

/// Remove and return the entire active column (preserving vertical stack, width, and tabbed state).
pub fn ScrollingStrip.take_active_column(mut self) -> Option[column.Column] {
    guard not self.columns.is_empty() else {
        return None
    }
    let ci = self.active_col.clamp(0, self.columns.len() - 1)
    let col = self.columns.remove(ci)
    if self.columns.is_empty() {
        self.active_col = 0
        self.camera_x = 0.0
        self.pinned_center = false
        self.manual_pan = false
    } else if self.active_col >= self.columns.len() {
        self.active_col = self.columns.len() - 1
    }
    return Some(col)
}

/// Insert an existing column (preserving vertical stack and width) right after the active column.
pub fn ScrollingStrip.insert_column(mut self, take col: column.Column) {
    guard not col.windows.is_empty() else {
        return
    }
    if self.columns.is_empty() {
        self.columns.push(col)
        self.active_col = 0
    } else {
        let at = min(self.active_col + 1, self.columns.len())
        self.columns.insert(at, col)
        self.active_col = at
    }
    self.manual_pan = false
    self.pinned_center = false
}

/// Remove window `id` from whichever column owns it, preserving neighbor focus cleanly.
pub fn ScrollingStrip.remove(mut self, id: u64) -> bool {
    for ci in 0..self.columns.len() {
        let ri = self.columns[ci].find(id)
        if ri >= 0 {
            discard self.columns[ci].windows.remove(ri)
            if self.columns[ci].windows.is_empty() {
                discard self.columns.remove(ci)
                if self.columns.is_empty() {
                    self.active_col = 0
                    self.camera_x = 0.0
                    self.pinned_center = false
                    self.manual_pan = false
                } else if self.active_col >= self.columns.len() {
                    self.active_col = self.columns.len() - 1
                } else if ci < self.active_col {
                    self.active_col -= 1
                }
            } else if ri < self.columns[ci].active_row {
                self.columns[ci].active_row -= 1
            } else if self.columns[ci].active_row >= self.columns[ci].windows.len() {
                self.columns[ci].active_row = self.columns[ci].windows.len() - 1
            }
            return true
        }
    }
    return false
}

pub fn ScrollingStrip.contains(self, id: u64) -> bool {
    for c in self.columns {
        if c.find(id) >= 0 {
            return true
        }
    }
    return false
}

pub fn ScrollingStrip.column_width_for(self, id: u64) -> Option[f64] {
    for c in self.columns {
        if c.find(id) >= 0 {
            return Some(if c.maximized { c.saved_width } else { c.width_frac })
        }
    }
    return None
}

pub fn ScrollingStrip.focused(self) -> Option[u64] {
    guard not self.columns.is_empty() else {
        return None
    }
    let ci = self.active_col.clamp(0, self.columns.len() - 1)
    return self.columns[ci].active_id()
}

pub fn ScrollingStrip.focus_window(mut self, id: u64) -> bool {
    for ci in 0..self.columns.len() {
        let ri = self.columns[ci].find(id)
        if ri >= 0 {
            if ci != self.active_col {
                self.pinned_center = false
            }
            self.active_col = ci
            self.columns[ci].active_row = ri
            self.manual_pan = false
            return true
        }
    }
    return false
}

pub fn ScrollingStrip.focus_first(mut self) -> Option[u64] {
    guard not self.columns.is_empty() else {
        return None
    }
    self.active_col = 0
    self.manual_pan = false
    self.pinned_center = false
    return self.focused()
}

pub fn ScrollingStrip.focus_last(mut self) -> Option[u64] {
    guard not self.columns.is_empty() else {
        return None
    }
    self.active_col = self.columns.len() - 1
    self.manual_pan = false
    self.pinned_center = false
    return self.focused()
}

/// Move focus horizontally (`dx`: -1 left, +1 right) or vertically (`dy`: -1 up, +1 down).
pub fn ScrollingStrip.focus_dir(mut self, dx: int, dy: int) -> Option[u64] {
    guard not self.columns.is_empty() else {
        return None
    }
    self.manual_pan = false
    if dx != 0 {
        let next = (self.active_col + dx).clamp(0, self.columns.len() - 1)
        if next != self.active_col {
            self.active_col = next
            self.pinned_center = false
        }
    }
    if dy != 0 {
        let ci = self.active_col
        let n = self.columns[ci].windows.len()
        if n > 1 {
            self.columns[ci].active_row = (self.columns[ci].active_row + dy).clamp(0, n - 1)
        }
    }
    return self.focused()
}

/// Move the active column horizontally (`dx`) or active window vertically (`dy`).
pub fn ScrollingStrip.move_dir(mut self, dx: int, dy: int) -> bool {
    guard not self.columns.is_empty() else {
        return false
    }
    self.manual_pan = false
    if dx != 0 {
        let target = self.active_col + dx
        guard target >= 0 and target < self.columns.len() else {
            return false
        }
        self.columns.swap(self.active_col, target)
        self.active_col = target
        self.pinned_center = false
        return true
    }
    if dy != 0 {
        let ci = self.active_col
        let ri = self.columns[ci].active_row
        let target = ri + dy
        guard target >= 0 and target < self.columns[ci].windows.len() else {
            return false
        }
        self.columns[ci].windows.swap(ri, target)
        self.columns[ci].active_row = target
        return true
    }
    return false
}

/// Pull the active window into the left adjacent column (or absorb the right column if at index 0).
pub fn ScrollingStrip.consume_into_column(mut self) -> bool {
    guard self.columns.len() >= 2 else {
        return false
    }
    if self.active_col > 0 {
        let ci = self.active_col
        let ri = self.columns[ci].active_row
        let slot = self.columns[ci].windows.remove(ri)
        if self.columns[ci].windows.is_empty() {
            discard self.columns.remove(ci)
        } else if self.columns[ci].active_row >= self.columns[ci].windows.len() {
            self.columns[ci].active_row = self.columns[ci].windows.len() - 1
        }
        let target_col = ci - 1
        self.columns[target_col].windows.push(slot)
        self.columns[target_col].active_row = self.columns[target_col].windows.len() - 1
        self.active_col = target_col
        self.manual_pan = false
        self.pinned_center = false
        return true
    }
    // Active column is 0: pull top window of column 1 into column 0.
    let slot = self.columns[1].windows.remove(0)
    if self.columns[1].windows.is_empty() {
        discard self.columns.remove(1)
    } else if self.columns[1].active_row > 0 {
        self.columns[1].active_row -= 1
    } else if self.columns[1].active_row >= self.columns[1].windows.len() {
        self.columns[1].active_row = self.columns[1].windows.len() - 1
    }
    self.columns[0].windows.push(slot)
    self.columns[0].active_row = self.columns[0].windows.len() - 1
    self.manual_pan = false
    self.pinned_center = false
    return true
}

/// Expel the active window out of a multi-window column into a new column to the right.
pub fn ScrollingStrip.expel_from_column(mut self) -> bool {
    guard not self.columns.is_empty() else {
        return false
    }
    let ci = self.active_col
    guard self.columns[ci].windows.len() > 1 else {
        return false
    }
    let ri = self.columns[ci].active_row
    let slot = self.columns[ci].windows.remove(ri)
    if self.columns[ci].active_row >= self.columns[ci].windows.len() {
        self.columns[ci].active_row = self.columns[ci].windows.len() - 1
    }
    let frac = self.columns[ci].width_frac
    self.columns.insert(ci + 1, column.Column.single(slot.id, frac))
    self.active_col = ci + 1
    self.manual_pan = false
    self.pinned_center = false
    return true
}

/// Niri-style directional consume/expel to the left:
/// if active column has multiple windows, expel active window into a new column to the left;
/// otherwise consume the solo window into the column to the left.
pub fn ScrollingStrip.consume_or_expel_left(mut self) -> bool {
    guard not self.columns.is_empty() else {
        return false
    }
    let ci = self.active_col.clamp(0, self.columns.len() - 1)
    if self.columns[ci].windows.len() > 1 {
        let ri = self.columns[ci].active_row.clamp(0, self.columns[ci].windows.len() - 1)
        let slot = self.columns[ci].windows.remove(ri)
        if self.columns[ci].active_row >= self.columns[ci].windows.len() {
            self.columns[ci].active_row = self.columns[ci].windows.len() - 1
        }
        let frac = self.columns[ci].width_frac
        self.columns.insert(ci, column.Column.single(slot.id, frac))
        self.active_col = ci
        self.manual_pan = false
        self.pinned_center = false
        return true
    }
    guard ci > 0 else {
        return false
    }
    let slot = self.columns[ci].windows.remove(0)
    discard self.columns.remove(ci)
    let target = ci - 1
    self.columns[target].windows.push(slot)
    self.columns[target].active_row = self.columns[target].windows.len() - 1
    self.active_col = target
    self.manual_pan = false
    self.pinned_center = false
    return true
}

/// Niri-style directional consume/expel to the right:
/// if active column has multiple windows, expel active window into a new column to the right;
/// otherwise consume the solo window into the column to the right.
pub fn ScrollingStrip.consume_or_expel_right(mut self) -> bool {
    guard not self.columns.is_empty() else {
        return false
    }
    let ci = self.active_col.clamp(0, self.columns.len() - 1)
    if self.columns[ci].windows.len() > 1 {
        return self.expel_from_column()
    }
    guard ci + 1 < self.columns.len() else {
        return false
    }
    let slot = self.columns[ci].windows.remove(0)
    discard self.columns.remove(ci)
    // After removing `ci`, the former right neighbor now sits at index `ci`.
    self.columns[ci].windows.push(slot)
    self.columns[ci].active_row = self.columns[ci].windows.len() - 1
    self.active_col = ci
    self.manual_pan = false
    self.pinned_center = false
    return true
}

/// Toggle tabbed display for the active column (hides non-active stacked rows behind a tab bar).
pub fn ScrollingStrip.toggle_tabbed(mut self) -> bool {
    guard not self.columns.is_empty() else {
        return false
    }
    let ci = self.active_col.clamp(0, self.columns.len() - 1)
    self.columns[ci].tabbed = not self.columns[ci].tabbed
    return true
}

/// Reset all row height weights in the active column back to equal 1.0 proportions.
pub fn ScrollingStrip.reset_row_weights(mut self) -> bool {
    guard not self.columns.is_empty() else {
        return false
    }
    let ci = self.active_col.clamp(0, self.columns.len() - 1)
    return self.columns[ci].reset_weights()
}

/// Expand the active column to fill remaining visible viewport width (or 100% if alone).
pub fn ScrollingStrip.expand_to_available_width(mut self, area: core.Rect, gap: f64) -> bool {
    guard not self.columns.is_empty() else {
        return false
    }
    let ci = self.active_col.clamp(0, self.columns.len() - 1)
    if self.columns.len() == 1 {
        self.columns[ci].maximized = false
        self.columns[ci].width_frac = 1.0
        self.columns[ci].saved_width = 1.0
        self.manual_pan = false
        self.pinned_center = false
        return true
    }
    var cur_x = gap
    var other_used = 0.0
    for i, c in self.columns {
        let cw = c.effective_width(area.w, gap)
        if i != ci {
            if cur_x + cw > self.camera_x + 1.0 and cur_x < self.camera_x + area.w - 1.0 {
                other_used += cw + gap
            }
        }
        cur_x += cw + gap
    }
    let avail = area.w - other_used - gap * 2.0
    var frac = 1.0
    if other_used > 0.0 and avail >= 64.0 {
        frac = ((avail + gap) / max(area.w - gap, 1.0)).clamp(0.1, 1.0)
    }
    self.columns[ci].maximized = false
    self.columns[ci].width_frac = frac
    self.columns[ci].saved_width = frac
    self.manual_pan = false
    self.pinned_center = false
    return true
}

/// Cycle the active column's width through `presets`.
pub fn ScrollingStrip.cycle_preset_width(mut self, presets: Slice[f64]) -> bool {
    guard not self.columns.is_empty() and not presets.is_empty() else {
        return false
    }
    let ci = self.active_col
    let cur = self.columns[ci].width_frac
    self.columns[ci].maximized = false
    var next = presets[0]
    for i in 0..presets.len() {
        if (presets[i] - cur).abs() < 0.02 {
            next = presets[(i + 1) % presets.len()]
            break
        }
        if presets[i] > cur + 0.02 {
            next = presets[i]
            break
        }
    }
    self.columns[ci].width_frac = next.clamp(0.1, 1.0)
    self.columns[ci].saved_width = self.columns[ci].width_frac
    self.manual_pan = false
    self.pinned_center = false
    return true
}

pub fn ScrollingStrip.set_column_width(mut self, frac: f64) -> bool {
    guard not self.columns.is_empty() else {
        return false
    }
    let ci = self.active_col
    let w = frac.clamp(0.1, 1.0)
    self.columns[ci].maximized = false
    self.columns[ci].width_frac = w
    self.columns[ci].saved_width = w
    self.manual_pan = false
    self.pinned_center = false
    return true
}

pub fn ScrollingStrip.adjust_column_width(mut self, delta: f64) -> bool {
    guard not self.columns.is_empty() else {
        return false
    }
    let ci = self.active_col
    let w = (self.columns[ci].width_frac + delta).clamp(0.1, 1.0)
    self.columns[ci].maximized = false
    self.columns[ci].width_frac = w
    self.columns[ci].saved_width = w
    self.manual_pan = false
    self.pinned_center = false
    return true
}

/// Adjust the focused window's proportional height weight inside a multi-window column.
pub fn ScrollingStrip.adjust_row_weight(mut self, delta: f64) -> bool {
    guard not self.columns.is_empty() else {
        return false
    }
    let ci = self.active_col
    guard self.columns[ci].windows.len() > 1 else {
        return false
    }
    let ri = self.columns[ci].active_row.clamp(0, self.columns[ci].windows.len() - 1)
    let next = (self.columns[ci].windows[ri].weight + delta).clamp(0.2, 5.0)
    if (next - self.columns[ci].windows[ri].weight).abs() < 1e-6 {
        return false
    }
    self.columns[ci].windows[ri].weight = next
    return true
}

pub fn ScrollingStrip.toggle_maximize_column(mut self) -> bool {
    guard not self.columns.is_empty() else {
        return false
    }
    let ci = self.active_col
    if self.columns[ci].maximized {
        self.columns[ci].maximized = false
        self.columns[ci].width_frac = self.columns[ci].saved_width
    } else {
        self.columns[ci].saved_width = self.columns[ci].width_frac
        self.columns[ci].maximized = true
    }
    self.manual_pan = false
    self.pinned_center = false
    return true
}

/// Explicitly maximize or unmaximize the column owning `id` (for `xdg_toplevel.set_maximized`).
pub fn ScrollingStrip.set_column_maximized(mut self, id: u64, on: bool) -> bool {
    for ci in 0..self.columns.len() {
        if self.columns[ci].find(id) >= 0 {
            if self.columns[ci].maximized == on {
                return false
            }
            if on {
                self.columns[ci].saved_width = self.columns[ci].width_frac
                self.columns[ci].maximized = true
            } else {
                self.columns[ci].maximized = false
                self.columns[ci].width_frac = self.columns[ci].saved_width
            }
            self.manual_pan = false
            self.pinned_center = false
            return true
        }
    }
    return false
}

pub fn ScrollingStrip.center_column(mut self) {
    self.pinned_center = true
    self.manual_pan = false
}

/// Pan viewport horizontally by `dx` logical pixels (touchpad swipe / pointer drag).
pub fn ScrollingStrip.pan(mut self, dx: f64) {
    self.camera_x += dx
    self.manual_pan = true
    self.pinned_center = false
}

/// Finish manual panning and clamp camera smoothly to strip bounds.
pub fn ScrollingStrip.pan_end(mut self, area: core.Rect, gap: f64) {
    self.manual_pan = false
    self.pinned_center = false
    guard not self.columns.is_empty() else {
        self.camera_x = 0.0
        return
    }
    let total = self.strip_width(area.w, gap)
    let max_cam = max(total - area.w, 0.0)
    self.camera_x = self.camera_x.clamp(0.0, max_cam)
    // Focus whichever column is closest to viewport center.
    let mid = self.camera_x + area.w * 0.5
    var x = gap
    var best = self.active_col
    var best_dist = 1.0e18
    for i, c in self.columns {
        let cw = c.effective_width(area.w, gap)
        let cx = x + cw * 0.5
        let d = (cx - mid).abs()
        if d < best_dist {
            best_dist = d
            best = i
        }
        x += cw + gap
    }
    self.active_col = best
}

fn ScrollingStrip.strip_width(self, viewport_w: f64, gap: f64) -> f64 {
    if self.columns.is_empty() {
        return 0.0
    }
    var x = gap
    for c in self.columns {
        x += c.effective_width(viewport_w, gap) + gap
    }
    return x
}

/// Compute global target rects for every tiled window in the strip, updating `camera_x`.
pub fn ScrollingStrip.compute(mut self, area: core.Rect, gap: f64, center: traits.CenterMode, mut out: List[traits.TileTarget]) {
    let active_win = self.focused().unwrap_or(0)
    self.compute_for(area, gap, center, 0, 0, true, active_win, mut out)
}

/// Compute global target rects in a single pass with pre-stamped `monitor_idx`,
/// `workspace_idx`, and focus identity (avoids a post-pass over `out` in `Workspace`).
pub fn ScrollingStrip.compute_for(mut self, area: core.Rect, gap: f64, center: traits.CenterMode, monitor_idx: int, workspace_idx: int, is_active_monitor: bool, active_win: u64, mut out: List[traits.TileTarget]) {
    guard not self.columns.is_empty() else {
        self.camera_x = 0.0
        self.pinned_center = false
        return
    }
    let n = self.columns.len()
    let active = self.active_col.clamp(0, n - 1)
    self.active_col = active

    // First pass: find column widths, active column bounds, and total strip width
    // using a single reusable scratch buffer (`col_w`).
    var col_w = mem.replace(mut self.col_w_scratch, [])
    col_w.clear()
    col_w.reserve(n)
    let vw_minus_gap = area.w - gap
    let max_col_w = column.width_for_frac_pre(vw_minus_gap, gap, 1.0)
    var cur_x = gap
    var ax = gap
    var aw = max_col_w
    for ci, c in self.columns {
        let cw = if c.maximized {
            max_col_w
        } else {
            column.width_for_frac_pre(vw_minus_gap, gap, c.width_frac)
        }
        if ci == active {
            ax = cur_x
            aw = cw
        }
        col_w.push(cw)
        cur_x += cw + gap
    }
    let total_w = cur_x

    // Update viewport camera unless actively being dragged.
    if not self.manual_pan {
        let left_bound = ax - gap
        let right_bound = ax + aw + gap
        let centered = ax + aw * 0.5 - area.w * 0.5
        let always_center = self.pinned_center or center == traits.CenterMode.Always or (self.always_center_single and n == 1)
        if always_center {
            self.camera_x = centered
        } else if center == traits.CenterMode.OnOverflow {
            // Keep camera still while focused column is already inside viewport;
            // center it smoothly whenever navigating to a column that overflows the viewport.
            if left_bound < self.camera_x or right_bound > self.camera_x + area.w {
                self.camera_x = centered
            }
            if total_w <= area.w {
                self.camera_x = 0.0
            } else {
                let max_cam = total_w - area.w
                self.camera_x = self.camera_x.clamp(0.0, max_cam)
            }
        } else {
            // Minimal scroll so focused column fits cleanly in view (niri default).
            if left_bound < self.camera_x {
                self.camera_x = left_bound
            } else if right_bound > self.camera_x + area.w {
                self.camera_x = right_bound - area.w
            }
            if total_w <= area.w {
                self.camera_x = 0.0
            } else {
                let max_cam = total_w - area.w
                self.camera_x = self.camera_x.clamp(0.0, max_cam)
            }
        }
    } else {
        let max_cam = max(total_w - area.w, 0.0)
        self.camera_x = self.camera_x.clamp(-area.w * 0.25, max_cam + area.w * 0.25)
    }

    // Second pass: emit per-window targets inside each column (hoisting loop invariants
    // and taking a fast path for single-window columns).
    out.reserve(n)
    let single_wy = area.y + gap
    let single_wh = max(area.h - gap * 2.0, 32.0)
    let tab_wy = single_wy + 8.0
    let tab_wh = max(area.h - gap * 2.0 - 8.0, 32.0)
    let area_bottom_gap = area.y + area.h - gap
    let base_x = area.x - self.camera_x
    var col_x = gap
    for ci, c in self.columns {
        let ww = col_w[ci]
        let wx = base_x + col_x
        col_x += ww + gap
        let rows = c.windows.len()
        guard rows > 0 else {
            continue
        }
        let is_max = c.maximized
        if c.tabbed {
            let ri = c.active_row.clamp(0, rows - 1)
            let slot_id = c.windows[ri].id
            out.push(traits.TileTarget {
                id: slot_id,
                rect: core.Rect { x: wx, y: tab_wy, w: ww, h: tab_wh },
                focused: is_active_monitor and slot_id == active_win,
                floating: false,
                fullscreen: false,
                maximized: is_max,
                tabbed: true,
                tab_count: rows,
                tab_index: ri,
                monitor_idx,
                workspace_idx,
            })
            continue
        }
        if rows == 1 {
            let slot_id = c.windows[0].id
            out.push(traits.TileTarget {
                id: slot_id,
                rect: core.Rect { x: wx, y: single_wy, w: ww, h: single_wh },
                focused: is_active_monitor and slot_id == active_win,
                floating: false,
                fullscreen: false,
                maximized: is_max,
                monitor_idx,
                workspace_idx,
            })
            continue
        }
        let avail_h = max(area.h - gap * f64(rows + 1), f64(rows) * 32.0)
        let inv_tot_w = 1.0 / c.total_weight()
        var y = single_wy
        for ri in 0..rows {
            let slot = c.windows[ri]
            let wh = if ri == rows - 1 {
                max(area_bottom_gap - y, 32.0)
            } else {
                (avail_h * (max(slot.weight, 0.1) * inv_tot_w)).round()
            }
            out.push(traits.TileTarget {
                id: slot.id,
                rect: core.Rect { x: wx, y, w: ww, h: wh },
                focused: is_active_monitor and slot.id == active_win,
                floating: false,
                fullscreen: false,
                maximized: is_max,
                monitor_idx,
                workspace_idx,
            })
            y += wh + gap
        }
    }
    self.col_w_scratch = col_w
}
