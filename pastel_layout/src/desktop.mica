// Multi-monitor Desktop manager with O(1) window reverse index and global Z-order layering.

import std.collections.map
import std.mem
import pastel_core as core
import traits
import workspace

/// O(1) reverse lookup record for a managed window.
pub struct WindowLoc {
    pub monitor_idx: int = 0
    pub workspace_idx: int = 0
    pub floating: bool = false
}

/// Window parked when all monitors are temporarily disconnected.
struct OrphanWindow {
    id: u64
    floating: bool
    width_hint: f64
    natural_w: f64
    natural_h: f64
}

/// One physical or virtual output with its own workspace list.
pub struct Monitor {
    pub id: u64 = 0
    pub name: str = ""
    pub full_rect: core.Rect = core.Rect {}
    pub usable_rect: core.Rect = core.Rect {}
    pub workspaces: List[workspace.Workspace] = []
    pub active_ws: int = 0
    pub prev_ws: int = 0
}

/// Root multi-monitor desktop state. Pure data, no clocks or Wayland dependencies.
pub struct Desktop {
    pub monitors: List[Monitor] = []
    pub active_monitor: int = 0
    pub fixed_workspaces: int = 0
    pub gap: f64 = 12.0
    pub default_width: f64 = 0.5
    pub center_mode: traits.CenterMode = traits.CenterMode.OnOverflow
    pub always_center_single: bool = false
    pub next_ws_id: u64 = 1
    /// O(1) reverse index: window id -> location.
    pub index: map.Map[u64, WindowLoc]
    /// Windows staged while zero monitors are connected.
    orphaned: List[OrphanWindow] = []
    /// Reusable scratch lists for zero-allocation global Z-order assembly.
    float_scratch: List[traits.TileTarget] = []
    full_scratch: List[traits.TileTarget] = []
    ws_vis_scratch: List[int] = []
}

pub fn Desktop.new(fixed_workspaces: int, gap: f64, default_width: f64, center_mode: traits.CenterMode) -> Desktop {
    return Desktop {
        fixed_workspaces: max(fixed_workspaces, 0),
        gap: max(gap, 0.0),
        default_width: default_width.clamp(0.1, 1.0),
        center_mode,
        index: map.Map.new(),
    }
}

/// Update layout parameters on live config reload without losing windows.
pub fn Desktop.reconfigure(mut self, fixed_workspaces: int, gap: f64, default_width: f64, center_mode: traits.CenterMode) {
    self.fixed_workspaces = max(fixed_workspaces, 0)
    self.gap = max(gap, 0.0)
    self.default_width = default_width.clamp(0.1, 1.0)
    self.center_mode = center_mode
    for mi in 0..self.monitors.len() {
        self.normalize_workspaces(mi)
    }
    self.rebuild_index()
}

/// Toggle whether a workspace containing a single column always centers it horizontally.
pub fn Desktop.set_always_center_single(mut self, on: bool) {
    self.always_center_single = on
    for mi in 0..self.monitors.len() {
        for wi in 0..self.monitors[mi].workspaces.len() {
            self.monitors[mi].workspaces[wi].strip.always_center_single = on
        }
    }
}

fn Desktop.alloc_ws(mut self) -> workspace.Workspace {
    let id = self.next_ws_id
    self.next_ws_id += 1
    var ws = workspace.Workspace.new(id)
    ws.strip.always_center_single = self.always_center_single
    return ws
}

fn clamp_floating_to_area(r: core.Rect, u: core.Rect) -> core.Rect {
    let w = min(max(r.w, 64.0), max(u.w * 0.95, 64.0))
    let h = min(max(r.h, 64.0), max(u.h * 0.95, 64.0))
    return core.Rect.new(u.x + (u.w - w) * 0.5, u.y + (u.h - h) * 0.5, w, h)
}

fn Desktop.normalize_workspaces(mut self, mi: int) {
    guard mi >= 0 and mi < self.monitors.len() else {
        return
    }
    if self.fixed_workspaces > 0 {
        while self.monitors[mi].workspaces.len() < self.fixed_workspaces {
            let ws = self.alloc_ws()
            self.monitors[mi].workspaces.push(ws)
        }
        // If fixed_workspaces decreased on reload, migrate excess windows into the last kept workspace.
        let keep = self.fixed_workspaces
        let dst_wi = keep - 1
        while self.monitors[mi].workspaces.len() > keep {
            let extra = self.monitors[mi].workspaces.pop().unwrap()
            for c in extra.strip.columns {
                self.monitors[mi].workspaces[dst_wi].insert_column(c.clone())
            }
            for f in extra.floating {
                self.monitors[mi].workspaces[dst_wi].insert_floating(f.id, f.rect)
            }
        }
        self.monitors[mi].active_ws = self.monitors[mi].active_ws.clamp(0, self.monitors[mi].workspaces.len() - 1)
        self.monitors[mi].prev_ws = self.monitors[mi].prev_ws.clamp(0, self.monitors[mi].workspaces.len() - 1)
        return
    }
    // Dynamic niri-style mode: keep active workspace and non-empty workspaces, plus 1 trailing empty spare.
    if self.monitors[mi].workspaces.is_empty() {
        let ws = self.alloc_ws()
        self.monitors[mi].workspaces.push(ws)
        self.monitors[mi].active_ws = 0
        self.monitors[mi].prev_ws = 0
        return
    }
    var i = 0
    while i < self.monitors[mi].workspaces.len() - 1 {
        if i != self.monitors[mi].active_ws and self.monitors[mi].workspaces[i].is_empty() {
            discard self.monitors[mi].workspaces.remove(i)
            if i < self.monitors[mi].active_ws {
                self.monitors[mi].active_ws -= 1
            }
            if i < self.monitors[mi].prev_ws {
                self.monitors[mi].prev_ws -= 1
            }
        } else {
            i += 1
        }
    }
    let last = self.monitors[mi].workspaces.len() - 1
    if not self.monitors[mi].workspaces[last].is_empty() {
        let ws = self.alloc_ws()
        self.monitors[mi].workspaces.push(ws)
    }
    self.monitors[mi].active_ws = self.monitors[mi].active_ws.clamp(0, self.monitors[mi].workspaces.len() - 1)
    self.monitors[mi].prev_ws = self.monitors[mi].prev_ws.clamp(0, self.monitors[mi].workspaces.len() - 1)
}

fn Desktop.rebuild_index(mut self) {
    var idx = mem.replace(mut self.index, map.Map.new())
    idx.clear()
    for mi in 0..self.monitors.len() {
        for wi in 0..self.monitors[mi].workspaces.len() {
            for ci in 0..self.monitors[mi].workspaces[wi].strip.columns.len() {
                for ri in 0..self.monitors[mi].workspaces[wi].strip.columns[ci].windows.len() {
                    let id = self.monitors[mi].workspaces[wi].strip.columns[ci].windows[ri].id
                    discard idx.insert(id, WindowLoc { monitor_idx: mi, workspace_idx: wi, floating: false })
                }
            }
            for fi in 0..self.monitors[mi].workspaces[wi].floating.len() {
                let id = self.monitors[mi].workspaces[wi].floating[fi].id
                discard idx.insert(id, WindowLoc { monitor_idx: mi, workspace_idx: wi, floating: true })
            }
        }
    }
    self.index = idx
}

pub fn Desktop.find_monitor(self, id: u64) -> int {
    for i, m in self.monitors {
        if m.id == id {
            return i
        }
    }
    return -1
}

/// Find the monitor whose `full_rect` contains `(x, y)` (or `-1` if none).
pub fn Desktop.monitor_at(self, x: f64, y: f64) -> int {
    for i, m in self.monitors {
        if m.full_rect.contains(x, y) {
            return i
        }
    }
    return -1
}

/// Focus the monitor containing `(x, y)` if different from `active_monitor`.
pub fn Desktop.focus_monitor_at(mut self, x: f64, y: f64) -> bool {
    let mi = self.monitor_at(x, y)
    guard mi >= 0 and mi != self.active_monitor else {
        return false
    }
    self.active_monitor = mi
    return true
}

/// Register or update a monitor, restoring any orphaned windows if this is the first monitor.
pub fn Desktop.add_monitor(mut self, id: u64, name: str, full_rect: core.Rect, usable_rect: core.Rect) {
    let existing = self.find_monitor(id)
    if existing >= 0 {
        self.monitors[existing].name = name.clone()
        self.monitors[existing].full_rect = full_rect
        self.monitors[existing].usable_rect = usable_rect
        return
    }
    var m = Monitor { id, name: name.clone(), full_rect, usable_rect }
    let count = if self.fixed_workspaces > 0 { self.fixed_workspaces } else { 1 }
    for _ in 0..count {
        m.workspaces.push(self.alloc_ws())
    }
    self.monitors.push(m)
    if self.monitors.len() == 1 {
        self.active_monitor = 0
        if not self.orphaned.is_empty() {
            let staged = mem.replace(mut self.orphaned, [])
            for ow in staged {
                self.add_window(ow.id, ow.floating, ow.width_hint, ow.natural_w, ow.natural_h, None)
            }
        }
    }
}

/// Remove a monitor, migrating open windows (preserving column stacks & clamping floating rects)
/// onto a surviving monitor, or parking them safely if the last monitor disconnected.
pub fn Desktop.remove_monitor(mut self, id: u64) {
    let mi = self.find_monitor(id)
    guard mi >= 0 else {
        return
    }
    let gone = self.monitors.remove(mi)
    if not self.monitors.is_empty() {
        if mi < self.active_monitor {
            self.active_monitor -= 1
        }
        self.active_monitor = self.active_monitor.clamp(0, self.monitors.len() - 1)
        let dst_m = self.active_monitor
        let dst_w = self.monitors[dst_m].active_ws
        let dst_u = self.monitors[dst_m].usable_rect
        for ws in gone.workspaces {
            for c in ws.strip.columns {
                self.monitors[dst_m].workspaces[dst_w].insert_column(c.clone())
            }
            for f in ws.floating {
                let clamped = clamp_floating_to_area(f.rect, dst_u)
                self.monitors[dst_m].workspaces[dst_w].insert_floating(f.id, clamped)
            }
        }
        self.normalize_workspaces(dst_m)
    } else {
        self.active_monitor = 0
        for ws in gone.workspaces {
            for c in ws.strip.columns {
                let wf = if c.maximized { c.saved_width } else { c.width_frac }
                for slot in c.windows {
                    self.orphaned.push(OrphanWindow { id: slot.id, floating: false, width_hint: wf, natural_w: 0.0, natural_h: 0.0 })
                }
            }
            for f in ws.floating {
                self.orphaned.push(OrphanWindow { id: f.id, floating: true, width_hint: self.default_width, natural_w: f.rect.w, natural_h: f.rect.h })
            }
        }
    }
    self.rebuild_index()
}

pub fn Desktop.focused_window(self) -> Option[u64] {
    guard not self.monitors.is_empty() else {
        return None
    }
    let mi = self.active_monitor
    let wi = self.monitors[mi].active_ws
    guard wi < self.monitors[mi].workspaces.len() else {
        return None
    }
    return self.monitors[mi].workspaces[wi].focused()
}

pub fn Desktop.locate(self, id: u64) -> Option[WindowLoc] {
    return self.index.get(id)
}

pub fn Desktop.find_monitor_by_name(self, name: str) -> int {
    guard not name.is_empty() else {
        return -1
    }
    for i, m in self.monitors {
        if m.name == name {
            return i
        }
    }
    return -1
}

/// Insert a new window onto the active monitor (or target 1-based workspace if specified).
pub fn Desktop.add_window(mut self, id: u64, floating: bool, width_hint: f64, natural_w: f64, natural_h: f64, target_ws: Option[int]) {
    self.add_window_on(id, floating, width_hint, natural_w, natural_h, "", target_ws)
}

/// Insert a new window onto `target_monitor` (by output name, empty = active monitor) and optional 1-based workspace.
pub fn Desktop.add_window_on(mut self, id: u64, floating: bool, width_hint: f64, natural_w: f64, natural_h: f64, target_monitor: str, target_ws: Option[int]) {
    self.add_window_full(id, floating, width_hint, natural_w, natural_h, target_monitor, target_ws, true)
}

/// Insert a new window with full control over target monitor, workspace, and whether it steals focus.
pub fn Desktop.add_window_full(mut self, id: u64, floating: bool, width_hint: f64, natural_w: f64, natural_h: f64, target_monitor: str, target_ws: Option[int], open_focused: bool) {
    guard not self.monitors.is_empty() else {
        self.orphaned.push(OrphanWindow { id, floating, width_hint, natural_w, natural_h })
        return
    }
    let named_mi = self.find_monitor_by_name(target_monitor)
    let mi = if named_mi >= 0 { named_mi } else { self.active_monitor }
    var wi = self.monitors[mi].active_ws
    if let Some(ws1) = target_ws {
        let want = max(ws1 - 1, 0)
        if self.fixed_workspaces > 0 {
            wi = want.clamp(0, self.monitors[mi].workspaces.len() - 1)
        } else {
            while self.monitors[mi].workspaces.len() <= want {
                let ws = self.alloc_ws()
                self.monitors[mi].workspaces.push(ws)
            }
            wi = want
        }
    }
    let u = self.monitors[mi].usable_rect
    if floating {
        let w = if natural_w > 32.0 { min(natural_w, u.w * 0.9) } else { min(u.w * 0.5, 800.0) }
        let h = if natural_h > 32.0 { min(natural_h, u.h * 0.9) } else { min(u.h * 0.6, 600.0) }
        let r = core.Rect.new(u.x + (u.w - w) * 0.5, u.y + (u.h - h) * 0.5, w, h)
        if open_focused {
            self.monitors[mi].workspaces[wi].insert_floating(id, r)
        } else {
            self.monitors[mi].workspaces[wi].insert_floating_unfocused(id, r)
        }
    } else {
        let wf = if width_hint > 0.0 { width_hint } else { self.default_width }
        if open_focused {
            self.monitors[mi].workspaces[wi].insert_tiled(id, wf)
        } else {
            self.monitors[mi].workspaces[wi].insert_tiled_unfocused(id, wf)
        }
    }
    discard self.index.insert(id, WindowLoc { monitor_idx: mi, workspace_idx: wi, floating })
    self.normalize_workspaces(mi)
    self.rebuild_index()
}

/// Move the focused floating window by `(dx, dy)` logical pixels.
pub fn Desktop.move_focused_floating(mut self, dx: f64, dy: f64) -> bool {
    guard let Some(id) = self.focused_window() else {
        return false
    }
    guard let Some(loc) = self.index.get(id) else {
        return false
    }
    guard loc.floating else {
        return false
    }
    return self.monitors[loc.monitor_idx].workspaces[loc.workspace_idx].move_floating(id, dx, dy)
}

/// Resize the focused floating window by `(dw, dh)` logical pixels.
pub fn Desktop.resize_focused_floating(mut self, dw: f64, dh: f64) -> bool {
    guard let Some(id) = self.focused_window() else {
        return false
    }
    guard let Some(loc) = self.index.get(id) else {
        return false
    }
    guard loc.floating else {
        return false
    }
    let fi = self.monitors[loc.monitor_idx].workspaces[loc.workspace_idx].find_floating(id)
    guard fi >= 0 else {
        return false
    }
    let cur = self.monitors[loc.monitor_idx].workspaces[loc.workspace_idx].floating[fi].rect
    return self.monitors[loc.monitor_idx].workspaces[loc.workspace_idx].resize_floating(id, 0.0, 0.0, cur.w + dw, cur.h + dh)
}

/// Apply structural window rules to an already-mapped window (for late-arriving `app_id`/`title`).
pub fn Desktop.apply_late_rule(mut self, id: u64, floating: Option[bool], fullscreen: Option[bool], maximized: Option[bool], width_hint: f64, target_monitor: str, target_ws: Option[int]) -> bool {
    var changed = false
    if not target_monitor.is_empty() {
        let dst_m = self.find_monitor_by_name(target_monitor)
        if dst_m >= 0 {
            if self.move_window_to_monitor(id, self.monitors[dst_m].id) {
                changed = true
            }
        }
    }
    if let Some(want_float) = floating {
        if let Some(loc) = self.index.get(id) {
            if loc.floating != want_float {
                if self.toggle_floating(id) {
                    changed = true
                }
            }
        }
    }
    if let Some(ws1) = target_ws {
        if let Some(loc) = self.index.get(id) {
            let mi = loc.monitor_idx
            let from_ws = loc.workspace_idx
            let want = max(ws1 - 1, 0)
            var to_ws = want
            if self.fixed_workspaces > 0 {
                to_ws = want.clamp(0, self.monitors[mi].workspaces.len() - 1)
            } else {
                while self.monitors[mi].workspaces.len() <= to_ws {
                    let ws = self.alloc_ws()
                    self.monitors[mi].workspaces.push(ws)
                }
            }
            if to_ws != from_ws {
                if loc.floating {
                    let fi = self.monitors[mi].workspaces[from_ws].find_floating(id)
                    let rect = if fi >= 0 { self.monitors[mi].workspaces[from_ws].floating[fi].rect } else { self.monitors[mi].usable_rect }
                    discard self.monitors[mi].workspaces[from_ws].remove(id)
                    self.monitors[mi].workspaces[to_ws].insert_floating(id, rect)
                } else {
                    let wf = if width_hint > 0.0 { width_hint } else { self.monitors[mi].workspaces[from_ws].column_width_for(id).unwrap_or(self.default_width) }
                    discard self.monitors[mi].workspaces[from_ws].remove(id)
                    self.monitors[mi].workspaces[to_ws].insert_tiled(id, wf)
                }
                self.normalize_workspaces(mi)
                self.rebuild_index()
                changed = true
            }
        }
    }
    if let Some(want_max) = maximized {
        if self.set_maximized(id, want_max) {
            changed = true
        }
    }
    if let Some(want_fs) = fullscreen {
        if self.set_fullscreen(id, want_fs) {
            changed = true
        }
    }
    return changed
}

pub fn Desktop.remove_window(mut self, id: u64) -> bool {
    for i in 0..self.orphaned.len() {
        if self.orphaned[i].id == id {
            discard self.orphaned.remove(i)
            return true
        }
    }
    guard let Some(loc) = self.index.remove(id) else {
        return false
    }
    guard loc.monitor_idx < self.monitors.len() and loc.workspace_idx < self.monitors[loc.monitor_idx].workspaces.len() else {
        return false
    }
    let ok = self.monitors[loc.monitor_idx].workspaces[loc.workspace_idx].remove(id)
    self.normalize_workspaces(loc.monitor_idx)
    self.rebuild_index()
    return ok
}

pub fn Desktop.focus_window(mut self, id: u64) -> bool {
    guard let Some(loc) = self.index.get(id) else {
        return false
    }
    let prev_mi = self.active_monitor
    let prev_ws = if prev_mi < self.monitors.len() { self.monitors[prev_mi].active_ws } else { -1 }
    self.active_monitor = loc.monitor_idx
    if self.monitors[loc.monitor_idx].active_ws != loc.workspace_idx {
        self.monitors[loc.monitor_idx].prev_ws = self.monitors[loc.monitor_idx].active_ws
        self.monitors[loc.monitor_idx].active_ws = loc.workspace_idx
    }
    let ok = self.monitors[loc.monitor_idx].workspaces[loc.workspace_idx].focus_window(id)
    if self.fixed_workspaces == 0 and (prev_mi != loc.monitor_idx or prev_ws != loc.workspace_idx) {
        if prev_mi >= 0 and prev_mi < self.monitors.len() {
            self.normalize_workspaces(prev_mi)
        }
        if loc.monitor_idx != prev_mi {
            self.normalize_workspaces(loc.monitor_idx)
        }
        self.rebuild_index()
    }
    return ok
}

/// Transfer a floating window to the monitor containing its center after an interactive drag.
pub fn Desktop.relocate_floating_to_monitor(mut self, id: u64, target_mi: int) -> bool {
    guard let Some(loc) = self.index.get(id) else {
        return false
    }
    guard loc.floating and target_mi >= 0 and target_mi < self.monitors.len() and target_mi != loc.monitor_idx else {
        return false
    }
    let src_m = loc.monitor_idx
    let src_w = loc.workspace_idx
    let fi = self.monitors[src_m].workspaces[src_w].find_floating(id)
    guard fi >= 0 else {
        return false
    }
    let rect = self.monitors[src_m].workspaces[src_w].floating[fi].rect
    discard self.monitors[src_m].workspaces[src_w].remove(id)
    let dst_w = self.monitors[target_mi].active_ws
    self.monitors[target_mi].workspaces[dst_w].insert_floating(id, rect)
    self.active_monitor = target_mi
    self.normalize_workspaces(src_m)
    self.normalize_workspaces(target_mi)
    self.rebuild_index()
    return true
}

pub fn Desktop.toggle_floating(mut self, id: u64) -> bool {
    guard let Some(loc) = self.index.get(id) else {
        return false
    }
    let mi = loc.monitor_idx
    let wi = loc.workspace_idx
    let u = self.monitors[mi].usable_rect
    if loc.floating {
        discard self.monitors[mi].workspaces[wi].remove(id)
        self.monitors[mi].workspaces[wi].insert_tiled(id, self.default_width)
    } else {
        discard self.monitors[mi].workspaces[wi].remove(id)
        let w = min(u.w * 0.55, 900.0)
        let h = min(u.h * 0.65, 650.0)
        let r = core.Rect.new(u.x + (u.w - w) * 0.5, u.y + (u.h - h) * 0.5, w, h)
        self.monitors[mi].workspaces[wi].insert_floating(id, r)
    }
    self.rebuild_index()
    return true
}

pub fn Desktop.set_maximized(mut self, id: u64, on: bool) -> bool {
    guard let Some(loc) = self.index.get(id) else {
        return false
    }
    guard not loc.floating else {
        return false
    }
    return self.monitors[loc.monitor_idx].workspaces[loc.workspace_idx].set_column_maximized(id, on)
}

pub fn Desktop.toggle_fullscreen(mut self, id: u64) -> bool {
    guard let Some(loc) = self.index.get(id) else {
        return false
    }
    let mi = loc.monitor_idx
    let wi = loc.workspace_idx
    if self.monitors[mi].workspaces[wi].fullscreen == Some(id) {
        self.monitors[mi].workspaces[wi].fullscreen = None
    } else {
        self.monitors[mi].workspaces[wi].fullscreen = Some(id)
    }
    return true
}

pub fn Desktop.set_fullscreen(mut self, id: u64, on: bool) -> bool {
    guard let Some(loc) = self.index.get(id) else {
        return false
    }
    let mi = loc.monitor_idx
    let wi = loc.workspace_idx
    if on {
        self.monitors[mi].workspaces[wi].fullscreen = Some(id)
    } else if self.monitors[mi].workspaces[wi].fullscreen == Some(id) {
        self.monitors[mi].workspaces[wi].fullscreen = None
    }
    return true
}

/// Move window `id` onto monitor `target_monitor_id` (used for `RequestFullscreen` with target output).
pub fn Desktop.move_window_to_monitor(mut self, id: u64, target_monitor_id: u64) -> bool {
    let dst_m = self.find_monitor(target_monitor_id)
    guard dst_m >= 0 else {
        return false
    }
    guard let Some(loc) = self.index.get(id) else {
        return false
    }
    guard loc.monitor_idx != dst_m else {
        return false
    }
    let src_m = loc.monitor_idx
    let src_w = loc.workspace_idx
    let dst_w = self.monitors[dst_m].active_ws
    let u = self.monitors[dst_m].usable_rect
    let saved_w = self.monitors[src_m].workspaces[src_w].column_width_for(id).unwrap_or(self.default_width)
    discard self.monitors[src_m].workspaces[src_w].remove(id)
    if loc.floating {
        let w = min(u.w * 0.55, 900.0)
        let h = min(u.h * 0.65, 650.0)
        self.monitors[dst_m].workspaces[dst_w].insert_floating(id, core.Rect.new(u.x + (u.w - w) * 0.5, u.y + (u.h - h) * 0.5, w, h))
    } else {
        self.monitors[dst_m].workspaces[dst_w].insert_tiled(id, saved_w)
    }
    self.active_monitor = dst_m
    self.normalize_workspaces(src_m)
    self.normalize_workspaces(dst_m)
    self.rebuild_index()
    return true
}

/// Switch active workspace on the active monitor to 1-based index `ws1`.
pub fn Desktop.focus_workspace(mut self, ws1: int) -> bool {
    guard not self.monitors.is_empty() and ws1 >= 1 else {
        return false
    }
    let mi = self.active_monitor
    let target = ws1 - 1
    if self.fixed_workspaces > 0 {
        let clamped = target.clamp(0, self.monitors[mi].workspaces.len() - 1)
        if clamped == self.monitors[mi].active_ws {
            return false
        }
        self.monitors[mi].prev_ws = self.monitors[mi].active_ws
        self.monitors[mi].active_ws = clamped
        return true
    }
    let max_idx = self.monitors[mi].workspaces.len() - 1
    let clamped = target.clamp(0, max_idx)
    if clamped == self.monitors[mi].active_ws {
        return false
    }
    self.monitors[mi].prev_ws = self.monitors[mi].active_ws
    self.monitors[mi].active_ws = clamped
    self.normalize_workspaces(mi)
    self.rebuild_index()
    return true
}

/// Switch back to the previously visited workspace on the active monitor.
pub fn Desktop.focus_workspace_previous(mut self) -> bool {
    guard not self.monitors.is_empty() else {
        return false
    }
    let mi = self.active_monitor
    let prev = self.monitors[mi].prev_ws.clamp(0, self.monitors[mi].workspaces.len() - 1)
    guard prev != self.monitors[mi].active_ws else {
        return false
    }
    return self.focus_workspace(prev + 1)
}

/// Switch workspace relatively (`delta`: -1 up/prev, +1 down/next).
pub fn Desktop.focus_workspace_rel(mut self, delta: int) -> bool {
    guard not self.monitors.is_empty() else {
        return false
    }
    let cur = self.monitors[self.active_monitor].active_ws
    return self.focus_workspace(cur + delta + 1)
}

/// Move the focused window to 1-based workspace `ws1` on the active monitor (preserving column width).
pub fn Desktop.move_focused_to_workspace(mut self, ws1: int) -> bool {
    return self.move_focused_to_workspace_opt(ws1, true)
}

/// Move the focused window to 1-based workspace `ws1` without switching the active workspace.
pub fn Desktop.move_focused_to_workspace_silent(mut self, ws1: int) -> bool {
    return self.move_focused_to_workspace_opt(ws1, false)
}

fn Desktop.move_focused_to_workspace_opt(mut self, ws1: int, follow: bool) -> bool {
    guard let Some(id) = self.focused_window() else {
        return false
    }
    guard let Some(loc) = self.index.get(id) else {
        return false
    }
    let mi = loc.monitor_idx
    let from_ws = loc.workspace_idx
    let want = max(ws1 - 1, 0)
    var to_ws = want
    if self.fixed_workspaces > 0 {
        to_ws = want.clamp(0, self.monitors[mi].workspaces.len() - 1)
    } else {
        while self.monitors[mi].workspaces.len() <= to_ws {
            let ws = self.alloc_ws()
            self.monitors[mi].workspaces.push(ws)
        }
    }
    guard to_ws != from_ws else {
        return false
    }
    if loc.floating {
        let fi = self.monitors[mi].workspaces[from_ws].find_floating(id)
        let rect = if fi >= 0 { self.monitors[mi].workspaces[from_ws].floating[fi].rect } else { self.monitors[mi].usable_rect }
        discard self.monitors[mi].workspaces[from_ws].remove(id)
        self.monitors[mi].workspaces[to_ws].insert_floating(id, rect)
    } else {
        let saved_w = self.monitors[mi].workspaces[from_ws].column_width_for(id).unwrap_or(self.default_width)
        discard self.monitors[mi].workspaces[from_ws].remove(id)
        self.monitors[mi].workspaces[to_ws].insert_tiled(id, saved_w)
    }
    if follow {
        self.monitors[mi].prev_ws = from_ws
        self.monitors[mi].active_ws = to_ws
    }
    self.normalize_workspaces(mi)
    self.rebuild_index()
    return true
}

pub fn Desktop.move_focused_to_workspace_rel(mut self, delta: int) -> bool {
    guard not self.monitors.is_empty() else {
        return false
    }
    let cur = self.monitors[self.active_monitor].active_ws
    let next = max(cur + delta, 0)
    return self.move_focused_to_workspace(next + 1)
}

/// Move the entire active column (preserving vertical stack, weights, width, and tabbed state)
/// to 1-based workspace `ws1`. Falls back to moving the focused floating window if floating.
pub fn Desktop.move_column_to_workspace(mut self, ws1: int) -> bool {
    guard let Some(id) = self.focused_window() else {
        return false
    }
    guard let Some(loc) = self.index.get(id) else {
        return false
    }
    if loc.floating {
        return self.move_focused_to_workspace(ws1)
    }
    let mi = loc.monitor_idx
    let from_ws = loc.workspace_idx
    let want = max(ws1 - 1, 0)
    var to_ws = want
    if self.fixed_workspaces > 0 {
        to_ws = want.clamp(0, self.monitors[mi].workspaces.len() - 1)
    } else {
        while self.monitors[mi].workspaces.len() <= to_ws {
            let ws = self.alloc_ws()
            self.monitors[mi].workspaces.push(ws)
        }
    }
    guard to_ws != from_ws else {
        return false
    }
    guard let Some(col) = self.monitors[mi].workspaces[from_ws].strip.take_active_column() else {
        return false
    }
    if let Some(fs_id) = self.monitors[mi].workspaces[from_ws].fullscreen {
        if col.find(fs_id) >= 0 {
            self.monitors[mi].workspaces[from_ws].fullscreen = None
        }
    }
    if self.monitors[mi].workspaces[from_ws].strip.is_empty() and not self.monitors[mi].workspaces[from_ws].floating.is_empty() {
        self.monitors[mi].workspaces[from_ws].focus_floating = true
    }
    self.monitors[mi].workspaces[to_ws].insert_column(col)
    self.monitors[mi].prev_ws = from_ws
    self.monitors[mi].active_ws = to_ws
    self.normalize_workspaces(mi)
    self.rebuild_index()
    return true
}

pub fn Desktop.move_column_to_workspace_rel(mut self, delta: int) -> bool {
    guard not self.monitors.is_empty() else {
        return false
    }
    let cur = self.monitors[self.active_monitor].active_ws
    let next = max(cur + delta, 0)
    return self.move_column_to_workspace(next + 1)
}

/// Focus adjacent monitor in 2D (`dx`: -1 left / +1 right, `dy`: -1 up / +1 down).
pub fn Desktop.focus_monitor_2d(mut self, dx: int, dy: int) -> bool {
    guard self.monitors.len() > 1 and (dx != 0 or dy != 0) else {
        return false
    }
    let cur = self.monitors[self.active_monitor].full_rect.center()
    var best = -1
    var best_score = 1.0e18
    for i, m in self.monitors {
        if i == self.active_monitor {
            continue
        }
        let c = m.full_rect.center()
        let off_x = c.x - cur.x
        let off_y = c.y - cur.y
        if dx != 0 {
            if (dx < 0 and off_x < -1.0) or (dx > 0 and off_x > 1.0) {
                let score = off_x.abs() + off_y.abs() * 2.0
                if score < best_score {
                    best_score = score
                    best = i
                }
            }
        } else if (dy < 0 and off_y < -1.0) or (dy > 0 and off_y > 1.0) {
            let score = off_y.abs() + off_x.abs() * 2.0
            if score < best_score {
                best_score = score
                best = i
            }
        }
    }
    guard best >= 0 else {
        return false
    }
    self.active_monitor = best
    return true
}

/// Move focused window to adjacent monitor in 2D (preserving column width).
pub fn Desktop.move_focused_to_monitor_2d(mut self, dx: int, dy: int) -> bool {
    guard let Some(id) = self.focused_window() else {
        return false
    }
    guard let Some(loc) = self.index.get(id) else {
        return false
    }
    let src_m = loc.monitor_idx
    guard self.focus_monitor_2d(dx, dy) else {
        return false
    }
    let dst_m = self.active_monitor
    let src_w = loc.workspace_idx
    let dst_w = self.monitors[dst_m].active_ws
    let u = self.monitors[dst_m].usable_rect
    let saved_w = self.monitors[src_m].workspaces[src_w].column_width_for(id).unwrap_or(self.default_width)
    discard self.monitors[src_m].workspaces[src_w].remove(id)
    if loc.floating {
        let w = min(u.w * 0.55, 900.0)
        let h = min(u.h * 0.65, 650.0)
        self.monitors[dst_m].workspaces[dst_w].insert_floating(id, core.Rect.new(u.x + (u.w - w) * 0.5, u.y + (u.h - h) * 0.5, w, h))
    } else {
        self.monitors[dst_m].workspaces[dst_w].insert_tiled(id, saved_w)
    }
    self.normalize_workspaces(src_m)
    self.normalize_workspaces(dst_m)
    self.rebuild_index()
    return true
}

/// Move the entire active column (or focused floating window) to adjacent monitor in 2D.
pub fn Desktop.move_column_to_monitor_2d(mut self, dx: int, dy: int) -> bool {
    guard let Some(id) = self.focused_window() else {
        return false
    }
    guard let Some(loc) = self.index.get(id) else {
        return false
    }
    if loc.floating {
        return self.move_focused_to_monitor_2d(dx, dy)
    }
    let src_m = loc.monitor_idx
    let src_w = loc.workspace_idx
    guard self.focus_monitor_2d(dx, dy) else {
        return false
    }
    let dst_m = self.active_monitor
    let dst_w = self.monitors[dst_m].active_ws
    guard let Some(col) = self.monitors[src_m].workspaces[src_w].strip.take_active_column() else {
        return false
    }
    if let Some(fs_id) = self.monitors[src_m].workspaces[src_w].fullscreen {
        if col.find(fs_id) >= 0 {
            self.monitors[src_m].workspaces[src_w].fullscreen = None
        }
    }
    if self.monitors[src_m].workspaces[src_w].strip.is_empty() and not self.monitors[src_m].workspaces[src_w].floating.is_empty() {
        self.monitors[src_m].workspaces[src_w].focus_floating = true
    }
    self.monitors[dst_m].workspaces[dst_w].insert_column(col)
    self.normalize_workspaces(src_m)
    self.normalize_workspaces(dst_m)
    self.rebuild_index()
    return true
}

/// Compute active workspace window targets across all monitors in strict global Z-order:
/// all tiled windows -> all floating windows -> all fullscreen windows.
pub fn Desktop.compute_all(mut self, mut out: List[traits.TileTarget]) {
    out.clear()
    var floats = mem.replace(mut self.float_scratch, [])
    var fulls = mem.replace(mut self.full_scratch, [])
    floats.clear()
    fulls.clear()
    for mi in 0..self.monitors.len() {
        let wi = self.monitors[mi].active_ws
        guard wi < self.monitors[mi].workspaces.len() else {
            continue
        }
        let full = self.monitors[mi].full_rect
        let usable = self.monitors[mi].usable_rect
        let is_active = mi == self.active_monitor
        self.monitors[mi].workspaces[wi].compute_layers(mi, wi, is_active, full, usable, self.gap, self.center_mode, mut out, mut floats, mut fulls)
    }
    for f in floats {
        out.push(f)
    }
    for fs in fulls {
        out.push(fs)
    }
    self.float_scratch = floats
    self.full_scratch = fulls
}

/// Compute scaled workspace bands and window thumbnail targets across all monitors for Overview mode.
pub fn Desktop.compute_overview(mut self, mut out: List[traits.TileTarget], mut out_bands: List[traits.OverviewBand]) {
    out.clear()
    out_bands.clear()
    var floats = mem.replace(mut self.float_scratch, [])
    var fulls = mem.replace(mut self.full_scratch, [])
    var vis = mem.replace(mut self.ws_vis_scratch, [])
    floats.clear()
    fulls.clear()
    for mi in 0..self.monitors.len() {
        vis.clear()
        let aw = self.monitors[mi].active_ws
        let nws = self.monitors[mi].workspaces.len()
        for wi in 0..nws {
            let show_trailing_spare = self.fixed_workspaces == 0 and wi == nws - 1
            if wi == aw or not self.monitors[mi].workspaces[wi].is_empty() or show_trailing_spare {
                vis.push(wi)
            }
        }
        if vis.is_empty() and nws > 0 {
            vis.push(aw.clamp(0, nws - 1))
        }
        let count = vis.len()
        guard count > 0 else {
            continue
        }
        let full = self.monitors[mi].full_rect
        let u = self.monitors[mi].usable_rect
        let pad = max(self.gap * 1.5, 16.0)
        let avail_h = max(u.h - pad * f64(count + 1), 64.0)
        let band_h_max = avail_h / f64(count)
        let scale_h = band_h_max / max(full.h, 1.0)
        let scale_w = max(u.w - pad * 2.0, 64.0) * 0.72 / max(full.w, 1.0)
        let sc = min(min(scale_h, scale_w), 0.55).clamp(0.08, 0.55)
        let band_w = (full.w * sc).round()
        let band_h = (full.h * sc).round()
        let total_stack_h = f64(count) * band_h + f64(count - 1) * pad
        var by = (u.y + (u.h - total_stack_h) * 0.5).round()
        let bx = (u.x + (u.w - band_w) * 0.5).round()
        let is_active_mon = mi == self.active_monitor
        for vi in 0..count {
            let wi = vis[vi]
            let band_rect = core.Rect.new(bx, by, band_w, band_h)
            out_bands.push(traits.OverviewBand {
                monitor_idx: mi,
                workspace_idx: wi,
                rect: band_rect,
                scale: sc,
                active: wi == aw,
            })
            self.monitors[mi].workspaces[wi].compute_overview_band(
                mi,
                wi,
                wi == aw,
                is_active_mon,
                full,
                u,
                band_rect,
                sc,
                self.gap,
                self.center_mode,
                mut out,
                mut floats,
                mut fulls,
            )
            by += band_h + pad
        }
    }
    for f in floats {
        out.push(f)
    }
    for fs in fulls {
        out.push(fs)
    }
    self.float_scratch = floats
    self.full_scratch = fulls
    self.ws_vis_scratch = vis
}
