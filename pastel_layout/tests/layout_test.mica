import pastel_core as core
import pastel_layout as lay

test "scrolling strip columns, consume/expel, presets, and viewport camera" {
    var strip = lay.ScrollingStrip.new()
    let area = core.Rect.new(0.0, 0.0, 1000.0, 600.0)
    let gap = 10.0
    strip.insert(1, 0.5)
    strip.insert(2, 0.5)
    strip.insert(3, 0.5)
    assert_eq(strip.columns.len(), 3)
    assert_eq(strip.focused(), Some(u64(3)))

    var out: List[lay.TileTarget] = []
    strip.compute(area, gap, lay.CenterMode.OnOverflow, mut out)
    assert_eq(out.len(), 3)
    // Column 3 should be scrolled cleanly into view!
    assert(out[2].rect.x >= 0.0 and out[2].rect.right() <= 1000.0)
    assert(out[2].focused)

    // Consume window 3 into column 2 (vertical stack)
    assert(strip.consume_into_column())
    assert_eq(strip.columns.len(), 2)
    assert_eq(strip.columns[1].windows.len(), 2)

    // Expel back into its own column
    assert(strip.expel_from_column())
    assert_eq(strip.columns.len(), 3)

    // Cycle preset widths
    let presets: List[f64] = [0.33, 0.5, 0.67]
    assert(strip.cycle_preset_width(presets))
    assert((strip.columns[strip.active_col].width_frac - 0.67).abs() < 0.01)

    // Toggle maximize remembers previous width
    assert(strip.toggle_maximize_column())
    assert(strip.columns[strip.active_col].maximized)
    assert(strip.toggle_maximize_column())
    assert(not strip.columns[strip.active_col].maximized)
    assert((strip.columns[strip.active_col].width_frac - 0.67).abs() < 0.01)
}

test "dynamic vs fixed workspaces and O(1) window relocation" {
    var d = lay.Desktop.new(0, 12.0, 0.5, lay.CenterMode.OnOverflow)
    let r = core.Rect.new(0.0, 0.0, 1920.0, 1080.0)
    d.add_monitor(1, "DP-1", r, r)
    assert_eq(d.monitors[0].workspaces.len(), 1)

    // Adding a window creates a spare empty workspace at the bottom (dynamic niri-style).
    d.add_window(10, false, 0.5, 800.0, 600.0, None)
    assert_eq(d.monitors[0].workspaces.len(), 2)
    assert_eq(d.focused_window(), Some(u64(10)))

    // Move window to workspace 2: workspace 1 becomes empty and compacts when we move on.
    assert(d.move_focused_to_workspace(2))
    assert_eq(d.locate(10).unwrap().workspace_idx, 0)
    assert_eq(d.monitors[0].workspaces.len(), 2)

    // Switch to fixed 9 workspaces (dwm-tag style).
    d.reconfigure(9, 12.0, 0.5, lay.CenterMode.OnOverflow)
    assert_eq(d.monitors[0].workspaces.len(), 9)
    assert(d.focus_workspace(5))
    assert_eq(d.monitors[0].active_ws, 4)
}

test "floating toggle, fullscreen, and multi-monitor migration" {
    var d = lay.Desktop.new(0, 10.0, 0.5, lay.CenterMode.Never)
    d.add_monitor(1, "DP-1", core.Rect.new(0.0, 0.0, 1920.0, 1080.0), core.Rect.new(0.0, 32.0, 1920.0, 1048.0))
    d.add_monitor(2, "HDMI-1", core.Rect.new(1920.0, 0.0, 1920.0, 1080.0), core.Rect.new(1920.0, 0.0, 1920.0, 1080.0))
    d.add_window(100, false, 0.5, 800.0, 600.0, None)
    assert(d.toggle_floating(100))
    assert(d.locate(100).unwrap().floating)
    assert(d.toggle_fullscreen(100))
    var out: List[lay.TileTarget] = []
    d.compute_all(mut out)
    assert_eq(out.len(), 1)
    assert(out[0].fullscreen)
    assert_eq(out[0].rect.y, 0.0)
    assert_eq(out[0].rect.h, 1080.0)

    // Unplugging monitor 1 migrates window 100 cleanly to monitor 2.
    d.remove_monitor(1)
    assert_eq(d.monitors.len(), 1)
    assert(d.locate(100).is_some())
}

test "two default 0.5 columns fit symmetrically without clipping the old window edge" {
    var strip = lay.ScrollingStrip.new()
    let area = core.Rect.new(0.0, 0.0, 1920.0, 1080.0)
    let gap = 12.0
    strip.insert(1, 0.5)
    strip.insert(2, 0.5)

    var out: List[lay.TileTarget] = []
    strip.compute(area, gap, lay.CenterMode.Never, mut out)
    assert_eq(out.len(), 2)
    assert_eq(strip.camera_x, 0.0)
    // Old window keeps exact left gap (not clipped at x=0) and new window keeps exact right gap.
    assert_eq(out[0].rect.x, 12.0)
    assert_eq(out[0].rect.w, 942.0)
    assert_eq(out[1].rect.x, 966.0)
    assert_eq(out[1].rect.w, 942.0)
    assert_eq(out[1].rect.right(), 1908.0)

    // Opening a 3rd default 0.5 window scrolls cleanly by 1 column:
    // window 2 sits at x=12 (unclipped) and window 3 sits at x=966 (right edge 1908).
    strip.insert(3, 0.5)
    out.clear()
    strip.compute(area, gap, lay.CenterMode.Never, mut out)
    assert_eq(out[1].rect.x, 12.0)
    assert_eq(out[2].rect.x, 966.0)
    assert_eq(out[2].rect.right(), 1908.0)
}

test "fullscreen Z-order isolation, multi-monitor focus, 2D monitor nav, and orphan restore" {
    var d = lay.Desktop.new(4, 10.0, 0.5, lay.CenterMode.OnOverflow)
    d.add_monitor(1, "DP-1", core.Rect.new(0.0, 0.0, 1920.0, 1080.0), core.Rect.new(0.0, 0.0, 1920.0, 1080.0))
    d.add_monitor(2, "DP-2", core.Rect.new(0.0, 1080.0, 1920.0, 1080.0), core.Rect.new(0.0, 1080.0, 1920.0, 1080.0))

    // Add two tiled windows and one floating window on monitor 1, then fullscreen the first tiled window.
    d.add_window(10, false, 0.5, 800.0, 600.0, None)
    d.add_window(11, false, 0.5, 800.0, 600.0, None)
    d.add_window(12, true, 0.5, 500.0, 400.0, None)
    // Add a window on monitor 2 via vertical 2D navigation.
    assert(d.focus_monitor_2d(0, 1))
    d.add_window(20, false, 0.5, 800.0, 600.0, None)
    assert(d.focus_monitor_2d(0, -1))

    // Fullscreen window 10: monitor 1 emits ONLY fullscreen 10 (after monitor 2's tiled 20),
    // and ONLY monitor 1's window is marked focused.
    assert(d.set_fullscreen(10, true))
    var out: List[lay.TileTarget] = []
    d.compute_all(mut out)
    assert_eq(out.len(), 2)
    assert_eq(out[0].id, u64(20))
    assert(not out[0].focused)
    assert_eq(out[1].id, u64(10))
    assert(out[1].fullscreen and out[1].focused)

    // Explicit maximize targeting unfocused window 11 respects `on: bool` and targets 11's column only.
    assert(d.set_fullscreen(10, false))
    assert(d.set_maximized(11, true))
    assert(not d.set_maximized(11, true))
    d.compute_all(mut out)
    var saw_11_max = false
    var saw_10_max = false
    for t in out {
        if t.id == u64(11) {
            saw_11_max = t.maximized
        }
        if t.id == u64(10) {
            saw_10_max = t.maximized
        }
    }
    assert(saw_11_max and not saw_10_max)

    // Shrinking fixed workspaces migrates windows safely without dropping them.
    assert(d.move_focused_to_workspace(4))
    d.reconfigure(2, 10.0, 0.5, lay.CenterMode.OnOverflow)
    assert_eq(d.monitors[0].workspaces.len(), 2)
    assert(d.locate(12).is_some())

    // Disconnecting all monitors parks windows cleanly and restores them when a monitor returns.
    d.remove_monitor(1)
    d.remove_monitor(2)
    assert(d.monitors.is_empty())
    d.add_monitor(3, "HDMI-1", core.Rect.new(0.0, 0.0, 1920.0, 1080.0), core.Rect.new(0.0, 0.0, 1920.0, 1080.0))
    assert(d.locate(10).is_some() and d.locate(20).is_some())
}

test "sticky center-column, row weight resize, and remove active_row preservation" {
    var strip = lay.ScrollingStrip.new()
    let area = core.Rect.new(0.0, 0.0, 1000.0, 600.0)
    strip.insert(1, 0.5)
    strip.center_column()
    var out: List[lay.TileTarget] = []
    strip.compute(area, 10.0, lay.CenterMode.Never, mut out)
    let centered_x = out[0].rect.x
    assert((centered_x - 257.5).abs() < 2.0)
    // Next frame must STAY centered instead of snapping back to x=10!
    out.clear()
    strip.compute(area, 10.0, lay.CenterMode.Never, mut out)
    assert_eq(out[0].rect.x, centered_x)

    // Stack 3 windows vertically and verify row weight resize & active_row preservation on removal.
    strip.insert(2, 0.5)
    assert(strip.consume_into_column())
    strip.insert(3, 0.5)
    assert(strip.consume_into_column())
    assert_eq(strip.columns[0].windows.len(), 3)
    assert_eq(strip.columns[0].active_row, 2)
    assert(strip.adjust_row_weight(0.5))
    assert(strip.remove(1))
    // Removing row 0 shifted active_row from 2 -> 1 (still pointing to window 3).
    assert_eq(strip.focused(), Some(u64(3)))
}

test "LayoutPolicy trait generic compute, target monitor rules, late rules, and floating keyboard move/resize" {
    var strip = lay.ScrollingStrip.new()
    strip.insert(1, 0.5)
    var out: List[lay.TileTarget] = []
    lay.compute_policy(mut strip, core.Rect.new(0.0, 0.0, 1000.0, 600.0), 10.0, lay.CenterMode.Never, mut out)
    assert_eq(out.len(), 1)

    var d = lay.Desktop.new(0, 10.0, 0.5, lay.CenterMode.Never)
    d.add_monitor(1, "DP-1", core.Rect.new(0.0, 0.0, 1920.0, 1080.0), core.Rect.new(0.0, 0.0, 1920.0, 1080.0))
    d.add_monitor(2, "HDMI-1", core.Rect.new(1920.0, 0.0, 1920.0, 1080.0), core.Rect.new(1920.0, 0.0, 1920.0, 1080.0))
    d.add_window_on(50, false, 0.5, 800.0, 600.0, "HDMI-1", None)
    assert_eq(d.locate(50).unwrap().monitor_idx, 1)

    // Late rule floats window 50, moves it to DP-1, and keyboard move/resize updates its rect.
    assert(d.apply_late_rule(50, Some(true), None, None, 0.5, "DP-1", None))
    assert_eq(d.locate(50).unwrap().monitor_idx, 0)
    assert(d.locate(50).unwrap().floating)
    let before = d.monitors[0].workspaces[0].floating[0].rect
    assert(d.move_focused_floating(40.0, -20.0))
    assert(d.resize_focused_floating(100.0, 50.0))
    let after = d.monitors[0].workspaces[0].floating[0].rect
    assert_eq(after.x, before.x + 40.0)
    assert_eq(after.y, before.y - 20.0)
    assert_eq(after.w, before.w + 100.0)
    assert_eq(after.h, before.h + 50.0)
}

test "directional consume/expel, tabbed columns, always-center-single, reset-height, and expand-width" {
    var strip = lay.ScrollingStrip.new()
    strip.always_center_single = true
    let area = core.Rect.new(0.0, 0.0, 1000.0, 600.0)
    let gap = 10.0

    strip.insert(1, 0.5)
    var out: List[lay.TileTarget] = []
    strip.compute(area, gap, lay.CenterMode.Never, mut out)
    // Single column centered inside 1000px viewport.
    assert((out[0].rect.x - 257.5).abs() < 2.0)

    strip.insert(2, 0.33)
    // Directional consume-or-expel-left pulls window 2 into column 0.
    assert(strip.consume_or_expel_left())
    assert_eq(strip.columns.len(), 1)
    assert_eq(strip.columns[0].windows.len(), 2)

    // Adjust row height then reset.
    assert(strip.adjust_row_weight(1.0))
    assert(strip.reset_row_weights())
    assert(not strip.reset_row_weights())

    // Tabbed column emits ONLY active window (hiding non-active tab so luminaria suspends it).
    assert(strip.toggle_tabbed())
    out.clear()
    strip.compute(area, gap, lay.CenterMode.Never, mut out)
    assert_eq(out.len(), 1)
    assert(out[0].tabbed)
    assert_eq(out[0].tab_count, 2)
    assert_eq(out[0].tab_index, 1)
    assert_eq(out[0].id, u64(2))
    assert_eq(strip.focus_dir(0, -1), Some(u64(1)))
    out.clear()
    strip.compute(area, gap, lay.CenterMode.Never, mut out)
    assert_eq(out.len(), 1)
    assert_eq(out[0].id, u64(1))
    assert_eq(out[0].tab_index, 0)

    // Directional expel-left puts active window into a new column to the LEFT.
    assert(strip.consume_or_expel_left())
    assert_eq(strip.columns.len(), 2)
    assert_eq(strip.active_col, 0)
    assert_eq(strip.focused(), Some(u64(1)))

    // Directional consume-right absorbs solo window 1 into right neighbor column 1.
    assert(strip.consume_or_expel_right())
    assert_eq(strip.columns.len(), 1)
    assert_eq(strip.columns[0].windows.len(), 2)
    // Directional expel-right puts active window into a new column to the RIGHT.
    assert(strip.consume_or_expel_right())
    assert_eq(strip.columns.len(), 2)
    assert_eq(strip.active_col, 1)

    // Expand column to available remaining width.
    assert(strip.set_column_width(0.3))
    out.clear()
    strip.compute(area, gap, lay.CenterMode.Never, mut out)
    assert(strip.expand_to_available_width(area, gap))
    assert(strip.columns[strip.active_col].width_frac > 0.45)
}

test "move column across workspaces/monitors, silent move, previous workspace, open-focused=false, and overview" {
    var d = lay.Desktop.new(4, 12.0, 0.5, lay.CenterMode.OnOverflow)
    d.set_always_center_single(true)
    d.add_monitor(1, "DP-1", core.Rect.new(0.0, 0.0, 1920.0, 1080.0), core.Rect.new(0.0, 0.0, 1920.0, 1080.0))
    d.add_monitor(2, "DP-2", core.Rect.new(1920.0, 0.0, 1920.0, 1080.0), core.Rect.new(1920.0, 0.0, 1920.0, 1080.0))

    d.add_window(1, false, 0.5, 800.0, 600.0, None)
    // Unfocused window opens without stealing focus from window 1.
    d.add_window_full(2, false, 0.5, 800.0, 600.0, "", None, false)
    assert_eq(d.focused_window(), Some(u64(1)))

    // Stack window 1 & 2 into a single column, then move the ENTIRE column to workspace 3.
    assert(d.focus_window(2))
    assert(d.monitors[0].workspaces[0].strip.consume_or_expel_left())
    assert(d.move_column_to_workspace(3))
    assert_eq(d.monitors[0].active_ws, 2)
    assert_eq(d.locate(1).unwrap().workspace_idx, 2)
    assert_eq(d.locate(2).unwrap().workspace_idx, 2)

    // Focus previous workspace returns to workspace 1 (index 0).
    assert(d.focus_workspace_previous())
    assert_eq(d.monitors[0].active_ws, 0)
    assert(d.focus_workspace_previous())
    assert_eq(d.monitors[0].active_ws, 2)

    // Silent move sends window 2 to workspace 2 without leaving workspace 3.
    assert(d.move_focused_to_workspace_silent(2))
    assert_eq(d.monitors[0].active_ws, 2)
    assert_eq(d.locate(2).unwrap().workspace_idx, 1)

    // Move entire column across monitors (DP-1 -> DP-2).
    assert(d.move_column_to_monitor_2d(1, 0))
    assert_eq(d.active_monitor, 1)
    assert_eq(d.locate(1).unwrap().monitor_idx, 1)

    // Overview computes scaled workspace bands and window thumbnails across both monitors.
    var ov_targets: List[lay.TileTarget] = []
    var ov_bands: List[lay.OverviewBand] = []
    d.compute_overview(mut ov_targets, mut ov_bands)
    assert(ov_bands.len() >= 3)
    assert_eq(ov_targets.len(), 2)
    for t in ov_targets {
        assert(t.overview_scale > 0.05 and t.overview_scale < 0.6)
        assert(t.rect.w > 10.0 and t.rect.h > 10.0)
    }
}
