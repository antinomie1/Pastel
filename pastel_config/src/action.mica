// Action enum, parser, human-readable overlay labels, and --list-actions registry.

/// Every bindable and IPC-dispatchable compositor action.
pub enum Action {
    Noop
    Quit
    ReloadConfig
    ToggleHotkeyOverlay
    ToggleOverview
    PowerOffMonitors
    PowerOnMonitors
    SwitchLayout(int)
    CloseWindow
    CloseWindowById(u64)
    FocusWindow(u64)
    FocusColumnLeft
    FocusColumnRight
    FocusColumnFirst
    FocusColumnLast
    FocusWindowDown
    FocusWindowUp
    MoveColumnLeft
    MoveColumnRight
    MoveWindowDown
    MoveWindowUp
    ConsumeIntoColumn
    ExpelFromColumn
    ConsumeOrExpelLeft
    ConsumeOrExpelRight
    ToggleColumnTabbed
    CyclePresetWidth
    SetColumnWidth(f64)
    AdjustColumnWidth(f64)
    ExpandColumnToAvailableWidth
    AdjustWindowHeight(f64)
    ResetWindowHeight
    MaximizeColumn
    CenterColumn
    ToggleFullscreen
    ToggleFloating
    SwitchFocusFloating
    MoveFloating(f64, f64)
    ResizeFloating(f64, f64)
    FocusWorkspace(int)
    FocusWorkspaceUp
    FocusWorkspaceDown
    FocusWorkspacePrevious
    MoveWindowToWorkspace(int)
    MoveWindowToWorkspaceSilent(int)
    MoveWindowToWorkspaceUp
    MoveWindowToWorkspaceDown
    MoveColumnToWorkspace(int)
    MoveColumnToWorkspaceUp
    MoveColumnToWorkspaceDown
    FocusMonitorLeft
    FocusMonitorRight
    FocusMonitorUp
    FocusMonitorDown
    MoveWindowToMonitorLeft
    MoveWindowToMonitorRight
    MoveWindowToMonitorUp
    MoveWindowToMonitorDown
    MoveColumnToMonitorLeft
    MoveColumnToMonitorRight
    MoveColumnToMonitorUp
    MoveColumnToMonitorDown
    Spawn(str)
}

/// Parse an action string from `[binds]` or `pastel msg <action>`.
pub fn Action.parse(raw: str) -> Result[Action, str] {
    let s = raw.trim()
    guard not s.is_empty() else {
        return Err("empty action")
    }
    if s.starts_with("spawn ") {
        let cmd = s.slice(6, s.len()).trim()
        guard not cmd.is_empty() else {
            return Err("spawn requires a command")
        }
        return Ok(Action.Spawn(cmd))
    }
    if s.starts_with("switch-layout ") {
        let arg = s.slice(14, s.len()).trim().to_lower()
        return match arg {
            "next" => Ok(Action.SwitchLayout(1))
            "prev" or "previous" => Ok(Action.SwitchLayout(-1))
            _ => Err("switch-layout expects 'next' or 'prev', got '{arg}'")
        }
    }
    if s.starts_with("focus-window ") {
        let arg = s.slice(13, s.len()).trim()
        guard let Some(n) = arg.to_int() else {
            return Err("invalid window id '{arg}'")
        }
        guard n > 0 else {
            return Err("window id must be positive")
        }
        return Ok(Action.FocusWindow(u64(n)))
    }
    if s.starts_with("close-window ") {
        let arg = s.slice(13, s.len()).trim()
        guard let Some(n) = arg.to_int() else {
            return Err("invalid window id '{arg}'")
        }
        guard n > 0 else {
            return Err("window id must be positive")
        }
        return Ok(Action.CloseWindowById(u64(n)))
    }
    if s.starts_with("focus-workspace ") {
        let arg = s.slice(16, s.len()).trim()
        guard let Some(n) = arg.to_int() else {
            return Err("invalid workspace index '{arg}'")
        }
        guard n >= 1 and n <= 99 else {
            return Err("workspace index must be between 1 and 99")
        }
        return Ok(Action.FocusWorkspace(n))
    }
    if s.starts_with("move-window-to-workspace-silent ") {
        let arg = s.slice(32, s.len()).trim()
        guard let Some(n) = arg.to_int() else {
            return Err("invalid workspace index '{arg}'")
        }
        guard n >= 1 and n <= 99 else {
            return Err("workspace index must be between 1 and 99")
        }
        return Ok(Action.MoveWindowToWorkspaceSilent(n))
    }
    if s.starts_with("move-window-to-workspace ") {
        let arg = s.slice(25, s.len()).trim()
        guard let Some(n) = arg.to_int() else {
            return Err("invalid workspace index '{arg}'")
        }
        guard n >= 1 and n <= 99 else {
            return Err("workspace index must be between 1 and 99")
        }
        return Ok(Action.MoveWindowToWorkspace(n))
    }
    if s.starts_with("move-column-to-workspace ") {
        let arg = s.slice(25, s.len()).trim()
        guard let Some(n) = arg.to_int() else {
            return Err("invalid workspace index '{arg}'")
        }
        guard n >= 1 and n <= 99 else {
            return Err("workspace index must be between 1 and 99")
        }
        return Ok(Action.MoveColumnToWorkspace(n))
    }
    if s.starts_with("set-column-width ") {
        let arg = s.slice(17, s.len()).trim()
        guard let Some(v) = arg.to_float() else {
            return Err("invalid width '{arg}'")
        }
        guard v >= 0.1 and v <= 1.0 else {
            return Err("column width fraction must be in 0.1..1.0")
        }
        return Ok(Action.SetColumnWidth(v))
    }
    if s.starts_with("adjust-column-width ") {
        let arg = s.slice(20, s.len()).trim()
        guard let Some(v) = arg.to_float() else {
            return Err("invalid width delta '{arg}'")
        }
        guard v >= -1.0 and v <= 1.0 else {
            return Err("column width delta must be in -1.0..1.0")
        }
        return Ok(Action.AdjustColumnWidth(v))
    }
    if s.starts_with("adjust-window-height ") {
        let arg = s.slice(21, s.len()).trim()
        guard let Some(v) = arg.to_float() else {
            return Err("invalid height delta '{arg}'")
        }
        guard v >= -2.0 and v <= 2.0 else {
            return Err("window height delta must be in -2.0..2.0")
        }
        return Ok(Action.AdjustWindowHeight(v))
    }
    if s.starts_with("move-floating ") {
        let rest = s.slice(14, s.len()).trim()
        guard let Some(parts) = rest.split_once(" ") else {
            return Err("move-floating requires '<dx> <dy>'")
        }
        guard let Some(dx) = parts.left.trim().to_float() else {
            return Err("invalid dx '{parts.left}'")
        }
        guard let Some(dy) = parts.right.trim().to_float() else {
            return Err("invalid dy '{parts.right}'")
        }
        return Ok(Action.MoveFloating(dx, dy))
    }
    if s.starts_with("resize-floating ") {
        let rest = s.slice(16, s.len()).trim()
        guard let Some(parts) = rest.split_once(" ") else {
            return Err("resize-floating requires '<dw> <dh>'")
        }
        guard let Some(dw) = parts.left.trim().to_float() else {
            return Err("invalid dw '{parts.left}'")
        }
        guard let Some(dh) = parts.right.trim().to_float() else {
            return Err("invalid dh '{parts.right}'")
        }
        return Ok(Action.ResizeFloating(dw, dh))
    }
    return match s {
        "none" => Ok(Action.Noop)
        "quit" => Ok(Action.Quit)
        "reload-config" => Ok(Action.ReloadConfig)
        "toggle-hotkey-overlay" => Ok(Action.ToggleHotkeyOverlay)
        "toggle-overview" => Ok(Action.ToggleOverview)
        "power-off-monitors" => Ok(Action.PowerOffMonitors)
        "power-on-monitors" => Ok(Action.PowerOnMonitors)
        "close-window" => Ok(Action.CloseWindow)
        "focus-column-left" => Ok(Action.FocusColumnLeft)
        "focus-column-right" => Ok(Action.FocusColumnRight)
        "focus-column-first" => Ok(Action.FocusColumnFirst)
        "focus-column-last" => Ok(Action.FocusColumnLast)
        "focus-window-down" => Ok(Action.FocusWindowDown)
        "focus-window-up" => Ok(Action.FocusWindowUp)
        "move-column-left" => Ok(Action.MoveColumnLeft)
        "move-column-right" => Ok(Action.MoveColumnRight)
        "move-window-down" => Ok(Action.MoveWindowDown)
        "move-window-up" => Ok(Action.MoveWindowUp)
        "consume-into-column" => Ok(Action.ConsumeIntoColumn)
        "expel-from-column" => Ok(Action.ExpelFromColumn)
        "consume-or-expel-window-left" => Ok(Action.ConsumeOrExpelLeft)
        "consume-or-expel-window-right" => Ok(Action.ConsumeOrExpelRight)
        "toggle-column-tabbed-display" => Ok(Action.ToggleColumnTabbed)
        "cycle-preset-width" => Ok(Action.CyclePresetWidth)
        "expand-column-to-available-width" => Ok(Action.ExpandColumnToAvailableWidth)
        "reset-window-height" => Ok(Action.ResetWindowHeight)
        "maximize-column" => Ok(Action.MaximizeColumn)
        "center-column" => Ok(Action.CenterColumn)
        "toggle-fullscreen" => Ok(Action.ToggleFullscreen)
        "toggle-floating" => Ok(Action.ToggleFloating)
        "switch-focus-floating" => Ok(Action.SwitchFocusFloating)
        "focus-workspace-up" => Ok(Action.FocusWorkspaceUp)
        "focus-workspace-down" => Ok(Action.FocusWorkspaceDown)
        "focus-workspace-previous" => Ok(Action.FocusWorkspacePrevious)
        "move-window-to-workspace-up" => Ok(Action.MoveWindowToWorkspaceUp)
        "move-window-to-workspace-down" => Ok(Action.MoveWindowToWorkspaceDown)
        "move-column-to-workspace-up" => Ok(Action.MoveColumnToWorkspaceUp)
        "move-column-to-workspace-down" => Ok(Action.MoveColumnToWorkspaceDown)
        "focus-monitor-left" => Ok(Action.FocusMonitorLeft)
        "focus-monitor-right" => Ok(Action.FocusMonitorRight)
        "focus-monitor-up" => Ok(Action.FocusMonitorUp)
        "focus-monitor-down" => Ok(Action.FocusMonitorDown)
        "move-window-to-monitor-left" => Ok(Action.MoveWindowToMonitorLeft)
        "move-window-to-monitor-right" => Ok(Action.MoveWindowToMonitorRight)
        "move-window-to-monitor-up" => Ok(Action.MoveWindowToMonitorUp)
        "move-window-to-monitor-down" => Ok(Action.MoveWindowToMonitorDown)
        "move-column-to-monitor-left" => Ok(Action.MoveColumnToMonitorLeft)
        "move-column-to-monitor-right" => Ok(Action.MoveColumnToMonitorRight)
        "move-column-to-monitor-up" => Ok(Action.MoveColumnToMonitorUp)
        "move-column-to-monitor-down" => Ok(Action.MoveColumnToMonitorDown)
        _ => Err("unknown action '{s}' (run `pastel --list-actions` for valid actions)")
    }
}

/// Overlay section category matching Pastel's clean 4-section grouping.
pub fn Action.category(self) -> str {
    return match self {
        CloseWindow or CloseWindowById or FocusWindow or FocusWindowDown or FocusWindowUp or MoveWindowDown or MoveWindowUp or AdjustWindowHeight or ResetWindowHeight or ToggleFullscreen or ToggleFloating or SwitchFocusFloating or MoveFloating or ResizeFloating => "Windows"
        FocusColumnLeft or FocusColumnRight or FocusColumnFirst or FocusColumnLast or MoveColumnLeft or MoveColumnRight or ConsumeIntoColumn or ExpelFromColumn or ConsumeOrExpelLeft or ConsumeOrExpelRight or ToggleColumnTabbed or CyclePresetWidth or SetColumnWidth or AdjustColumnWidth or ExpandColumnToAvailableWidth or MaximizeColumn or CenterColumn => "Columns"
        FocusWorkspace or FocusWorkspaceUp or FocusWorkspaceDown or FocusWorkspacePrevious or MoveWindowToWorkspace or MoveWindowToWorkspaceSilent or MoveWindowToWorkspaceUp or MoveWindowToWorkspaceDown or MoveColumnToWorkspace or MoveColumnToWorkspaceUp or MoveColumnToWorkspaceDown or FocusMonitorLeft or FocusMonitorRight or FocusMonitorUp or FocusMonitorDown or MoveWindowToMonitorLeft or MoveWindowToMonitorRight or MoveWindowToMonitorUp or MoveWindowToMonitorDown or MoveColumnToMonitorLeft or MoveColumnToMonitorRight or MoveColumnToMonitorUp or MoveColumnToMonitorDown or ToggleOverview => "Workspaces"
        Spawn or ToggleHotkeyOverlay or PowerOffMonitors or PowerOnMonitors or SwitchLayout or ReloadConfig or Quit => "Session"
        Noop => ""
    }
}

/// Short human-readable description shown in the hotkey overlay.
pub fn Action.label(self) -> str {
    return match self {
        Noop => "None"
        Quit => "Quit"
        ReloadConfig => "Reload config"
        ToggleHotkeyOverlay => "Hotkeys"
        ToggleOverview => "Overview"
        PowerOffMonitors => "Power off monitors"
        PowerOnMonitors => "Power on monitors"
        SwitchLayout(d) => if d < 0 { "Previous layout" } else { "Next layout" }
        CloseWindow => "Close window"
        CloseWindowById(id) => "Close window {id}"
        FocusWindow(id) => "Focus window {id}"
        FocusColumnLeft => "Focus left"
        FocusColumnRight => "Focus right"
        FocusColumnFirst => "Focus first column"
        FocusColumnLast => "Focus last column"
        FocusWindowDown => "Focus down"
        FocusWindowUp => "Focus up"
        MoveColumnLeft => "Move column left"
        MoveColumnRight => "Move column right"
        MoveWindowDown => "Move window down"
        MoveWindowUp => "Move window up"
        ConsumeIntoColumn => "Join column"
        ExpelFromColumn => "Expel from column"
        ConsumeOrExpelLeft => "Consume/expel left"
        ConsumeOrExpelRight => "Consume/expel right"
        ToggleColumnTabbed => "Toggle tabbed column"
        CyclePresetWidth => "Cycle width"
        SetColumnWidth(v) => "Set width {v}"
        AdjustColumnWidth(v) => if v < 0.0 { "Shrink width" } else { "Grow width" }
        ExpandColumnToAvailableWidth => "Expand column width"
        AdjustWindowHeight(v) => if v < 0.0 { "Shrink height" } else { "Grow height" }
        ResetWindowHeight => "Reset window height"
        MaximizeColumn => "Maximize column"
        CenterColumn => "Center column"
        ToggleFullscreen => "Fullscreen"
        ToggleFloating => "Toggle floating"
        SwitchFocusFloating => "Focus float / tile"
        MoveFloating => "Move floating"
        ResizeFloating => "Resize floating"
        FocusWorkspace(n) => "Workspace {n}"
        FocusWorkspaceUp => "Workspace up"
        FocusWorkspaceDown => "Workspace down"
        FocusWorkspacePrevious => "Previous workspace"
        MoveWindowToWorkspace(n) => "Move to ws {n}"
        MoveWindowToWorkspaceSilent(n) => "Send to ws {n}"
        MoveWindowToWorkspaceUp => "Move to ws up"
        MoveWindowToWorkspaceDown => "Move to ws down"
        MoveColumnToWorkspace(n) => "Move col to ws {n}"
        MoveColumnToWorkspaceUp => "Move col to ws up"
        MoveColumnToWorkspaceDown => "Move col to ws down"
        FocusMonitorLeft => "Focus monitor left"
        FocusMonitorRight => "Focus monitor right"
        FocusMonitorUp => "Focus monitor up"
        FocusMonitorDown => "Focus monitor down"
        MoveWindowToMonitorLeft => "Move to monitor left"
        MoveWindowToMonitorRight => "Move to monitor right"
        MoveWindowToMonitorUp => "Move to monitor up"
        MoveWindowToMonitorDown => "Move to monitor down"
        MoveColumnToMonitorLeft => "Move col monitor left"
        MoveColumnToMonitorRight => "Move col monitor right"
        MoveColumnToMonitorUp => "Move col monitor up"
        MoveColumnToMonitorDown => "Move col monitor down"
        Spawn(cmd) => "Launch {cmd}"
    }
}

/// Complete list of `(action_syntax, description)` for `pastel --list-actions`.
pub fn all_actions() -> List[(str, str)] {
    return [
        ("none", "Unbind a default shortcut"),
        ("quit", "Quit Pastel"),
        ("reload-config", "Reload configuration file live"),
        ("toggle-hotkey-overlay", "Show or hide the hotkey overlay"),
        ("toggle-overview", "Toggle workspace & window thumbnail overview"),
        ("power-off-monitors", "Turn off monitors via DPMS (wakes on input)"),
        ("power-on-monitors", "Turn on monitors via DPMS"),
        ("switch-layout <next|prev>", "Cycle active XKB keyboard layout group"),
        ("close-window", "Close the focused window"),
        ("close-window <id>", "Close window by numeric id"),
        ("focus-window <id>", "Focus window by numeric id"),
        ("focus-column-left", "Focus the column to the left"),
        ("focus-column-right", "Focus the column to the right"),
        ("focus-column-first", "Focus the first column"),
        ("focus-column-last", "Focus the last column"),
        ("focus-window-down", "Focus the window below in the column"),
        ("focus-window-up", "Focus the window above in the column"),
        ("move-column-left", "Move the focused column left"),
        ("move-column-right", "Move the focused column right"),
        ("move-window-down", "Move the focused window down"),
        ("move-window-up", "Move the focused window up"),
        ("consume-into-column", "Pull focused window into adjacent column"),
        ("expel-from-column", "Expel focused window into a new column"),
        ("consume-or-expel-window-left", "Consume into left column or expel leftward"),
        ("consume-or-expel-window-right", "Consume into right column or expel rightward"),
        ("toggle-column-tabbed-display", "Toggle tabbed stack display for active column"),
        ("cycle-preset-width", "Cycle through layout.preset-widths"),
        ("set-column-width <0.1..1.0>", "Set focused column width fraction"),
        ("adjust-column-width <delta>", "Adjust focused column width fraction"),
        ("expand-column-to-available-width", "Expand active column to fill remaining viewport width"),
        ("adjust-window-height <delta>", "Adjust focused window height weight in column"),
        ("reset-window-height", "Reset window height weights in active column"),
        ("maximize-column", "Toggle full-width column maximization"),
        ("center-column", "Center the focused column in the viewport"),
        ("toggle-fullscreen", "Toggle fullscreen on the focused window"),
        ("toggle-floating", "Toggle floating state on the focused window"),
        ("switch-focus-floating", "Switch focus between floating and tiled layers"),
        ("move-floating <dx> <dy>", "Move focused floating window by logical pixels"),
        ("resize-floating <dw> <dh>", "Resize focused floating window by logical pixels"),
        ("focus-workspace <1..99>", "Focus workspace by 1-based index"),
        ("focus-workspace-up", "Focus previous workspace"),
        ("focus-workspace-down", "Focus next workspace"),
        ("focus-workspace-previous", "Toggle back to previously active workspace"),
        ("move-window-to-workspace <1..99>", "Move focused window to workspace"),
        ("move-window-to-workspace-silent <1..99>", "Send focused window to workspace without switching"),
        ("move-window-to-workspace-up", "Move focused window to previous workspace"),
        ("move-window-to-workspace-down", "Move focused window to next workspace"),
        ("move-column-to-workspace <1..99>", "Move active column to workspace"),
        ("move-column-to-workspace-up", "Move active column to previous workspace"),
        ("move-column-to-workspace-down", "Move active column to next workspace"),
        ("focus-monitor-left", "Focus monitor to the left"),
        ("focus-monitor-right", "Focus monitor to the right"),
        ("focus-monitor-up", "Focus monitor above"),
        ("focus-monitor-down", "Focus monitor below"),
        ("move-window-to-monitor-left", "Move focused window to left monitor"),
        ("move-window-to-monitor-right", "Move focused window to right monitor"),
        ("move-window-to-monitor-up", "Move focused window to monitor above"),
        ("move-window-to-monitor-down", "Move focused window to monitor below"),
        ("move-column-to-monitor-left", "Move active column to left monitor"),
        ("move-column-to-monitor-right", "Move active column to right monitor"),
        ("move-column-to-monitor-up", "Move active column to monitor above"),
        ("move-column-to-monitor-down", "Move active column to monitor below"),
        ("spawn <command>", "Spawn a shell command with WAYLAND_DISPLAY"),
    ]
}
