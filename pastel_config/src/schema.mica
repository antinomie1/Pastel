// Configuration schema types and defaults for Pastel.

import pastel_core as core

/// Which physical modifier key represents `Mod` in `[binds]`.
pub enum ModKey {
    Super
    Alt
    Ctrl
}

pub fn ModKey.from_str(s: str) -> Result[ModKey, str] {
    return match s.trim().to_lower() {
        "super" or "logo" or "meta" => Ok(ModKey.Super)
        "alt" => Ok(ModKey.Alt)
        "ctrl" or "control" => Ok(ModKey.Ctrl)
        _ => Err("unknown modifier '{s}' (expected super, alt, ctrl)")
    }
}

/// Horizontal scrolling focus centering strategy.
pub enum CenterFocus {
    Never
    OnOverflow
    Always
}

pub fn CenterFocus.from_str(s: str) -> Result[CenterFocus, str] {
    return match s.trim().to_lower() {
        "never" => Ok(CenterFocus.Never)
        "on-overflow" => Ok(CenterFocus.OnOverflow)
        "always" => Ok(CenterFocus.Always)
        _ => Err("unknown center-focus '{s}' (expected never, on-overflow, always)")
    }
}

pub struct XWaylandConfig {
    pub enabled: bool = true
    pub path: str = "xwayland-satellite"
    /// Optional fixed X11 display (e.g. `":0"` or `":12"`); empty auto-picks first free display.
    pub display: str = ""
    /// Max milliseconds to wait for the X11 socket to become ready before launching autostart apps.
    pub ready_timeout_ms: int = 1500
}

pub struct OutputConfig {
    pub name: str = ""
    pub mode: str = ""
    pub scale: Option[f64] = None
    pub pos_x: Option[f64] = None
    pub pos_y: Option[f64] = None
    pub vrr: Option[bool] = None
    pub enabled: bool = true
}

pub struct InputConfig {
    pub mod_key: ModKey = ModKey.Super
    pub nested_mod: ModKey = ModKey.Alt
    pub focus_follows_mouse: bool = false
    pub warp_mouse_to_focus: bool = false
    pub repeat_rate: i32 = 25
    pub repeat_delay: i32 = 600
    pub tap_to_click: bool = true
    pub natural_scroll: bool = false
    pub accel: f64 = 0.0
    pub left_handed: bool = false
    pub layout: str = ""
    pub variant: str = ""
    pub options: str = ""
}

pub struct LayoutConfig {
    pub kind: str = "scrolling"
    pub gap: f64 = 12.0
    pub default_width: f64 = 0.5
    pub preset_widths: List[f64] = []
    pub center_focus: CenterFocus = CenterFocus.Never
    /// 0 = dynamic niri-style workspaces; >0 = fixed dwm-style workspaces.
    pub workspaces: int = 0
}

pub fn LayoutConfig.default() -> LayoutConfig {
    return LayoutConfig {
        preset_widths: [1.0 / 3.0, 0.5, 2.0 / 3.0],
    }
}

/// Visual window styling. Default corners are square (`corner_radius = 0.0`).
pub struct WindowConfig {
    pub corner_radius: f32 = 0.0
    pub border_width: f32 = 2.0
    pub active_color: core.Color = core.Color { r: 0.651, g: 0.784, b: 1.0, a: 1.0 }
    pub inactive_color: core.Color = core.Color { r: 0.290, g: 0.310, b: 0.361, a: 1.0 }
    pub shadow_color: core.Color = core.Color { r: 0.0, g: 0.0, b: 0.0, a: 0.376 }
    pub shadow_size: f32 = 18.0
    pub opacity: f32 = 1.0
    pub blur: bool = true
    pub blur_xray: bool = true
    pub blur_passes: int = 2
    pub blur_offset: f32 = 2.0
}

pub struct AnimationConfig {
    pub enabled: bool = true
    pub slowdown: f64 = 1.0
    pub window_movement: core.CurveSpec = core.CurveSpec.Spring(core.Spring { stiffness: 800.0, damping: 1.0 })
    pub workspace_switch: core.CurveSpec = core.CurveSpec.Spring(core.Spring { stiffness: 900.0, damping: 1.0 })
    pub window_open: core.CurveSpec = core.CurveSpec.Ease(core.Ease { ms: 160.0, kind: core.EaseKind.OutCubic })
    pub window_close: core.CurveSpec = core.CurveSpec.Ease(core.Ease { ms: 140.0, kind: core.EaseKind.OutQuad })
    pub focus_ring: core.CurveSpec = core.CurveSpec.Ease(core.Ease { ms: 120.0, kind: core.EaseKind.OutCubic })
    pub overlay: core.CurveSpec = core.CurveSpec.Ease(core.Ease { ms: 140.0, kind: core.EaseKind.OutCubic })
}

pub struct OverlayConfig {
    pub at_startup: bool = true
    pub font: str = "sans-serif"
    pub opacity: f32 = 0.92
}

pub struct WindowRule {
    pub app_id: str = ""
    pub title: str = ""
    pub opacity: Option[f32] = None
    pub blur: Option[bool] = None
    pub corner_radius: Option[f32] = None
    pub border_width: Option[f32] = None
    pub default_width: Option[f64] = None
    pub floating: Option[bool] = None
    pub fullscreen: Option[bool] = None
    pub maximized: Option[bool] = None
    pub workspace: Option[int] = None
    pub monitor: str = ""
}

/// Glob match supporting `*` wildcards (when `*` is present) or case-sensitive substring match otherwise.
fn match_pattern(pattern: str, text: str) -> bool {
    guard not pattern.is_empty() else {
        return true
    }
    if not pattern.contains("*") {
        return text.contains(pattern)
    }
    let parts = pattern.split("*")
    let anchor_start = not pattern.starts_with("*")
    let anchor_end = not pattern.ends_with("*")
    var pos = 0
    for i, part in parts {
        if part.is_empty() {
            continue
        }
        if i == 0 and anchor_start {
            if not text.starts_with(part) {
                return false
            }
            pos = part.len()
        } else {
            let rest = text.slice(pos, text.len())
            guard let Some(idx) = rest.find(part) else {
                return false
            }
            pos += idx + part.len()
        }
    }
    if anchor_end {
        let last = parts[parts.len() - 1].clone()
        if not last.is_empty() and not text.ends_with(last) {
            return false
        }
    }
    return true
}

/// Match `app_id` and `title` criteria (supports `*` wildcards or substring match).
pub fn WindowRule.matches(self, app_id: str, title: str) -> bool {
    guard not self.app_id.is_empty() or not self.title.is_empty() else {
        return false
    }
    if not self.app_id.is_empty() and not match_pattern(self.app_id, app_id) {
        return false
    }
    if not self.title.is_empty() and not match_pattern(self.title, title) {
        return false
    }
    return true
}

/// Effective styling and placement hints resolved for a specific window.
pub struct ResolvedWindow {
    pub opacity: f32 = 1.0
    pub blur: bool = true
    pub corner_radius: f32 = 0.0
    pub border_width: f32 = 2.0
    pub default_width: f64 = 0.5
    pub floating: Option[bool] = None
    pub fullscreen: Option[bool] = None
    pub maximized: Option[bool] = None
    pub workspace: Option[int] = None
    pub monitor: str = ""
}
