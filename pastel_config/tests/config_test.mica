import std.fs
import pastel_config as cfg

test "empty config yields complete defaults with square corners" {
    let c = cfg.from_toml("").expect("empty toml")
    assert_eq(c.window.corner_radius, 0.0)
    assert_eq(c.window.border_width, 2.0)
    assert(c.window.blur)
    assert(c.window.blur_xray)
    assert_eq(c.layout.gap, 12.0)
    assert_eq(c.layout.preset_widths.len(), 3)
    assert(c.overlay.at_startup)
    assert(c.binds.len() > 20)
}

test "config.example.toml parses with zero errors" {
    let src = match fs.read_to_str("config.example.toml") {
        Ok(s) => s
        Err => fs.read_to_str("../config.example.toml").expect("read example")
    }
    let c = cfg.from_toml(src).expect("example toml")
    assert_eq(c.window.corner_radius, 0.0)
    assert_eq(c.window.blur_passes, 2)
}

test "binds merge, override, and unbind cleanly" {
    let toml = """
    [binds]
    "Mod+D" = "none"
    "Mod+Return" = "spawn alacritty"
    "Mod+B" = "spawn firefox"
    """
    let c = cfg.from_toml(toml).expect("parse")
    let d_combo = cfg.KeyCombo.parse("Mod+D").unwrap()
    let ret_combo = cfg.KeyCombo.parse("Mod+Return").unwrap()
    let b_combo = cfg.KeyCombo.parse("Mod+B").unwrap()
    var saw_d = false
    var saw_alacritty = false
    var saw_firefox = false
    for b in c.binds {
        if b.combo.same(d_combo) {
            saw_d = true
        }
        if b.combo.same(ret_combo) {
            match b.act {
                Spawn(cmd) => saw_alacritty = cmd == "alacritty"
                _ => {}
            }
        }
        if b.combo.same(b_combo) {
            match b.act {
                Spawn(cmd) => saw_firefox = cmd == "firefox"
                _ => {}
            }
        }
    }
    assert(not saw_d)
    assert(saw_alacritty)
    assert(saw_firefox)
}

test "window rules apply in order and unknown keys error" {
    let toml = """
    [[window-rule]]
    app-id = "foot"
    opacity = 0.85
    blur = true

    [[window-rule]]
    title = "Popup"
    opacity = 0.95
    floating = true
    """
    let c = cfg.from_toml(toml).expect("rules")
    let r = c.resolve_window("foot", "Popup Window")
    assert((r.opacity - 0.95).abs() < 0.001)
    assert(r.blur)
    assert_eq(r.floating, Some(true))
    assert(cfg.from_toml("unknown-key = 1").is_err())
    assert(cfg.from_toml("[window]\nbogus = 2").is_err())
}

test "shifted hotkey Mod+Shift+/ matches both / and ? keysyms" {
    let combo = cfg.KeyCombo.parse("Mod+Shift+/").expect("combo")
    assert(combo.matches(u32(0x002f), true, false, false, true, cfg.ModKey.Super))
    assert(combo.matches(u32(0x003f), true, false, false, true, cfg.ModKey.Super))
    assert(not combo.matches(u32(0x002f), false, false, false, true, cfg.ModKey.Super))
}

test "plus key parsing, non-collision with equal, mode validation, and 2D monitor actions" {
    let plus = cfg.KeyCombo.parse("Mod++").expect("Mod++")
    let eq = cfg.KeyCombo.parse("Mod+Equal").expect("Mod+Equal")
    assert(not plus.same(eq))
    assert_eq(plus.format_for(cfg.ModKey.Super), "Super + +")
    assert(cfg.Action.parse("focus-monitor-up").is_ok())
    assert(cfg.Action.parse("move-window-to-monitor-down").is_ok())
    assert(cfg.Action.parse("adjust-window-height 0.25").is_ok())
    assert(cfg.from_toml("[[output]]\nname = \"DP-1\"\nmode = \"1920x1080@144\"\n").is_ok())
    assert(cfg.from_toml("[[output]]\nname = \"DP-1\"\nmode = \"1920x1080@-60\"\n").is_err())
    assert(cfg.from_toml("[[output]]\nname = \"DP-1\"\nmode = \"not-a-mode\"\n").is_err())
}

test "xwayland-satellite config, wildcard window rules, floating actions, and layout-independent base_sym matching" {
    let toml = """
    [xwayland]
    enabled = true
    path = "/usr/bin/xwayland-satellite"
    display = ":12"
    ready-timeout-ms = 500

    [input]
    warp-mouse-to-focus = true

    [[window-rule]]
    app-id = "org.mozilla.*"
    title = "*Picture-in-Picture*"
    floating = true
    fullscreen = false
    maximized = false
    monitor = "DP-1"
    """
    let c = cfg.from_toml(toml).expect("full config")
    assert(c.xwayland.enabled)
    assert_eq(c.xwayland.display, ":12")
    assert_eq(c.xwayland.ready_timeout_ms, 500)
    assert(c.input.warp_mouse_to_focus)
    let r = c.resolve_window("org.mozilla.firefox", "Video - Picture-in-Picture")
    assert_eq(r.floating, Some(true))
    assert_eq(r.monitor, "DP-1")
    let miss = c.resolve_window("org.mozilla.firefox", "Normal Tab")
    assert(miss.floating.is_none())

    assert(cfg.Action.parse("move-floating 20 -10").is_ok())
    assert(cfg.Action.parse("resize-floating 100 50").is_ok())
    assert(cfg.from_toml("[xwayland]\ndisplay = \"bad\"\n").is_err())

    // Layout-independent match: non-US layout where Shift+/ produces e.g. 0x005f ('_') but base_sym is '/'.
    let combo = cfg.KeyCombo.parse("Mod+Shift+/").expect("combo")
    assert(combo.matches_with_base(u32(0x005f), u32(0x002f), true, false, false, true, cfg.ModKey.Super))
}

test "split touchpad/mouse input, cursor, env, HDR, on-demand VRR, lock-allowed binds, wheel/mouse triggers, and full XKB keysyms" {
    let toml = """
    [env]
    QT_QPA_PLATFORM = "wayland"
    MY_FLAG = "1"

    [cursor]
    size = 32
    hide-when-typing = true
    hide-after-inactive-ms = 3000

    [input.touchpad]
    tap-to-click = false
    natural-scroll = true
    accel = 0.25
    accel-profile = "adaptive"
    dwt = false

    [input.mouse]
    accel = -0.2
    accel-profile = "flat"
    left-handed = true

    [layout]
    always-center-single-column = true

    [[output]]
    name = "DP-1"
    vrr = "on-demand"
    hdr = true
    sdr-nits = 250.0
    max-nits = 1200.0

    [binds]
    "XF86AudioPlay" = \{ action = "spawn playerctl play-pause", allow-when-locked = true \}
    "Mod+MouseBack" = "focus-column-left"
    "Mod+WheelRight" = "focus-column-right"

    [[window-rule]]
    app-id = "org.keepassxc.KeePassXC"
    block-out-from-screencast = true
    open-focused = false
    default-floating-size = [640, 480]
    variable-refresh-rate = true
    """
    let c = cfg.from_toml(toml).expect("parse extended config")
    assert_eq(c.env.len(), 2)
    assert_eq(c.cursor.size, i32(32))
    assert(c.cursor.hide_when_typing)
    assert_eq(c.cursor.hide_after_inactive_ms, 3000)
    assert(not c.input.touchpad.tap_to_click)
    assert(c.input.touchpad.natural_scroll)
    assert(not c.input.touchpad.dwt)
    assert_eq(c.input.mouse.accel_profile, cfg.AccelProfile.Flat)
    assert(c.input.mouse.left_handed)
    assert(c.layout.always_center_single_column)
    assert_eq(c.outputs.len(), 1)
    assert_eq(c.outputs[0].vrr, Some(cfg.VrrMode.OnDemand))
    assert_eq(c.outputs[0].hdr, Some(true))
    assert((c.outputs[0].max_nits - 1200.0).abs() < 0.01)

    let r = c.resolve_window("org.keepassxc.KeePassXC", "Vault")
    assert(r.block_out_from_screencast)
    assert(not r.open_focused)
    assert_eq(r.default_floating_w, Some(640.0))
    assert_eq(r.default_floating_h, Some(480.0))
    assert_eq(r.variable_refresh_rate, Some(true))

    let play = cfg.KeyCombo.parse("XF86AudioPlay").expect("XF86AudioPlay via xkbcommon")
    let mb = cfg.KeyCombo.parse("Mod+MouseBack").expect("Mod+MouseBack")
    let wr = cfg.KeyCombo.parse("Mod+WheelRight").expect("Mod+WheelRight")
    assert(mb.matches_button(cfg.keys.mouse_back, false, false, false, true, cfg.ModKey.Super))
    assert(wr.matches_wheel(cfg.keys.wheel_right, false, false, false, true, cfg.ModKey.Super))
    var saw_locked_play = false
    for b in c.binds {
        if b.combo.same(play) and b.allow_when_locked {
            saw_locked_play = true
        }
    }
    assert(saw_locked_play)

    assert(cfg.Action.parse("toggle-overview").is_ok())
    assert(cfg.Action.parse("toggle-column-tabbed-display").is_ok())
    assert(cfg.Action.parse("power-off-monitors").is_ok())
    assert(cfg.Action.parse("power-on-monitors").is_ok())
    assert(cfg.Action.parse("consume-or-expel-window-left").is_ok())
    assert(cfg.Action.parse("consume-or-expel-window-right").is_ok())
    assert(cfg.Action.parse("move-column-to-workspace 3").is_ok())
    assert(cfg.Action.parse("move-column-to-monitor-right").is_ok())
    assert(cfg.Action.parse("move-window-to-workspace-silent 4").is_ok())
    assert(cfg.Action.parse("focus-workspace-previous").is_ok())
    assert(cfg.Action.parse("reset-window-height").is_ok())
    assert(cfg.Action.parse("expand-column-to-available-width").is_ok())
    assert(cfg.Action.parse("switch-layout next").is_ok())
    assert(cfg.Action.parse("focus-window 42").is_ok())
    assert(cfg.Action.parse("close-window 42").is_ok())
}
