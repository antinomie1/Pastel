// Keyboard bindings, pointer/scroll interactions, 3-finger touchpad gestures, and action dispatch.

import std.io
import std.json
import std.time
import luminaria as lum
import pastel_config as cfg
import compositor
import reload
import spawn
import windows

let btn_left: u32 = 272
let btn_right: u32 = 273
let scroll_step_threshold: f64 = 15.0

fn effective_mod[O: lum.plug.Output, R: lum.plug.Renderer](p: compositor.Pastel[O, R]) -> cfg.ModKey {
    return if p.nested { p.cfg.input.nested_mod } else { p.cfg.input.mod_key }
}

fn mod_down[O: lum.plug.Output, R: lum.plug.Renderer](p: compositor.Pastel[O, R], m: lum.Mods) -> bool {
    return match effective_mod(p) {
        Super => m.logo
        Alt => m.alt
        Ctrl => m.ctrl
    }
}

/// True when the active workspace is focused on a tiled window (not floating or fullscreen).
fn tiled_focused[O: lum.plug.Output, R: lum.plug.Renderer](p: compositor.Pastel[O, R]) -> bool {
    guard not p.desktop.monitors.is_empty() else {
        return false
    }
    let mi = p.desktop.active_monitor
    let wi = p.desktop.monitors[mi].active_ws
    guard wi < p.desktop.monitors[mi].workspaces.len() else {
        return false
    }
    return p.desktop.monitors[mi].workspaces[wi].fullscreen.is_none() and not p.desktop.monitors[mi].workspaces[wi].focus_floating and not p.desktop.monitors[mi].workspaces[wi].strip.is_empty()
}

/// Optional cursor warp to the newly focused monitor or window center when `[input].warp-mouse-to-focus` is enabled.
fn maybe_warp_pointer[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R]) {
    guard p.cfg.input.warp_mouse_to_focus and not p.desktop.monitors.is_empty() else {
        return
    }
    if let Some(id) = p.desktop.focused_window() {
        if let Some(wa) = p.anims.windows.get(id) {
            let c = wa.rect.target_center()
            p.d.warp(c.x, c.y)
            return
        }
    }
    let mi = p.desktop.active_monitor
    let c = p.desktop.monitors[mi].usable_rect.center()
    p.d.warp(c.x, c.y)
}

/// Dispatch any compositor action (from keybindings or IPC).
pub fn dispatch_action[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], act: cfg.Action) -> Result[(), str] {
    let now = time.now_ns()
    match act {
        Noop => {}
        Quit => {
            p.d.quit()
        }
        ReloadConfig => {
            try reload.reload_config(mut p)
        }
        ToggleHotkeyOverlay => {
            p.set_overlay_visible(not p.overlay_visible, now)
        }
        CloseWindow => {
            if let Some(id) = p.desktop.focused_window() {
                if let Some(w) = p.win_by_id.get(id) {
                    p.d.close(w)
                }
            }
        }
        FocusColumnLeft => {
            if not p.desktop.monitors.is_empty() {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                p.desktop.monitors[mi].workspaces[wi].fullscreen = None
                p.desktop.monitors[mi].workspaces[wi].focus_floating = false
                discard p.desktop.monitors[mi].workspaces[wi].strip.focus_dir(-1, 0)
                p.sync_focus()
                p.needs_layout = true
            }
        }
        FocusColumnRight => {
            if not p.desktop.monitors.is_empty() {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                p.desktop.monitors[mi].workspaces[wi].fullscreen = None
                p.desktop.monitors[mi].workspaces[wi].focus_floating = false
                discard p.desktop.monitors[mi].workspaces[wi].strip.focus_dir(1, 0)
                p.sync_focus()
                p.needs_layout = true
            }
        }
        FocusColumnFirst => {
            if not p.desktop.monitors.is_empty() {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                p.desktop.monitors[mi].workspaces[wi].fullscreen = None
                p.desktop.monitors[mi].workspaces[wi].focus_floating = false
                discard p.desktop.monitors[mi].workspaces[wi].strip.focus_first()
                p.sync_focus()
                p.needs_layout = true
            }
        }
        FocusColumnLast => {
            if not p.desktop.monitors.is_empty() {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                p.desktop.monitors[mi].workspaces[wi].fullscreen = None
                p.desktop.monitors[mi].workspaces[wi].focus_floating = false
                discard p.desktop.monitors[mi].workspaces[wi].strip.focus_last()
                p.sync_focus()
                p.needs_layout = true
            }
        }
        FocusWindowDown => {
            if not p.desktop.monitors.is_empty() {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                p.desktop.monitors[mi].workspaces[wi].fullscreen = None
                p.desktop.monitors[mi].workspaces[wi].focus_floating = false
                discard p.desktop.monitors[mi].workspaces[wi].strip.focus_dir(0, 1)
                p.sync_focus()
                p.needs_layout = true
            }
        }
        FocusWindowUp => {
            if not p.desktop.monitors.is_empty() {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                p.desktop.monitors[mi].workspaces[wi].fullscreen = None
                p.desktop.monitors[mi].workspaces[wi].focus_floating = false
                discard p.desktop.monitors[mi].workspaces[wi].strip.focus_dir(0, -1)
                p.sync_focus()
                p.needs_layout = true
            }
        }
        MoveColumnLeft => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.move_dir(-1, 0) {
                    p.needs_layout = true
                }
            }
        }
        MoveColumnRight => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.move_dir(1, 0) {
                    p.needs_layout = true
                }
            }
        }
        MoveWindowDown => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.move_dir(0, 1) {
                    p.needs_layout = true
                }
            }
        }
        MoveWindowUp => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.move_dir(0, -1) {
                    p.needs_layout = true
                }
            }
        }
        ConsumeIntoColumn => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.consume_into_column() {
                    p.sync_focus()
                    p.needs_layout = true
                }
            }
        }
        ExpelFromColumn => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.expel_from_column() {
                    p.sync_focus()
                    p.needs_layout = true
                }
            }
        }
        CyclePresetWidth => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                let presets = p.cfg.layout.preset_widths.clone()
                if p.desktop.monitors[mi].workspaces[wi].strip.cycle_preset_width(presets) {
                    p.needs_layout = true
                }
            }
        }
        SetColumnWidth(frac) => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.set_column_width(frac) {
                    p.needs_layout = true
                }
            }
        }
        AdjustColumnWidth(delta) => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.adjust_column_width(delta) {
                    p.needs_layout = true
                }
            }
        }
        AdjustWindowHeight(delta) => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.adjust_row_weight(delta) {
                    p.needs_layout = true
                }
            }
        }
        MaximizeColumn => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.toggle_maximize_column() {
                    p.needs_layout = true
                }
            }
        }
        CenterColumn => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                p.desktop.monitors[mi].workspaces[wi].strip.center_column()
                p.needs_layout = true
            }
        }
        ToggleFullscreen => {
            if let Some(id) = p.desktop.focused_window() {
                if p.desktop.toggle_fullscreen(id) {
                    p.needs_layout = true
                }
            }
        }
        ToggleFloating => {
            if let Some(id) = p.desktop.focused_window() {
                if p.desktop.toggle_floating(id) {
                    p.sync_focus()
                    p.needs_layout = true
                }
            }
        }
        SwitchFocusFloating => {
            if not p.desktop.monitors.is_empty() {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                discard p.desktop.monitors[mi].workspaces[wi].switch_focus_layer()
                p.sync_focus()
                p.needs_layout = true
            }
        }
        MoveFloating(dx, dy) => {
            if p.desktop.move_focused_floating(dx, dy) {
                p.needs_layout = true
            }
        }
        ResizeFloating(dw, dh) => {
            if p.desktop.resize_focused_floating(dw, dh) {
                p.needs_layout = true
            }
        }
        FocusWorkspace(n) => {
            if p.desktop.focus_workspace(n) {
                notify_ws_change(mut p, now)
            }
        }
        FocusWorkspaceUp => {
            if p.desktop.focus_workspace_rel(-1) {
                notify_ws_change(mut p, now)
            }
        }
        FocusWorkspaceDown => {
            if p.desktop.focus_workspace_rel(1) {
                notify_ws_change(mut p, now)
            }
        }
        MoveWindowToWorkspace(n) => {
            if p.desktop.move_focused_to_workspace(n) {
                notify_ws_change(mut p, now)
            }
        }
        MoveWindowToWorkspaceUp => {
            if p.desktop.move_focused_to_workspace_rel(-1) {
                notify_ws_change(mut p, now)
            }
        }
        MoveWindowToWorkspaceDown => {
            if p.desktop.move_focused_to_workspace_rel(1) {
                notify_ws_change(mut p, now)
            }
        }
        FocusMonitorLeft => {
            if p.desktop.focus_monitor_2d(-1, 0) {
                p.sync_focus()
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        FocusMonitorRight => {
            if p.desktop.focus_monitor_2d(1, 0) {
                p.sync_focus()
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        FocusMonitorUp => {
            if p.desktop.focus_monitor_2d(0, -1) {
                p.sync_focus()
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        FocusMonitorDown => {
            if p.desktop.focus_monitor_2d(0, 1) {
                p.sync_focus()
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        MoveWindowToMonitorLeft => {
            if p.desktop.move_focused_to_monitor_2d(-1, 0) {
                p.sync_focus()
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        MoveWindowToMonitorRight => {
            if p.desktop.move_focused_to_monitor_2d(1, 0) {
                p.sync_focus()
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        MoveWindowToMonitorUp => {
            if p.desktop.move_focused_to_monitor_2d(0, -1) {
                p.sync_focus()
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        MoveWindowToMonitorDown => {
            if p.desktop.move_focused_to_monitor_2d(0, 1) {
                p.sync_focus()
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        Spawn(cmd) => {
            let tok = p.d.activation_token()
            spawn.spawn_shell(cmd, p.d.socket(), p.ipc_socket_path.clone(), p.xwayland_display.clone(), tok)
        }
    }
    return Ok(())
}

pub fn notify_ws_change[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], now: int) {
    guard not p.desktop.monitors.is_empty() else {
        return
    }
    let mi = p.desktop.active_monitor
    let oid = p.desktop.monitors[mi].id
    let ws = p.desktop.monitors[mi].active_ws
    let vh = p.desktop.monitors[mi].usable_rect.h
    let ac = p.cfg.animation
    p.anims.switch_workspace(oid, ws, vh, ac, now)
    p.sync_focus()
    p.needs_layout = true
    p.broadcast_event("workspace-changed", json.obj().with("monitor", json.Value.Str(p.desktop.monitors[mi].name.clone())).with("workspace", json.Value.Int(ws + 1)))
}

fn suppress_key[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], code: u32) {
    if not p.suppressed_keys.contains(code) {
        p.suppressed_keys.push(code)
    }
}

/// Handle a key event. Returns `true` if consumed by Pastel (including matching key releases).
pub fn on_key[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], k: lum.Key) -> bool {
    if not k.pressed {
        for i in 0..p.suppressed_keys.len() {
            if p.suppressed_keys[i] == k.code {
                discard p.suppressed_keys.remove(i)
                return true
            }
        }
        return false
    }
    guard not p.d.shortcuts_inhibited() else {
        return false
    }
    // Check configured bindings first.
    let eff = effective_mod(p)
    var matched: Option[cfg.Action] = None
    for b in p.cfg.binds {
        if b.combo.matches_with_base(k.sym, k.base_sym, k.mods.shift, k.mods.ctrl, k.mods.alt, k.mods.logo, eff) {
            matched = Some(b.act.clone())
            break
        }
    }
    // If hotkey overlay is visible, any non-modifier key press dismisses it (niri behavior).
    if p.overlay_visible {
        // Ignore pure modifier keys so pressing Mod to hit Mod+Shift+/ doesn't dismiss early.
        let is_mod_key = k.sym >= u32(0xffe1) and k.sym <= u32(0xffee)
        if not is_mod_key {
            suppress_key(mut p, k.code)
            p.set_overlay_visible(false, time.now_ns())
            if let Some(act) = matched {
                match act {
                    ToggleHotkeyOverlay => {
                        return true
                    }
                    _ => {
                        if let Err(err) = dispatch_action(mut p, act) {
                            io.eprint("pastel: action error: {err}")
                        }
                        return true
                    }
                }
            }
            return true
        }
    }
    guard let Some(act) = matched else {
        return false
    }
    suppress_key(mut p, k.code)
    if let Err(err) = dispatch_action(mut p, act) {
        io.eprint("pastel: action error: {err}")
    }
    return true
}

/// Click-to-focus, Mod+Left drag (move floating / pan tiled strip), Mod+Right drag (resize floating).
pub fn on_button[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], b: lum.Pointer) -> bool {
    guard b.pressed else {
        return false
    }
    if p.overlay_visible {
        p.set_overlay_visible(false, time.now_ns())
        return true
    }
    guard let Some(w) = p.d.window_at(b.x, b.y) else {
        // Clicking empty space on another monitor transfers active monitor focus cleanly.
        if p.desktop.focus_monitor_at(b.x, b.y) {
            p.sync_focus()
            p.needs_layout = true
        }
        return false
    }
    let id = windows.window_id(w)
    if p.desktop.focus_window(id) {
        p.sync_focus()
        p.needs_layout = true
    }
    guard mod_down(p, p.d.mods()) else {
        return false
    }
    guard let Some(loc) = p.desktop.locate(id) else {
        return false
    }
    if loc.floating {
        if b.button == btn_left {
            p.d.manipulate_move(w)
            return true
        }
        if b.button == btn_right {
            let (ww, wh) = p.d.size(w)
            let fi = p.desktop.monitors[loc.monitor_idx].workspaces[loc.workspace_idx].find_floating(id)
            if fi >= 0 {
                let r = p.desktop.monitors[loc.monitor_idx].workspaces[loc.workspace_idx].floating[fi].rect
                let h: u32 = if b.x < r.x + f64(ww) * 0.5 { 4 } else { 8 }
                let t: u32 = if b.y < r.y + f64(wh) * 0.5 { 1 } else { 2 }
                p.d.manipulate_resize(w, h | t)
                return true
            }
        }
    } else if b.button == btn_left {
        p.d.manipulate_pan()
        return true
    }
    return false
}

/// Optional focus-follows-mouse on pointer motion (including empty monitors).
pub fn on_motion[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], m: lum.Pointer) {
    guard p.cfg.input.focus_follows_mouse else {
        return
    }
    if let Some(w) = p.d.window_at(m.x, m.y) {
        let id = windows.window_id(w)
        if p.desktop.focused_window() != Some(id) {
            if p.desktop.focus_window(id) {
                p.sync_focus()
                p.needs_layout = true
            }
        }
        return
    }
    if p.desktop.focus_monitor_at(m.x, m.y) {
        p.sync_focus()
        p.needs_layout = true
    }
}

/// Mod+Scroll horizontally scrolls columns in the active workspace with smooth detent accumulation.
pub fn on_scroll[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], s: lum.Scroll) -> bool {
    guard mod_down(p, p.d.mods()) and not p.desktop.monitors.is_empty() else {
        p.scroll_accum = 0.0
        return false
    }
    let delta = if s.dx.abs() > s.dy.abs() { s.dx } else { s.dy }
    if delta == 0.0 {
        return true
    }
    var steps = 0
    if delta.abs() >= scroll_step_threshold {
        p.scroll_accum = 0.0
        steps = if delta > 0.0 { 1 } else { -1 }
    } else {
        if (p.scroll_accum > 0.0 and delta < 0.0) or (p.scroll_accum < 0.0 and delta > 0.0) {
            p.scroll_accum = 0.0
        }
        p.scroll_accum += delta
        if p.scroll_accum.abs() >= scroll_step_threshold {
            steps = if p.scroll_accum > 0.0 { 1 } else { -1 }
            p.scroll_accum = 0.0
        }
    }
    if steps != 0 {
        let mi = p.desktop.active_monitor
        let wi = p.desktop.monitors[mi].active_ws
        p.desktop.monitors[mi].workspaces[wi].fullscreen = None
        p.desktop.monitors[mi].workspaces[wi].focus_floating = false
        discard p.desktop.monitors[mi].workspaces[wi].strip.focus_dir(steps, 0)
        p.sync_focus()
        p.needs_layout = true
    }
    return true
}

/// 3-finger touchpad swipe: horizontal pan of columns, vertical workspace switch.
/// Other gestures pass straight through to applications.
pub fn on_gesture[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], g: lum.Gesture) -> bool {
    match g.kind {
        SwipeBegin => {
            guard g.fingers == 3 and not p.desktop.monitors.is_empty() else {
                return false
            }
            p.swipe_active = true
            p.swipe_dx = 0.0
            p.swipe_dy = 0.0
            p.swipe_axis = 0
            p.swipe_mon = p.desktop.active_monitor
            p.swipe_ws = p.desktop.monitors[p.swipe_mon].active_ws
            return true
        }
        SwipeUpdate => {
            guard p.swipe_active else {
                return false
            }
            p.swipe_dx += g.dx
            p.swipe_dy += g.dy
            if p.swipe_axis == 0 and (p.swipe_dx.abs() > 10.0 or p.swipe_dy.abs() > 10.0) {
                p.swipe_axis = if p.swipe_dx.abs() >= p.swipe_dy.abs() { 1 } else { 2 }
            }
            if p.swipe_axis == 1 and p.swipe_mon < p.desktop.monitors.len() and p.swipe_ws < p.desktop.monitors[p.swipe_mon].workspaces.len() {
                p.desktop.monitors[p.swipe_mon].workspaces[p.swipe_ws].strip.pan(-g.dx * 1.4)
                p.needs_layout = true
            }
            return true
        }
        SwipeEnd => {
            guard p.swipe_active else {
                return false
            }
            p.swipe_active = false
            // Always finish horizontal pan on the originating workspace, even if the gesture was cancelled,
            // so `manual_pan` can never remain stuck true.
            if p.swipe_axis == 1 and p.swipe_mon < p.desktop.monitors.len() and p.swipe_ws < p.desktop.monitors[p.swipe_mon].workspaces.len() {
                let area = p.desktop.monitors[p.swipe_mon].usable_rect
                let gap = p.desktop.gap
                p.desktop.monitors[p.swipe_mon].workspaces[p.swipe_ws].strip.pan_end(area, gap)
                p.sync_focus()
                p.needs_layout = true
            } else if not g.cancelled and p.swipe_axis == 2 and p.swipe_dy.abs() > 35.0 and not p.desktop.monitors.is_empty() {
                let dir = if p.swipe_dy > 0.0 { -1 } else { 1 }
                if p.desktop.focus_workspace_rel(dir) {
                    notify_ws_change(mut p, time.now_ns())
                }
            }
            p.swipe_axis = 0
            return true
        }
        _ => {
            return false
        }
    }
}
