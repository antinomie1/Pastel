// Keyboard bindings, pointer/scroll/wheel bindings, 3/4-finger touchpad gestures, lock guard, and action dispatch.

import std.io
import std.json
import std.time
import luminaria as lum
import pastel_config as cfg
import compositor
import outputs
import reload
import spawn
import windows

let btn_left: u32 = 272
let btn_right: u32 = 273
let scroll_step_threshold: f64 = 15.0

fn wake_monitors_if_off[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R]) {
    if not p.monitors_powered {
        outputs.power_monitors(mut p, true)
    }
}

fn effective_mod[O: lum.plug.Output, R: lum.plug.Renderer](p: compositor.Pastel[O, R]) -> cfg.ModKey {
    return if p.nested { p.cfg.input.nested_mod } else { p.cfg.input.mod_key }
}

fn mod_down[O: lum.plug.Output, R: lum.plug.Renderer](p: compositor.Pastel[O, R], m: lum.Mods) -> bool {
    return match effective_mod(p) {
        Super => m.logo
        Alt => m.alt
        Ctrl => m.ctrl
    }
}

/// True when the active workspace is focused on a tiled window (not floating or fullscreen).
fn tiled_focused[O: lum.plug.Output, R: lum.plug.Renderer](p: compositor.Pastel[O, R]) -> bool {
    guard not p.desktop.monitors.is_empty() else {
        return false
    }
    let mi = p.desktop.active_monitor
    let wi = p.desktop.monitors[mi].active_ws
    guard wi < p.desktop.monitors[mi].workspaces.len() else {
        return false
    }
    return p.desktop.monitors[mi].workspaces[wi].fullscreen.is_none() and not p.desktop.monitors[mi].workspaces[wi].focus_floating and not p.desktop.monitors[mi].workspaces[wi].strip.is_empty()
}

/// True when the active tiled column on the focused monitor/workspace is maximized.
fn active_column_maximized[O: lum.plug.Output, R: lum.plug.Renderer](p: compositor.Pastel[O, R]) -> bool {
    guard not p.desktop.monitors.is_empty() else {
        return false
    }
    let mi = p.desktop.active_monitor
    let wi = p.desktop.monitors[mi].active_ws
    guard wi < p.desktop.monitors[mi].workspaces.len() else {
        return false
    }
    let ci = p.desktop.monitors[mi].workspaces[wi].strip.active_col
    guard ci >= 0 and ci < p.desktop.monitors[mi].workspaces[wi].strip.columns.len() else {
        return false
    }
    return p.desktop.monitors[mi].workspaces[wi].strip.columns[ci].maximized
}

/// Exit fullscreen on the active workspace (if any) and notify IPC subscribers.
fn clear_fullscreen[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], mi: int, wi: int) {
    if let Some(fs_id) = p.desktop.monitors[mi].workspaces[wi].fullscreen.take() {
        p.broadcast_window_changed(fs_id)
    }
}

/// Broadcast `workspace-changed` for the currently active monitor (e.g. after monitor focus change).
fn notify_active_monitor[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R]) {
    guard not p.desktop.monitors.is_empty() else {
        return
    }
    let mi = p.desktop.active_monitor
    let ws = p.desktop.monitors[mi].active_ws
    p.broadcast_event("workspace-changed", json.obj().with("monitor", json.Value.Str(p.desktop.monitors[mi].name.clone())).with("workspace", json.Value.Int(ws + 1)))
}

/// Optional cursor warp to the newly focused monitor or window center when `[input].warp-mouse-to-focus` is enabled.
fn maybe_warp_pointer[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R]) {
    guard p.cfg.input.warp_mouse_to_focus and not p.desktop.monitors.is_empty() else {
        return
    }
    if let Some(id) = p.desktop.focused_window() {
        if let Some(wa) = p.anims.windows.get(id) {
            let c = wa.rect.target_center()
            p.d.warp(c.x, c.y)
            return
        }
    }
    let mi = p.desktop.active_monitor
    let c = p.desktop.monitors[mi].usable_rect.center()
    p.d.warp(c.x, c.y)
}

/// Dispatch any compositor action (from keybindings or IPC).
pub fn dispatch_action[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], act: cfg.Action) -> Result[(), str] {
    let now = time.now_ns()
    match act {
        Noop => {}
        Quit => {
            p.d.quit()
        }
        ReloadConfig => {
            try reload.reload_config(mut p)
        }
        ToggleHotkeyOverlay => {
            p.set_overlay_visible(not p.overlay_visible, now)
        }
        ToggleOverview => {
            p.set_overview_open(not p.overview_open, now)
        }
        PowerOffMonitors => {
            outputs.power_monitors(mut p, false)
        }
        PowerOnMonitors => {
            outputs.power_monitors(mut p, true)
        }
        CloseWindow => {
            if let Some(id) = p.desktop.focused_window() {
                if let Some(w) = p.win_by_id.get(id) {
                    p.d.close(w)
                }
            }
        }
        CloseWindowById(id) => {
            guard let Some(w) = p.win_by_id.get(id) else {
                return Err("unknown window id {id}")
            }
            p.d.close(w)
        }
        FocusWindow(id) => {
            guard p.desktop.focus_window(id) else {
                return Err("unknown window id {id}")
            }
            p.sync_focus()
            maybe_warp_pointer(mut p)
            p.needs_layout = true
        }
        FocusColumnLeft => {
            if not p.desktop.monitors.is_empty() {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                clear_fullscreen(mut p, mi, wi)
                p.desktop.monitors[mi].workspaces[wi].focus_floating = false
                discard p.desktop.monitors[mi].workspaces[wi].strip.focus_dir(-1, 0)
                p.sync_focus()
                p.needs_layout = true
            }
        }
        FocusColumnRight => {
            if not p.desktop.monitors.is_empty() {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                clear_fullscreen(mut p, mi, wi)
                p.desktop.monitors[mi].workspaces[wi].focus_floating = false
                discard p.desktop.monitors[mi].workspaces[wi].strip.focus_dir(1, 0)
                p.sync_focus()
                p.needs_layout = true
            }
        }
        FocusColumnFirst => {
            if not p.desktop.monitors.is_empty() {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                clear_fullscreen(mut p, mi, wi)
                p.desktop.monitors[mi].workspaces[wi].focus_floating = false
                discard p.desktop.monitors[mi].workspaces[wi].strip.focus_first()
                p.sync_focus()
                p.needs_layout = true
            }
        }
        FocusColumnLast => {
            if not p.desktop.monitors.is_empty() {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                clear_fullscreen(mut p, mi, wi)
                p.desktop.monitors[mi].workspaces[wi].focus_floating = false
                discard p.desktop.monitors[mi].workspaces[wi].strip.focus_last()
                p.sync_focus()
                p.needs_layout = true
            }
        }
        FocusWindowDown => {
            if not p.desktop.monitors.is_empty() {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                clear_fullscreen(mut p, mi, wi)
                p.desktop.monitors[mi].workspaces[wi].focus_floating = false
                discard p.desktop.monitors[mi].workspaces[wi].strip.focus_dir(0, 1)
                p.sync_focus()
                p.needs_layout = true
            }
        }
        FocusWindowUp => {
            if not p.desktop.monitors.is_empty() {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                clear_fullscreen(mut p, mi, wi)
                p.desktop.monitors[mi].workspaces[wi].focus_floating = false
                discard p.desktop.monitors[mi].workspaces[wi].strip.focus_dir(0, -1)
                p.sync_focus()
                p.needs_layout = true
            }
        }
        MoveColumnLeft => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.move_dir(-1, 0) {
                    p.needs_layout = true
                }
            }
        }
        MoveColumnRight => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.move_dir(1, 0) {
                    p.needs_layout = true
                }
            }
        }
        MoveWindowDown => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.move_dir(0, 1) {
                    p.needs_layout = true
                }
            }
        }
        MoveWindowUp => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.move_dir(0, -1) {
                    p.needs_layout = true
                }
            }
        }
        ConsumeIntoColumn => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.consume_into_column() {
                    p.sync_focus()
                    p.needs_layout = true
                }
            }
        }
        ExpelFromColumn => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.expel_from_column() {
                    p.sync_focus()
                    p.needs_layout = true
                }
            }
        }
        ConsumeOrExpelLeft => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.consume_or_expel_left() {
                    p.sync_focus()
                    p.needs_layout = true
                }
            }
        }
        ConsumeOrExpelRight => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.consume_or_expel_right() {
                    p.sync_focus()
                    p.needs_layout = true
                }
            }
        }
        ToggleColumnTabbed => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.toggle_tabbed() {
                    p.sync_focus()
                    p.broadcast_window_changed(p.desktop.focused_window().unwrap_or(0))
                    p.needs_layout = true
                }
            }
        }
        CyclePresetWidth => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                let was_max = active_column_maximized(p)
                let presets = p.cfg.layout.preset_widths.clone()
                if p.desktop.monitors[mi].workspaces[wi].strip.cycle_preset_width(presets) {
                    if was_max and not active_column_maximized(p) {
                        p.broadcast_window_changed(p.desktop.focused_window().unwrap_or(0))
                    }
                    p.needs_layout = true
                }
            }
        }
        SetColumnWidth(frac) => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                let was_max = active_column_maximized(p)
                if p.desktop.monitors[mi].workspaces[wi].strip.set_column_width(frac) {
                    if was_max and not active_column_maximized(p) {
                        p.broadcast_window_changed(p.desktop.focused_window().unwrap_or(0))
                    }
                    p.needs_layout = true
                }
            }
        }
        AdjustColumnWidth(delta) => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                let was_max = active_column_maximized(p)
                if p.desktop.monitors[mi].workspaces[wi].strip.adjust_column_width(delta) {
                    if was_max and not active_column_maximized(p) {
                        p.broadcast_window_changed(p.desktop.focused_window().unwrap_or(0))
                    }
                    p.needs_layout = true
                }
            }
        }
        AdjustWindowHeight(delta) => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.adjust_row_weight(delta) {
                    p.needs_layout = true
                }
            }
        }
        ResetWindowHeight => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.reset_row_weights() {
                    p.needs_layout = true
                }
            }
        }
        ExpandColumnToAvailableWidth => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                let was_max = active_column_maximized(p)
                let area = p.desktop.monitors[mi].usable_rect
                let gap = p.desktop.gap
                if p.desktop.monitors[mi].workspaces[wi].strip.expand_to_available_width(area, gap) {
                    if was_max and not active_column_maximized(p) {
                        p.broadcast_window_changed(p.desktop.focused_window().unwrap_or(0))
                    }
                    p.needs_layout = true
                }
            }
        }
        MaximizeColumn => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                if p.desktop.monitors[mi].workspaces[wi].strip.toggle_maximize_column() {
                    p.broadcast_window_changed(p.desktop.focused_window().unwrap_or(0))
                    p.needs_layout = true
                }
            }
        }
        CenterColumn => {
            if tiled_focused(p) {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                p.desktop.monitors[mi].workspaces[wi].strip.center_column()
                p.needs_layout = true
            }
        }
        ToggleFullscreen => {
            if let Some(id) = p.desktop.focused_window() {
                if p.desktop.toggle_fullscreen(id) {
                    p.broadcast_window_changed(id)
                    p.needs_layout = true
                }
            }
        }
        ToggleFloating => {
            if let Some(id) = p.desktop.focused_window() {
                if p.desktop.toggle_floating(id) {
                    p.sync_focus()
                    p.broadcast_window_changed(id)
                    p.needs_layout = true
                }
            }
        }
        SwitchFocusFloating => {
            if not p.desktop.monitors.is_empty() {
                let mi = p.desktop.active_monitor
                let wi = p.desktop.monitors[mi].active_ws
                discard p.desktop.monitors[mi].workspaces[wi].switch_focus_layer()
                p.sync_focus()
                p.needs_layout = true
            }
        }
        MoveFloating(dx, dy) => {
            if p.desktop.move_focused_floating(dx, dy) {
                p.needs_layout = true
            }
        }
        ResizeFloating(dw, dh) => {
            if p.desktop.resize_focused_floating(dw, dh) {
                p.needs_layout = true
            }
        }
        FocusWorkspace(n) => {
            if p.desktop.focus_workspace(n) {
                notify_ws_change(mut p, now)
            }
        }
        FocusWorkspaceUp => {
            if p.desktop.focus_workspace_rel(-1) {
                notify_ws_change(mut p, now)
            }
        }
        FocusWorkspaceDown => {
            if p.desktop.focus_workspace_rel(1) {
                notify_ws_change(mut p, now)
            }
        }
        FocusWorkspacePrevious => {
            if p.desktop.focus_workspace_previous() {
                notify_ws_change(mut p, now)
            }
        }
        MoveWindowToWorkspace(n) => {
            if p.desktop.move_focused_to_workspace(n) {
                notify_ws_change(mut p, now)
            }
        }
        MoveWindowToWorkspaceSilent(n) => {
            let moved_id = p.desktop.focused_window().unwrap_or(0)
            if p.desktop.move_focused_to_workspace_silent(n) {
                p.sync_focus()
                p.broadcast_window_changed(moved_id)
                p.needs_layout = true
            }
        }
        MoveWindowToWorkspaceUp => {
            if p.desktop.move_focused_to_workspace_rel(-1) {
                notify_ws_change(mut p, now)
            }
        }
        MoveWindowToWorkspaceDown => {
            if p.desktop.move_focused_to_workspace_rel(1) {
                notify_ws_change(mut p, now)
            }
        }
        MoveColumnToWorkspace(n) => {
            if p.desktop.move_column_to_workspace(n) {
                notify_ws_change(mut p, now)
            }
        }
        MoveColumnToWorkspaceUp => {
            if p.desktop.move_column_to_workspace_rel(-1) {
                notify_ws_change(mut p, now)
            }
        }
        MoveColumnToWorkspaceDown => {
            if p.desktop.move_column_to_workspace_rel(1) {
                notify_ws_change(mut p, now)
            }
        }
        FocusMonitorLeft => {
            if p.desktop.focus_monitor_2d(-1, 0) {
                p.sync_focus()
                notify_active_monitor(mut p)
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        FocusMonitorRight => {
            if p.desktop.focus_monitor_2d(1, 0) {
                p.sync_focus()
                notify_active_monitor(mut p)
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        FocusMonitorUp => {
            if p.desktop.focus_monitor_2d(0, -1) {
                p.sync_focus()
                notify_active_monitor(mut p)
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        FocusMonitorDown => {
            if p.desktop.focus_monitor_2d(0, 1) {
                p.sync_focus()
                notify_active_monitor(mut p)
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        MoveWindowToMonitorLeft => {
            if p.desktop.move_focused_to_monitor_2d(-1, 0) {
                p.sync_focus()
                p.broadcast_window_changed(p.desktop.focused_window().unwrap_or(0))
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        MoveWindowToMonitorRight => {
            if p.desktop.move_focused_to_monitor_2d(1, 0) {
                p.sync_focus()
                p.broadcast_window_changed(p.desktop.focused_window().unwrap_or(0))
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        MoveWindowToMonitorUp => {
            if p.desktop.move_focused_to_monitor_2d(0, -1) {
                p.sync_focus()
                p.broadcast_window_changed(p.desktop.focused_window().unwrap_or(0))
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        MoveWindowToMonitorDown => {
            if p.desktop.move_focused_to_monitor_2d(0, 1) {
                p.sync_focus()
                p.broadcast_window_changed(p.desktop.focused_window().unwrap_or(0))
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        MoveColumnToMonitorLeft => {
            if p.desktop.move_column_to_monitor_2d(-1, 0) {
                p.sync_focus()
                p.broadcast_window_changed(p.desktop.focused_window().unwrap_or(0))
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        MoveColumnToMonitorRight => {
            if p.desktop.move_column_to_monitor_2d(1, 0) {
                p.sync_focus()
                p.broadcast_window_changed(p.desktop.focused_window().unwrap_or(0))
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        MoveColumnToMonitorUp => {
            if p.desktop.move_column_to_monitor_2d(0, -1) {
                p.sync_focus()
                p.broadcast_window_changed(p.desktop.focused_window().unwrap_or(0))
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        MoveColumnToMonitorDown => {
            if p.desktop.move_column_to_monitor_2d(0, 1) {
                p.sync_focus()
                p.broadcast_window_changed(p.desktop.focused_window().unwrap_or(0))
                maybe_warp_pointer(mut p)
                p.needs_layout = true
            }
        }
        SwitchLayout(delta) => {
            if p.d.switch_layout(delta) {
                p.broadcast_event("layout-changed", json.obj().with("layout", json.Value.Str(p.d.layout_name())))
            }
        }
        Spawn(cmd) => {
            let tok = p.d.activation_token()
            spawn.spawn_shell(cmd, p.d.socket(), p.ipc_socket_path.clone(), p.xwayland_display.clone(), tok, p.cfg.env)
        }
    }
    return Ok(())
}

pub fn notify_ws_change[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], now: int) {
    guard not p.desktop.monitors.is_empty() else {
        return
    }
    let mi = p.desktop.active_monitor
    let oid = p.desktop.monitors[mi].id
    let ws = p.desktop.monitors[mi].active_ws
    let vh = p.desktop.monitors[mi].usable_rect.h
    let ac = p.cfg.animation
    p.anims.switch_workspace(oid, ws, vh, ac, now)
    p.sync_focus()
    p.needs_layout = true
    p.broadcast_event("workspace-changed", json.obj().with("monitor", json.Value.Str(p.desktop.monitors[mi].name.clone())).with("workspace", json.Value.Int(ws + 1)))
}

fn suppress_key[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], code: u32) {
    if not p.suppressed_keys.contains(code) {
        p.suppressed_keys.push(code)
    }
}

/// Handle a key event. Returns `true` if consumed by Pastel (including matching key releases).
pub fn on_key[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], k: lum.Key) -> bool {
    if not k.pressed {
        for i in 0..p.suppressed_keys.len() {
            if p.suppressed_keys[i] == k.code {
                discard p.suppressed_keys.remove(i)
                return true
            }
        }
        return false
    }
    wake_monitors_if_off(mut p)
    let eff = effective_mod(p)
    // Session lock security: only bindings explicitly marked `allow-when-locked = true` fire while locked.
    if p.d.locked() {
        var locked_act: Option[cfg.Action] = None
        for b in p.cfg.binds {
            if b.allow_when_locked and b.combo.matches_with_base(k.sym, k.base_sym, k.mods.shift, k.mods.ctrl, k.mods.alt, k.mods.logo, eff) {
                locked_act = Some(b.act.clone())
                break
            }
        }
        if let Some(act) = locked_act {
            suppress_key(mut p, k.code)
            if let Err(err) = dispatch_action(mut p, act) {
                io.eprint("pastel: action error: {err}")
            }
            return true
        }
        return false
    }
    guard not p.d.shortcuts_inhibited() else {
        return false
    }
    // Check configured bindings first.
    var matched: Option[cfg.Action] = None
    for b in p.cfg.binds {
        if b.combo.matches_with_base(k.sym, k.base_sym, k.mods.shift, k.mods.ctrl, k.mods.alt, k.mods.logo, eff) {
            matched = Some(b.act.clone())
            break
        }
    }
    let is_mod_key = k.sym >= u32(0xffe1) and k.sym <= u32(0xffee)
    // If hotkey overlay is visible, any non-modifier key press dismisses it (niri behavior).
    if p.overlay_visible {
        if not is_mod_key {
            suppress_key(mut p, k.code)
            p.set_overlay_visible(false, time.now_ns())
            if let Some(act) = matched {
                match act {
                    ToggleHotkeyOverlay => {
                        return true
                    }
                    _ => {
                        if let Err(err) = dispatch_action(mut p, act) {
                            io.eprint("pastel: action error: {err}")
                        }
                        return true
                    }
                }
            }
            return true
        }
    }
    if let Some(act) = matched {
        suppress_key(mut p, k.code)
        if let Err(err) = dispatch_action(mut p, act) {
            io.eprint("pastel: action error: {err}")
        }
        return true
    }
    // Escape or Return closes Overview thumbnail mode cleanly.
    if p.overview_open and (k.sym == u32(0xff1b) or k.sym == u32(0xff0d)) {
        suppress_key(mut p, k.code)
        p.set_overview_open(false, time.now_ns())
        return true
    }
    if p.cfg.cursor.hide_when_typing and not is_mod_key and not p.cursor_hidden {
        p.d.hide_cursor()
        p.cursor_hidden = true
    }
    return false
}

/// Overview thumbnail selection, configurable mouse button bindings, click-to-focus,
/// Mod+Left drag (move floating / pan tiled strip), and Mod+Right drag (resize floating).
pub fn on_button[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], b: lum.Pointer) -> bool {
    guard b.pressed else {
        return false
    }
    wake_monitors_if_off(mut p)
    guard not p.d.locked() else {
        return false
    }
    if p.overlay_visible {
        p.set_overlay_visible(false, time.now_ns())
        return true
    }
    if p.overview_open {
        let now = time.now_ns()
        if let Some(w) = p.d.window_at(b.x, b.y) {
            let id = windows.window_id(w)
            discard p.desktop.focus_window(id)
            p.sync_focus()
            p.set_overview_open(false, now)
            return true
        }
        var hit_band: Option[(int, int)] = None
        for band in p.overview_bands {
            if band.rect.contains(b.x, b.y) {
                hit_band = Some((band.monitor_idx, band.workspace_idx))
                break
            }
        }
        if let Some((bmi, bwi)) = hit_band {
            if bmi >= 0 and bmi < p.desktop.monitors.len() {
                p.desktop.active_monitor = bmi
                discard p.desktop.focus_workspace(bwi + 1)
                p.sync_focus()
            }
            p.set_overview_open(false, now)
            return true
        }
        p.set_overview_open(false, now)
        return true
    }
    // Check configured mouse button bindings (`MouseMiddle`, `MouseBack`, `MouseForward`, etc.).
    let mods = p.d.mods()
    let eff = effective_mod(p)
    var btn_act: Option[cfg.Action] = None
    for bind in p.cfg.binds {
        if bind.combo.matches_button(b.button, mods.shift, mods.ctrl, mods.alt, mods.logo, eff) {
            btn_act = Some(bind.act.clone())
            break
        }
    }
    if let Some(act) = btn_act {
        if let Err(err) = dispatch_action(mut p, act) {
            io.eprint("pastel: action error: {err}")
        }
        return true
    }
    guard let Some(w) = p.d.window_at(b.x, b.y) else {
        // Clicking empty space on another monitor transfers active monitor focus cleanly.
        if p.desktop.focus_monitor_at(b.x, b.y) {
            p.sync_focus()
            p.needs_layout = true
        }
        return false
    }
    let id = windows.window_id(w)
    if p.desktop.focus_window(id) {
        p.sync_focus()
        p.needs_layout = true
    }
    guard mod_down(p, mods) else {
        return false
    }
    guard let Some(loc) = p.desktop.locate(id) else {
        return false
    }
    if loc.floating {
        if b.button == btn_left {
            p.d.manipulate_move(w)
            return true
        }
        if b.button == btn_right {
            let (ww, wh) = p.d.size(w)
            let fi = p.desktop.monitors[loc.monitor_idx].workspaces[loc.workspace_idx].find_floating(id)
            if fi >= 0 {
                let r = p.desktop.monitors[loc.monitor_idx].workspaces[loc.workspace_idx].floating[fi].rect
                let eff_w = if ww > 0 { f64(ww) } else { r.w }
                let eff_h = if wh > 0 { f64(wh) } else { r.h }
                let h: u32 = if b.x < r.x + eff_w * 0.5 { 4 } else { 8 }
                let t: u32 = if b.y < r.y + eff_h * 0.5 { 1 } else { 2 }
                p.d.manipulate_resize(w, h | t)
                return true
            }
        }
    } else if b.button == btn_left {
        p.d.manipulate_pan()
        return true
    }
    return false
}

/// Cursor auto-restore/inactivity hide timer and optional focus-follows-mouse on pointer motion.
pub fn on_motion[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], m: lum.Pointer) {
    wake_monitors_if_off(mut p)
    let hide_ms = p.cfg.cursor.hide_after_inactive_ms
    if p.cursor_hidden {
        p.d.set_cursor_named("default")
        p.cursor_hidden = false
    }
    if hide_ms > 0 {
        p.cursor_last_motion_ns = time.now_ns()
        if not p.cursor_timer_pending {
            p.cursor_timer_pending = true
            p.d.timer(hide_ms, compositor.tok_cursor_hide)
        }
    }
    guard not p.d.locked() and not p.overview_open and p.cfg.input.focus_follows_mouse else {
        return
    }
    if let Some(w) = p.d.window_at(m.x, m.y) {
        let id = windows.window_id(w)
        if p.desktop.focused_window() != Some(id) {
            if p.desktop.focus_window(id) {
                p.sync_focus()
                p.needs_layout = true
            }
        }
        return
    }
    if p.desktop.focus_monitor_at(m.x, m.y) {
        p.sync_focus()
        p.needs_layout = true
    }
}

fn find_wheel_bind[O: lum.plug.Output, R: lum.plug.Renderer](p: compositor.Pastel[O, R], code: u32, mods: lum.Mods) -> Option[cfg.Action] {
    let eff = effective_mod(p)
    for b in p.cfg.binds {
        if b.combo.matches_wheel(code, mods.shift, mods.ctrl, mods.alt, mods.logo, eff) {
            return Some(b.act.clone())
        }
    }
    return None
}

/// Configurable scroll wheel bindings (`WheelUp`/`WheelDown`/`WheelLeft`/`WheelRight`) with detent accumulation.
pub fn on_scroll[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], s: lum.Scroll) -> bool {
    wake_monitors_if_off(mut p)
    guard not p.d.locked() else {
        return false
    }
    let mods = p.d.mods()
    let horiz = s.dx.abs() > s.dy.abs()
    let delta = if horiz { s.dx } else { s.dy }
    guard delta != 0.0 else {
        return false
    }
    let want_code = if horiz {
        if delta < 0.0 { cfg.keys.wheel_left } else { cfg.keys.wheel_right }
    } else if delta < 0.0 {
        cfg.keys.wheel_up
    } else {
        cfg.keys.wheel_down
    }
    guard let Some(act) = find_wheel_bind(p, u32(want_code), mods) else {
        p.scroll_accum_x = 0.0
        p.scroll_accum_y = 0.0
        return false
    }
    var fired = false
    if delta.abs() >= scroll_step_threshold {
        p.scroll_accum_x = 0.0
        p.scroll_accum_y = 0.0
        fired = true
    } else if horiz {
        if (p.scroll_accum_x > 0.0 and delta < 0.0) or (p.scroll_accum_x < 0.0 and delta > 0.0) {
            p.scroll_accum_x = 0.0
        }
        p.scroll_accum_x += delta
        if p.scroll_accum_x.abs() >= scroll_step_threshold {
            p.scroll_accum_x = 0.0
            fired = true
        }
    } else {
        if (p.scroll_accum_y > 0.0 and delta < 0.0) or (p.scroll_accum_y < 0.0 and delta > 0.0) {
            p.scroll_accum_y = 0.0
        }
        p.scroll_accum_y += delta
        if p.scroll_accum_y.abs() >= scroll_step_threshold {
            p.scroll_accum_y = 0.0
            fired = true
        }
    }
    if fired {
        if let Err(err) = dispatch_action(mut p, act) {
            io.eprint("pastel: action error: {err}")
        }
    }
    return true
}

/// 3-finger touchpad swipe: horizontal pan of columns, vertical workspace switch.
/// 4-finger vertical touchpad swipe: toggle Overview thumbnail mode.
/// Other gestures pass straight through to applications.
pub fn on_gesture[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], g: lum.Gesture) -> bool {
    wake_monitors_if_off(mut p)
    guard not p.d.locked() else {
        return false
    }
    match g.kind {
        SwipeBegin => {
            guard (g.fingers == 3 or g.fingers == 4) and not p.desktop.monitors.is_empty() else {
                return false
            }
            p.swipe_active = true
            p.swipe_fingers = g.fingers
            p.swipe_dx = 0.0
            p.swipe_dy = 0.0
            p.swipe_axis = 0
            p.swipe_mon = p.desktop.active_monitor
            p.swipe_ws = p.desktop.monitors[p.swipe_mon].active_ws
            return true
        }
        SwipeUpdate => {
            guard p.swipe_active else {
                return false
            }
            p.swipe_dx += g.dx
            p.swipe_dy += g.dy
            if p.swipe_axis == 0 and (p.swipe_dx.abs() > 10.0 or p.swipe_dy.abs() > 10.0) {
                p.swipe_axis = if p.swipe_dx.abs() >= p.swipe_dy.abs() { 1 } else { 2 }
            }
            if p.swipe_fingers == 3 and p.swipe_axis == 1 and p.swipe_mon < p.desktop.monitors.len() and p.swipe_ws < p.desktop.monitors[p.swipe_mon].workspaces.len() {
                p.desktop.monitors[p.swipe_mon].workspaces[p.swipe_ws].strip.pan(-g.dx * 1.4)
                p.needs_layout = true
            }
            return true
        }
        SwipeEnd => {
            guard p.swipe_active else {
                return false
            }
            let fingers = p.swipe_fingers
            p.swipe_active = false
            p.swipe_fingers = 0
            if fingers == 4 {
                if not g.cancelled and p.swipe_dy.abs() > 35.0 {
                    p.set_overview_open(not p.overview_open, time.now_ns())
                }
                p.swipe_axis = 0
                return true
            }
            // Always finish horizontal pan on the originating workspace, even if the gesture was cancelled,
            // so `manual_pan` can never remain stuck true.
            if p.swipe_axis == 1 and p.swipe_mon < p.desktop.monitors.len() and p.swipe_ws < p.desktop.monitors[p.swipe_mon].workspaces.len() {
                let area = p.desktop.monitors[p.swipe_mon].usable_rect
                let gap = p.desktop.gap
                p.desktop.monitors[p.swipe_mon].workspaces[p.swipe_ws].strip.pan_end(area, gap)
                p.sync_focus()
                p.needs_layout = true
            } else if not g.cancelled and p.swipe_axis == 2 and p.swipe_dy.abs() > 35.0 and not p.desktop.monitors.is_empty() {
                let dir = if p.swipe_dy > 0.0 { -1 } else { 1 }
                if p.desktop.focus_workspace_rel(dir) {
                    notify_ws_change(mut p, time.now_ns())
                }
            }
            p.swipe_axis = 0
            return true
        }
        _ => {
            return false
        }
    }
}
