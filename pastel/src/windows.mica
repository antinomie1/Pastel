// Window lifecycle, rule resolution, auto-floating dialogs, maximize/fullscreen, and moves.

import std.json
import std.mem
import std.time
import luminaria as lum
import pastel_core as core
import pastel_layout as lay
import compositor

pub fn window_id(w: lum.Window) -> u64 {
    return (u64(w.id.index) << 32) | u64(w.id.gen)
}

/// Resolve rules for `w` and cache them by window id.
pub fn resolve_rules[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window) {
    let id = window_id(w)
    let rule = p.cfg.resolve_window(p.d.app_id(w), p.d.title(w))
    discard p.win_rules.insert(id, rule)
}

/// New unmapped window: request server-side borders and send an initial configure.
pub fn on_window_new[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window) {
    let id = window_id(w)
    discard p.win_by_id.insert(id, w)
    discard p.id_by_win.insert(w, id)
    resolve_rules(mut p, w)
    // Prefer server-side decorations (Pastel's GPU SDF hollow border) unless client insists on CSD.
    p.d.decorate(w, true)
    let rule = p.win_rules.get(id).unwrap_or(p.cfg.resolve_window("", ""))
    let is_dialog = p.d.parent(w).is_some() or p.d.modal(w)
    let float = rule.floating.unwrap_or(is_dialog)
    if float or p.desktop.monitors.is_empty() {
        discard p.d.configure(w, 0, 0, lum.States { activated: true })
    } else {
        let u = p.desktop.monitors[p.desktop.active_monitor].usable_rect
        let cw = i32(lay.column.width_for_frac(u.w, p.desktop.gap, rule.default_width))
        let ch = i32(max((u.h - p.desktop.gap * 2.0).floor(), 128.0))
        discard p.d.configure(w, cw, ch, lum.States { activated: true, tiled_left: true, tiled_right: true, tiled_top: true, tiled_bottom: true })
    }
}

/// Window committed its first buffer: add to layout, animate open, focus, and emit IPC event.
pub fn on_window_mapped[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window) {
    let id = window_id(w)
    discard p.win_by_id.insert(id, w)
    discard p.id_by_win.insert(w, id)
    resolve_rules(mut p, w)
    guard p.desktop.locate(id).is_none() else {
        p.needs_layout = true
        return
    }
    let rule = p.win_rules.get(id).unwrap_or(p.cfg.resolve_window("", ""))
    let is_dialog = p.d.parent(w).is_some() or p.d.modal(w)
    let float = rule.floating.unwrap_or(is_dialog)
    let (nw, nh) = p.d.size(w)
    p.desktop.add_window(id, float, rule.default_width, f64(nw), f64(nh), rule.workspace)

    // Precompute target rect so the open animation starts in place with subtle scale + fade.
    var targets = mem.replace(mut p.targets_scratch, [])
    p.desktop.compute_all(mut targets)
    let now = time.now_ns()
    let ac = p.cfg.animation
    let wc = p.cfg.window
    for t in targets {
        if t.id == id {
            p.anims.open_window(id, t.rect, rule.opacity, t.focused, ac, wc, now)
            break
        }
    }
    p.targets_scratch = targets
    p.broadcast_event("window-opened", json.obj().with("id", json.Value.Int(int(id))).with("app_id", json.Value.Str(p.d.app_id(w))).with("title", json.Value.Str(p.d.title(w))))
    p.needs_layout = true
    p.sync_focus()
}

/// Window closed or unmapped: remove from layout and shift focus cleanly.
pub fn on_window_unmapped[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window) {
    let id = window_id(w)
    discard p.desktop.remove_window(id)
    p.anims.remove_window(id)
    discard p.win_rules.remove(id)
    discard p.win_by_id.remove(id)
    discard p.id_by_win.remove(w)
    discard p.configured_sizes.remove(id)
    p.broadcast_event("window-closed", json.obj().with("id", json.Value.Int(int(id))))
    p.needs_layout = true
    p.sync_focus()
}

pub fn on_window_meta[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window) {
    resolve_rules(mut p, w)
    p.needs_layout = true
}

pub fn on_request_maximize[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window, on: bool) {
    let id = window_id(w)
    if let Some(loc) = p.desktop.locate(id) {
        if not loc.floating {
            discard p.desktop.monitors[loc.monitor_idx].workspaces[loc.workspace_idx].strip.toggle_maximize_column()
            p.needs_layout = true
            return
        }
    }
    discard on
    p.needs_layout = true
}

pub fn on_request_fullscreen[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window, on: bool) {
    let id = window_id(w)
    if p.desktop.set_fullscreen(id, on) {
        p.needs_layout = true
    }
}

pub fn on_moved[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window, dx: f64, dy: f64) {
    let id = window_id(w)
    if let Some(loc) = p.desktop.locate(id) {
        if loc.floating {
            discard p.desktop.monitors[loc.monitor_idx].workspaces[loc.workspace_idx].move_floating(id, dx, dy)
            // Snap animated rect immediately after interactive pointer move so there is no lag-back.
            if let Some(fi_rect) = floating_rect(p, loc.monitor_idx, loc.workspace_idx, id) {
                if let Some(wa) = p.anims.windows.get(id) {
                    var copy = wa
                    copy.rect.snap(fi_rect)
                    discard p.anims.windows.insert(id, copy)
                }
            }
            p.needs_layout = true
        }
    }
}

pub fn on_resized[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window, dx: f64, dy: f64, width: i32, height: i32) {
    let id = window_id(w)
    if let Some(loc) = p.desktop.locate(id) {
        if loc.floating {
            discard p.desktop.monitors[loc.monitor_idx].workspaces[loc.workspace_idx].resize_floating(id, dx, dy, f64(width), f64(height))
            if let Some(fi_rect) = floating_rect(p, loc.monitor_idx, loc.workspace_idx, id) {
                if let Some(wa) = p.anims.windows.get(id) {
                    var copy = wa
                    copy.rect.snap(fi_rect)
                    discard p.anims.windows.insert(id, copy)
                }
            }
            p.needs_layout = true
        }
    }
}

fn floating_rect[O: lum.plug.Output, R: lum.plug.Renderer](p: compositor.Pastel[O, R], mi: int, wi: int, id: u64) -> Option[core.Rect] {
    let fi = p.desktop.monitors[mi].workspaces[wi].find_floating(id)
    guard fi >= 0 else {
        return None
    }
    return Some(p.desktop.monitors[mi].workspaces[wi].floating[fi].rect)
}
