// Window lifecycle, rule resolution, late-rule application, auto-floating dialogs, maximize/fullscreen, and moves.

import std.json
import std.mem
import std.time
import luminaria as lum
import pastel_core as core
import pastel_layout as lay
import compositor
import outputs

pub fn window_id(w: lum.Window) -> u64 {
    return (u64(w.id.index) << 32) | u64(w.id.gen)
}

/// Resolve rules for `w` and cache them by window id.
pub fn resolve_rules[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window) {
    let id = window_id(w)
    let rule = p.cfg.resolve_window(p.d.app_id(w), p.d.title(w))
    discard p.win_rules.insert(id, rule)
}

/// New unmapped window: request server-side borders and send an initial configure.
pub fn on_window_new[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window) {
    let id = window_id(w)
    discard p.win_by_id.insert(id, w)
    discard p.id_by_win.insert(w, id)
    resolve_rules(mut p, w)
    // Prefer server-side decorations (Pastel's GPU SDF hollow border) unless client insists on CSD.
    p.d.decorate(w, true)
    let rule = p.win_rules.get(id).unwrap_or(p.cfg.resolve_window("", ""))
    let is_dialog = p.d.parent(w).is_some() or p.d.modal(w)
    let float = rule.floating.unwrap_or(is_dialog)
    if float or p.desktop.monitors.is_empty() {
        let fw = i32(rule.default_floating_w.unwrap_or(0.0).round())
        let fh = i32(rule.default_floating_h.unwrap_or(0.0).round())
        discard p.d.configure(w, fw, fh, lum.States { activated: rule.open_focused })
    } else {
        let named_mi = p.desktop.find_monitor_by_name(rule.monitor)
        let mi = if named_mi >= 0 { named_mi } else { p.desktop.active_monitor }
        let u = p.desktop.monitors[mi].usable_rect
        let cw = i32(lay.column.width_for_frac(u.w, p.desktop.gap, rule.default_width))
        let ch = i32(max((u.h - p.desktop.gap * 2.0).floor(), 128.0))
        discard p.d.configure(w, cw, ch, lum.States { activated: rule.open_focused, tiled_left: true, tiled_right: true, tiled_top: true, tiled_bottom: true })
    }
}

/// Window committed its first buffer: add to layout, apply initial rules, animate open, focus, and emit IPC event.
pub fn on_window_mapped[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window) {
    let id = window_id(w)
    discard p.win_by_id.insert(id, w)
    discard p.id_by_win.insert(w, id)
    resolve_rules(mut p, w)
    guard p.desktop.locate(id).is_none() else {
        p.needs_layout = true
        return
    }
    let app_id = p.d.app_id(w)
    let title = p.d.title(w)
    discard p.meta_rule_done.insert(id, not app_id.is_empty() or not title.is_empty())
    let rule = p.win_rules.get(id).unwrap_or(p.cfg.resolve_window("", ""))
    let is_dialog = p.d.parent(w).is_some() or p.d.modal(w)
    let float = rule.floating.unwrap_or(is_dialog)
    let (nw, nh) = p.d.size(w)
    let eff_nw = rule.default_floating_w.unwrap_or(f64(nw))
    let eff_nh = rule.default_floating_h.unwrap_or(f64(nh))
    p.desktop.add_window_full(id, float, rule.default_width, eff_nw, eff_nh, rule.monitor, rule.workspace, rule.open_focused)
    if let Some(want_max) = rule.maximized {
        discard p.desktop.set_maximized(id, want_max)
    }
    if let Some(want_fs) = rule.fullscreen {
        discard p.desktop.set_fullscreen(id, want_fs)
    }

    // Precompute target rect so the open animation starts in place with subtle scale + fade.
    var targets = mem.replace(mut p.targets_scratch, [])
    p.desktop.compute_all(mut targets)
    let now = time.now_ns()
    let ac = p.cfg.animation
    let wc = p.cfg.window
    for t in targets {
        if t.id == id {
            p.anims.open_window(id, t.rect, rule.opacity, t.focused, ac, wc, now)
            break
        }
    }
    p.targets_scratch = targets
    p.broadcast_event("window-opened", json.obj().with("id", json.Value.Int(int(id))).with("app_id", json.Value.Str(app_id)).with("title", json.Value.Str(title)))
    p.needs_layout = true
    p.sync_focus()
}

/// Window closed or unmapped: run `[animation].window-close`, remove from layout, and emit one IPC event.
pub fn on_window_unmapped[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window) {
    let id = window_id(w)
    let loc = p.desktop.locate(id)
    let was_managed = loc.is_some()
    if let Some(l) = loc {
        let rule = p.win_rules.get(id).unwrap_or(p.cfg.resolve_window("", ""))
        let is_fs = l.monitor_idx < p.desktop.monitors.len() and l.workspace_idx < p.desktop.monitors[l.monitor_idx].workspaces.len() and p.desktop.monitors[l.monitor_idx].workspaces[l.workspace_idx].fullscreen == Some(id)
        let rad = if is_fs { f32(0.0) } else { rule.corner_radius }
        let bw = if is_fs { f32(0.0) } else { rule.border_width }
        let shd = if is_fs { f32(0.0) } else { p.cfg.window.shadow_size }
        p.anims.close_window(id, rad, bw, shd, p.cfg.window.shadow_color, l.monitor_idx, p.cfg.animation, time.now_ns())
    } else {
        p.anims.remove_window(id)
    }
    let removed = p.desktop.remove_window(id)
    discard p.win_rules.remove(id)
    discard p.meta_rule_done.remove(id)
    discard p.win_by_id.remove(id)
    discard p.id_by_win.remove(w)
    discard p.configured_sizes.remove(id)
    if was_managed or removed {
        p.broadcast_event("window-closed", json.obj().with("id", json.Value.Int(int(id))))
        p.needs_layout = true
        p.sync_focus()
    }
}

/// Re-evaluate rules when `app_id` or `title` updates. If metadata arrived after initial map
/// (common for browsers, Electron, and XWayland apps), apply structural rules once cleanly.
pub fn on_window_meta[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window) {
    let id = window_id(w)
    resolve_rules(mut p, w)
    let already = p.meta_rule_done.get(id).unwrap_or(false)
    let app_id = p.d.app_id(w)
    let title = p.d.title(w)
    if not already and (not app_id.is_empty() or not title.is_empty()) and p.desktop.locate(id).is_some() {
        discard p.meta_rule_done.insert(id, true)
        if let Some(rule) = p.win_rules.get(id) {
            if p.desktop.apply_late_rule(id, rule.floating, rule.fullscreen, rule.maximized, rule.default_width, rule.monitor, rule.workspace) {
                p.sync_focus()
            }
        }
    }
    p.needs_layout = true
}

/// Respect client `xdg_toplevel.set_maximized` / `unset_maximized` on the requesting window's column.
pub fn on_request_maximize[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window, on: bool) {
    let id = window_id(w)
    if p.desktop.set_maximized(id, on) {
        p.needs_layout = true
    }
}

/// Respect client `xdg_toplevel.set_fullscreen` / `unset_fullscreen`, including optional target output.
pub fn on_request_fullscreen[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window, target_out: Option[lum.Output], on: bool) {
    let id = window_id(w)
    if on {
        if let Some(so) = target_out {
            discard p.desktop.move_window_to_monitor(id, outputs.output_id(so))
        }
    }
    if p.desktop.set_fullscreen(id, on) {
        p.sync_focus()
        p.needs_layout = true
    }
}

pub fn on_moved[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window, dx: f64, dy: f64) {
    let id = window_id(w)
    if let Some(loc) = p.desktop.locate(id) {
        if loc.floating {
            discard p.desktop.monitors[loc.monitor_idx].workspaces[loc.workspace_idx].move_floating(id, dx, dy)
            // Snap animated rect immediately after interactive pointer move so there is no lag-back,
            // and transfer monitor ownership if the window's center crossed onto another monitor.
            if let Some(fi_rect) = floating_rect(p, loc.monitor_idx, loc.workspace_idx, id) {
                if let Some(wa) = p.anims.windows.get(id) {
                    var copy = wa
                    copy.rect.snap(fi_rect)
                    discard p.anims.windows.insert(id, copy)
                }
                let c = fi_rect.center()
                let dst_mi = p.desktop.monitor_at(c.x, c.y)
                if dst_mi >= 0 and dst_mi != loc.monitor_idx {
                    if p.desktop.relocate_floating_to_monitor(id, dst_mi) {
                        p.sync_focus()
                    }
                }
            }
            p.needs_layout = true
        }
    }
}

pub fn on_resized[O: lum.plug.Output, R: lum.plug.Renderer](mut p: compositor.Pastel[O, R], w: lum.Window, dx: f64, dy: f64, width: i32, height: i32) {
    let id = window_id(w)
    if let Some(loc) = p.desktop.locate(id) {
        if loc.floating {
            discard p.desktop.monitors[loc.monitor_idx].workspaces[loc.workspace_idx].resize_floating(id, dx, dy, f64(width), f64(height))
            if let Some(fi_rect) = floating_rect(p, loc.monitor_idx, loc.workspace_idx, id) {
                if let Some(wa) = p.anims.windows.get(id) {
                    var copy = wa
                    copy.rect.snap(fi_rect)
                    discard p.anims.windows.insert(id, copy)
                }
            }
            p.needs_layout = true
        }
    }
}

fn floating_rect[O: lum.plug.Output, R: lum.plug.Renderer](p: compositor.Pastel[O, R], mi: int, wi: int, id: u64) -> Option[core.Rect] {
    let fi = p.desktop.monitors[mi].workspaces[wi].find_floating(id)
    guard fi >= 0 else {
        return None
    }
    return Some(p.desktop.monitors[mi].workspaces[wi].floating[fi].rect)
}
