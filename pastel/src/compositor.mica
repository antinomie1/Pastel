// Pastel[O, R]: monomorphized compositor core wiring luminaria, layout, render, animations, and IPC.

import std.collections.map
import std.io
import std.json
import std.mem
import std.time
import luminaria as lum
import pastel_core as core
import pastel_config as cfg
import pastel_layout as lay
import pastel_render as ren
import pastel_ipc as ipc
import outputs
import windows
import input
import reload
import spawn

let tok_ipc_listen = 1
let tok_cfg_watch = 2
let tok_sighup = 3
pub let tok_cursor_hide = 4
let tok_ipc_client_base = 1000

fn ikey(img: lum.Image) -> u64 {
    return (u64(1) << 63) | (u64(img.index) << 32) | u64(img.gen)
}

/// O(1) compiled input binding dispatch tables with 16-bit modifier bitmasks so
/// unbound typing/gaming keys, clicks, and scrolls reject in a single bit test.
pub struct BindIndex {
    pub key_map: map.Map[u64, int]
    pub locked_key_map: map.Map[u64, int]
    pub button_map: map.Map[u64, int]
    pub wheel_map: map.Map[u64, int]
    pub key_mod_mask: u16 = 0
    pub locked_mod_mask: u16 = 0
    pub button_mod_mask: u16 = 0
    pub wheel_mod_mask: u16 = 0
}

pub fn BindIndex.new() -> BindIndex {
    return BindIndex {
        key_map: map.Map.new(),
        locked_key_map: map.Map.new(),
        button_map: map.Map.new(),
        wheel_map: map.Map.new(),
    }
}

pub struct Pastel[O: lum.plug.Output, R: lum.plug.Renderer] {
    pub d: lum.display.Display[O, R]
    pub cfg: cfg.Config
    pub cfg_path: str
    pub nested: bool
    pub sheet: ren.EffectSheet
    pub desktop: lay.Desktop
    pub anims: ren.AnimState
    pub win_by_id: map.Map[u64, lum.Window]
    pub id_by_win: map.Map[lum.Window, u64]
    pub win_rules: map.Map[u64, cfg.ResolvedWindow]
    pub meta_rule_done: map.Map[u64, bool]
    pub initial_sizes: map.Map[u64, (i32, i32)]
    pub auto_float_done: map.Map[u64, bool]
    pub pending_fixed_check: List[(u64, int)] = []
    pub configured_sizes: map.Map[u64, (i32, i32, bool, bool, bool, bool)]
    pub pending_fullscreen: map.Map[u64, (bool, Option[lum.Output])]
    pub out_by_id: map.Map[u64, lum.Output]
    pub id_by_out: map.Map[lum.Output, u64]
    pub vrr_state: map.Map[u64, bool]
    pub input_devices: List[(u32, lum.types.DeviceDesc)] = []
    pub suppressed_keys: List[u32] = []
    pub ipc_srv: Option[ipc.IpcServer] = None
    pub ipc_socket_path: str = ""
    pub xwayland_display: str = ""
    pub xwayland_pid: int = 0
    pub cfg_watch: Option[reload.ConfigWatcher] = None
    pub sig_watch: Option[reload.SignalWatcher] = None
    pub monitors_powered: bool = true
    pub overview_open: bool = false
    pub overview_bands: List[lay.OverviewBand] = []
    pub cursor_hidden: bool = false
    pub cursor_last_motion_ns: int = 0
    pub cursor_timer_pending: bool = false
    pub overlay_visible: bool = false
    pub overlay_img: Option[lum.Image] = None
    pub overlay_w: f64 = 0.0
    pub overlay_h: f64 = 0.0
    pub overlay_scale: f64 = 1.0
    pub last_anim_ns: int = 0
    /// When a layout transaction opened (0: none): its animations start
    /// with the first frame after it.
    pub held_since: int = 0
    pub targets_scratch: List[lay.TileTarget] = []
    pub overview_targets_scratch: List[lay.TileTarget] = []
    pub closing_scratch: List[ren.ClosingFrame] = []
    pub place_scratch: List[(lum.Window, Option[lum.Output], f64, f64, f32, f32, f32, f32, bool)] = []
    pub ws_off_scratch: List[f64] = []
    pub scroll_accum_x: f64 = 0.0
    pub scroll_accum_y: f64 = 0.0
    pub swipe_active: bool = false
    pub swipe_fingers: int = 0
    pub swipe_dx: f64 = 0.0
    pub swipe_dy: f64 = 0.0
    pub swipe_axis: int = 0
    pub swipe_mon: int = 0
    pub swipe_ws: int = 0
    pub last_focus_id: u64 = 0
    pub needs_layout: bool = true
    pub overlay_dirty: bool = true
    pub default_visual: (f32, bool, f32, f32, bool) = (1.0, true, 0.0, 2.0, false)
    pub has_rules: bool = false
    pub has_title_rules: bool = false
    pub has_vrr_ondemand: bool = false
    pub cached_outputs: List[(f64, f64, f64, f64, f64, u64)] = []
    pub cached_out_handles: List[lum.Output] = []
    pub mon_to_out: List[int] = []
    pub mon_vrr_ondemand: List[bool] = []
    pub bind_index: BindIndex
    pub focus_cfgs_scratch: List[(lum.Window, u64, i32, i32, lum.States, (i32, i32, bool, bool, bool, bool))] = []
    pub geom_cfgs_scratch: List[(lum.Window, u64, i32, i32, lum.States, (i32, i32, bool, bool, bool, bool))] = []
    pub win_draw_scratch: List[(Option[lum.Window], f32, bool, f32, f32, bool)] = []
    pub out_effects_scratch: List[List[ren.WindowEffect]] = []
    pub out_closing_scratch: List[List[ren.ClosingEffect]] = []
    pub out_tabs_scratch: List[List[ren.TabBar]] = []
    pub out_frames_scratch: List[List[ren.OverviewFrame]] = []
    pub ov_idx_scratch: map.Map[u64, int]
    pub ov_seen_scratch: List[bool] = []
}

pub fn Pastel[O, R].new(take d: lum.display.Display[O, R], take config: cfg.Config, cfg_path: str, nested: bool, sheet: ren.EffectSheet) -> Pastel[O, R] {
    var desk = lay.Desktop.new(
        config.layout.workspaces,
        config.layout.gap,
        config.layout.default_width,
        reload.center_mode(config.layout.center_focus),
    )
    desk.set_always_center_single(config.layout.always_center_single_column)
    var p = Pastel {
        d,
        cfg: config,
        cfg_path: cfg_path.clone(),
        nested,
        sheet: sheet.clone(),
        desktop: desk,
        anims: ren.AnimState.new(),
        win_by_id: map.Map.new(),
        id_by_win: map.Map.new(),
        win_rules: map.Map.new(),
        meta_rule_done: map.Map.new(),
        initial_sizes: map.Map.new(),
        auto_float_done: map.Map.new(),
        configured_sizes: map.Map.new(),
        pending_fullscreen: map.Map.new(),
        out_by_id: map.Map.new(),
        id_by_out: map.Map.new(),
        vrr_state: map.Map.new(),
        bind_index: BindIndex.new(),
        ov_idx_scratch: map.Map.new(),
    }
    p.sync_config_caches()
    outputs.apply_keymap(mut p, false)
    for so in p.d.outputs() {
        outputs.apply_output_config(mut p, so)
    }
    outputs.sync_outputs(mut p)
    if p.cfg.overlay.at_startup {
        p.set_overlay_visible(true, time.now_ns())
    }
    p.sync_layout(time.now_ns())
    return p
}

/// Recompute derived config caches (default window visuals, rule flags, VRR flag, O(1) bind index).
pub fn Pastel[O, R].sync_config_caches(mut self) {
    let def = self.cfg.resolve_window("", "")
    self.default_visual = (def.opacity, def.blur, def.corner_radius, def.border_width, def.block_out_from_screencast)
    self.has_rules = not self.cfg.rules.is_empty()
    var title_rules = false
    for r in self.cfg.rules {
        if not r.title.is_empty() {
            title_rules = true
            break
        }
    }
    self.has_title_rules = title_rules
    var vrr_od = false
    for o in self.cfg.outputs {
        if o.vrr == Some(cfg.VrrMode.OnDemand) {
            vrr_od = true
            break
        }
    }
    self.has_vrr_ondemand = vrr_od
    input.rebuild_bind_index(mut self)
}

/// True when at least one IPC client is subscribed to compositor events.
pub fn Pastel[O, R].has_ipc_subscribers(self) -> bool {
    return match self.ipc_srv {
        Some(srv) => srv.has_subscribers()
        None => false
    }
}

/// Start listening on the Unix JSON-lines IPC socket and register its fd with `Display.watch`.
pub fn Pastel[O, R].enable_ipc(mut self) {
    let sp = ipc.socket_path(self.d.socket())
    match ipc.IpcServer.open(sp.clone()) {
        Ok(srv) => {
            self.d.watch(srv.fd(), tok_ipc_listen)
            self.ipc_socket_path = sp
            self.ipc_srv = Some(srv)
            io.eprint("pastel: IPC socket={self.ipc_socket_path}")
        }
        Err(e) => io.eprint("pastel: IPC disabled ({e})")
    }
}

/// Watch `self.cfg_path` via Linux inotify so saving the config file reloads live (0 wakeups when idle).
pub fn Pastel[O, R].enable_config_watch(mut self) {
    if let Some(w) = reload.ConfigWatcher.open(self.cfg_path) {
        self.d.watch(w.fd, tok_cfg_watch)
        self.cfg_watch = Some(w)
    }
}

/// Watch SIGHUP via Linux signalfd registered with `Display.watch` (immediate wakeup, 0 polling).
pub fn Pastel[O, R].enable_signal_watch(mut self) -> bool {
    if let Some(sw) = reload.SignalWatcher.open_sighup() {
        self.d.watch(sw.fd, tok_sighup)
        self.sig_watch = Some(sw)
        return true
    }
    return false
}

/// Run configured `autostart` commands, session env export, and optional `xwayland-satellite`.
pub fn Pastel[O, R].run_startup(mut self, extra_cmd: str) {
    let sock = self.d.socket()
    if self.cfg.xwayland.enabled {
        let (disp, pid) = spawn.start_xwayland(self.cfg.xwayland, sock)
        self.xwayland_display = disp
        self.xwayland_pid = pid
    }
    spawn.export_session_env(sock, self.xwayland_display.clone(), self.nested, self.cfg.env)
    let extra_env = self.cfg.env.clone()
    for cmd in self.cfg.autostart.clone() {
        let tok = self.d.activation_token()
        spawn.spawn_shell(cmd, sock, self.ipc_socket_path.clone(), self.xwayland_display.clone(), tok, extra_env)
    }
    if not extra_cmd.is_empty() {
        let tok = self.d.activation_token()
        spawn.spawn_shell(extra_cmd, sock, self.ipc_socket_path.clone(), self.xwayland_display.clone(), tok, extra_env)
    }
}

/// Rasterize and upload the hotkey overlay texture styled consistently with `self.cfg`.
pub fn Pastel[O, R].rebuild_overlay(mut self) {
    if let Some(old) = self.overlay_img.take() {
        self.d.drop_image(old)
    }
    let eff_mod = if self.nested { self.cfg.input.nested_mod } else { self.cfg.input.mod_key }
    let scale = max(outputs.active_output_scale(self), 1.0)
    self.overlay_scale = scale
    self.overlay_dirty = false
    guard let Some(img_data) = ren.overlay.render_hotkey_overlay(self.cfg, eff_mod, scale) else {
        io.eprint("pastel: hotkey overlay: no font found for '{self.cfg.overlay.font}'")
        return
    }
    if let Ok(handle) = self.d.image(img_data.width, img_data.height, img_data.pixels, false) {
        self.overlay_img = Some(handle)
        self.overlay_w = f64(img_data.width) / f64(img_data.scale)
        self.overlay_h = f64(img_data.height) / f64(img_data.scale)
    }
}

/// Rebuild the hotkey overlay immediately if currently shown, or drop its GPU texture
/// and mark dirty for lazy rasterization next time it is opened.
pub fn Pastel[O, R].invalidate_overlay(mut self) {
    if self.overlay_visible {
        self.rebuild_overlay()
    } else {
        if let Some(old) = self.overlay_img.take() {
            self.d.drop_image(old)
        }
        self.overlay_w = 0.0
        self.overlay_h = 0.0
        self.overlay_dirty = true
    }
}

pub fn Pastel[O, R].set_overlay_visible(mut self, on: bool, now_ns: int) {
    if on and (self.overlay_dirty or self.overlay_img.is_none()) {
        self.rebuild_overlay()
    }
    self.overlay_visible = on
    let ac = self.cfg.animation
    self.anims.set_overlay(on, ac, now_ns)
    self.needs_layout = true
}

pub fn Pastel[O, R].set_overview_open(mut self, on: bool, now_ns: int) {
    if self.overview_open == on {
        return
    }
    self.overview_open = on
    if on and self.overlay_visible {
        self.set_overlay_visible(false, now_ns)
    }
    let ac = self.cfg.animation
    self.anims.set_overview(on, ac, now_ns)
    self.needs_layout = true
    if self.has_ipc_subscribers() {
        self.broadcast_event("overview-changed", json.obj().with("open", json.Value.Bool(on)))
    }
}

pub fn Pastel[O, R].broadcast_event(mut self, kind: str, take detail: json.Value) {
    guard self.has_ipc_subscribers() else {
        return
    }
    guard let Some(got) = self.ipc_srv.take() else {
        return
    }
    var srv = got
    let payload = ipc.server.encode_event(kind, detail)
    let dropped = srv.broadcast(payload)
    for fd in dropped {
        self.d.unwatch(fd)
    }
    self.ipc_srv = Some(srv)
}

/// Notify IPC subscribers that a window's state (maximized, fullscreen, floating, tabbed,
/// title/app_id, workspace, or monitor) changed so status bars refresh immediately.
pub fn Pastel[O, R].broadcast_window_changed(mut self, id: u64) {
    guard self.has_ipc_subscribers() else {
        return
    }
    self.broadcast_event("window-changed", json.obj().with("id", json.Value.Int(int(id))))
}

/// Synchronize Wayland keyboard focus with `self.desktop.focused_window()`.
pub fn Pastel[O, R].sync_focus(mut self) {
    let want = self.desktop.focused_window().unwrap_or(0)
    if want == 0 {
        self.d.focus(None)
    } else if let Some(w) = self.win_by_id.get(want) {
        self.d.focus(Some(w))
    }
    if want != self.last_focus_id {
        self.last_focus_id = want
        if self.has_ipc_subscribers() {
            self.broadcast_event("focus-changed", json.obj().with("window_id", json.Value.Int(int(want))))
        }
    }
}

/// Build a JSON snapshot of monitors, workspaces, and windows for `pastel msg --state`.
pub fn Pastel[O, R].state_json(self) -> str {
    var mons = json.arr()
    for mi in 0..self.desktop.monitors.len() {
        let active_ws = self.desktop.monitors[mi].active_ws + 1
        let ws_count = self.desktop.monitors[mi].workspaces.len()
        let full = self.desktop.monitors[mi].full_rect
        var scale = 1.0
        var hdr_on = false
        let oi = if mi < self.mon_to_out.len() { self.mon_to_out[mi] } else { -1 }
        if oi >= 0 and oi < self.cached_outputs.len() {
            scale = self.cached_outputs[oi].4
            hdr_on = self.d.hdr(self.cached_out_handles[oi])
        } else if let Some(so) = self.out_by_id.get(self.desktop.monitors[mi].id) {
            let (_, _, ow, oh) = self.d.output_rect(so)
            let desc = self.d.output_desc(so)
            scale = outputs.output_scale(ow, oh, desc.mode)
            hdr_on = self.d.hdr(so)
        }
        let mobj = json.obj().with("name", json.Value.Str(self.desktop.monitors[mi].name.clone())).with("x", json.Value.Num(full.x)).with("y", json.Value.Num(full.y)).with("width", json.Value.Num(full.w)).with("height", json.Value.Num(full.h)).with("scale", json.Value.Num(scale)).with("hdr", json.Value.Bool(hdr_on)).with("active_workspace", json.Value.Int(active_ws)).with("workspaces", json.Value.Int(ws_count)).with("focused", json.Value.Bool(mi == self.desktop.active_monitor))
        mons = mons.append(mobj)
    }
    // Pre-index only maximized or tabbed columns in a single O(N) pass so window assembly stays O(N).
    var col_flags: map.Map[u64, (bool, bool)] = map.Map.new()
    for mi in 0..self.desktop.monitors.len() {
        for wi in 0..self.desktop.monitors[mi].workspaces.len() {
            for ci in 0..self.desktop.monitors[mi].workspaces[wi].strip.columns.len() {
                let c_max = self.desktop.monitors[mi].workspaces[wi].strip.columns[ci].maximized
                let c_tab = self.desktop.monitors[mi].workspaces[wi].strip.columns[ci].tabbed
                if c_max or c_tab {
                    for slot in self.desktop.monitors[mi].workspaces[wi].strip.columns[ci].windows {
                        discard col_flags.insert(slot.id, (c_max, c_tab))
                    }
                }
            }
        }
    }
    let focused_opt = self.desktop.focused_window()
    let has_col_flags = not col_flags.is_empty()
    var wins = json.arr()
    for e in self.win_by_id.entries() {
        let id = e.key
        let w = e.val
        let loc = self.desktop.locate(id)
        var mon_name = ""
        var is_fs = false
        var is_max = false
        var is_tab = false
        var is_float = false
        var ws_num = 0
        if let Some(l) = loc {
            is_float = l.floating
            ws_num = l.workspace_idx + 1
            if l.monitor_idx < self.desktop.monitors.len() {
                mon_name = self.desktop.monitors[l.monitor_idx].name.clone()
                if l.workspace_idx < self.desktop.monitors[l.monitor_idx].workspaces.len() {
                    is_fs = self.desktop.monitors[l.monitor_idx].workspaces[l.workspace_idx].fullscreen == Some(id)
                }
            }
            if not is_float and has_col_flags {
                if let Some((cm, ct)) = col_flags.get(id) {
                    is_max = cm
                    is_tab = ct
                }
            }
        }
        let blocked = if self.has_rules {
            self.win_rules.with(id, fn(r) => r.block_out_from_screencast).unwrap_or(self.default_visual.4)
        } else {
            self.default_visual.4
        }
        let (cw, ch) = self.d.size(w)
        let wobj = json.obj().with("id", json.Value.Int(int(id))).with("app_id", json.Value.Str(self.d.app_id(w))).with("title", json.Value.Str(self.d.title(w))).with("monitor", json.Value.Str(mon_name)).with("focused", json.Value.Bool(focused_opt == Some(id))).with("floating", json.Value.Bool(is_float)).with("fullscreen", json.Value.Bool(is_fs)).with("maximized", json.Value.Bool(is_max)).with("tabbed", json.Value.Bool(is_tab)).with("block_out_from_screencast", json.Value.Bool(blocked)).with("width", json.Value.Int(int(cw))).with("height", json.Value.Int(int(ch))).with("workspace", json.Value.Int(ws_num))
        wins = wins.append(wobj)
    }
    let root = json.obj().with("ok", json.Value.Bool(true)).with("focused_window", json.Value.Int(int(focused_opt.unwrap_or(0)))).with("overlay_visible", json.Value.Bool(self.overlay_visible)).with("overview_open", json.Value.Bool(self.overview_open)).with("monitors_powered", json.Value.Bool(self.monitors_powered)).with("monitors", mons).with("windows", wins)
    return json.encode(root) + "\n"
}

/// Compute layout targets, send any changed configures in a transaction, advance
/// animations to `now_ns`, update the GPU `EffectSheet`, and commit `d.layout`.
pub fn Pastel[O, R].sync_layout(mut self, now_ns: int) {
    self.needs_layout = false
    // Keep animation time monotonic so mid-frame `time.now_ns()` calls never
    // step backwards relative to a prior `Frame(_, vblank_ns)` prediction.
    let anim_ns = max(now_ns, self.last_anim_ns)
    self.last_anim_ns = anim_ns
    if self.has_vrr_ondemand {
        outputs.sync_vrr_on_demand(mut self)
    }
    var targets = mem.replace(mut self.targets_scratch, [])
    self.desktop.compute_all(mut targets)
    let ac = self.cfg.animation
    let wc = self.cfg.window
    let def_vis = self.default_visual
    let has_rules = self.has_rules

    // 1. Update animation targets and send configures only for windows whose size/state changed.
    // Open a brief layout transaction only for geometry/state transitions while idle (or when a
    // newly mapped tiled window receives its first layout size after an initial `(0, 0)` configure)
    // so focus-only changes and ongoing animations never stall behind a configure wait.
    var focus_only_cfgs = mem.replace(mut self.focus_cfgs_scratch, [])
    var geom_cfgs = mem.replace(mut self.geom_cfgs_scratch, [])
    var win_draws = mem.replace(mut self.win_draw_scratch, [])
    focus_only_cfgs.clear()
    geom_cfgs.clear()
    win_draws.clear()
    win_draws.reserve(targets.len())
    var any_initial_tile = false
    for i in 0..targets.len() {
        let t = targets[i]
        let vis = if has_rules {
            self.win_rules.with(t.id, fn(r) => (r.opacity, r.blur, r.corner_radius, r.border_width, r.block_out_from_screencast)).unwrap_or(def_vis)
        } else {
            def_vis
        }
        let w_opt = self.win_by_id.get(t.id)
        win_draws.push((w_opt, vis.0, vis.1, vis.2, vis.3, vis.4))
        self.anims.update_window(t.id, t.rect, vis.0, t.focused, ac, wc, anim_ns)
        if let Some(w) = w_opt {
            let cw = i32(max(t.rect.w.round(), 1.0))
            let ch = i32(max(t.rect.h.round(), 1.0))
            let want = (cw, ch, t.focused, t.fullscreen, t.floating, t.maximized)
            let prev = self.configured_sizes.get(t.id)
            if prev != Some(want) {
                let geom_changed = match prev {
                    Some((pw, ph, _, pfs, pfl, pmax)) => pw != cw or ph != ch or pfs != t.fullscreen or pfl != t.floating or pmax != t.maximized
                    None => false
                }
                let initial_tile = match prev {
                    Some((pw, ph, _, _, pfl, _)) => pw == 0 or ph == 0 or pfl != t.floating
                    None => false
                }
                let tiled = not t.floating and not t.fullscreen
                let st = lum.States {
                    activated: t.focused,
                    fullscreen: t.fullscreen,
                    maximized: t.maximized,
                    tiled_left: tiled,
                    tiled_right: tiled,
                    tiled_top: tiled,
                    tiled_bottom: tiled,
                }
                if geom_changed or initial_tile {
                    if initial_tile {
                        any_initial_tile = true
                    }
                    geom_cfgs.push((w, t.id, cw, ch, st, want))
                } else {
                    focus_only_cfgs.push((w, t.id, cw, ch, st, want))
                }
            }
        }
    }
    for (w, tid, cw, ch, st, want) in focus_only_cfgs {
        discard self.d.configure(w, cw, ch, st)
        discard self.configured_sizes.insert(tid, want)
    }
    var any_size_txn = false
    if not geom_cfgs.is_empty() and (not self.anims.is_active() or any_initial_tile) {
        self.d.begin()
        any_size_txn = true
        self.held_since = anim_ns
    }
    for (w, tid, cw, ch, st, want) in geom_cfgs {
        discard self.d.configure(w, cw, ch, st)
        discard self.configured_sizes.insert(tid, want)
    }
    self.focus_cfgs_scratch = focus_only_cfgs
    self.geom_cfgs_scratch = geom_cfgs

    // 2. Tick animations to `anim_ns` and build placement + per-output visual effect lists.
    self.anims.begin_frame()
    let ov_t = self.anims.tick_overview(anim_ns)
    var ov_targets = mem.replace(mut self.overview_targets_scratch, [])
    var ov_bands = mem.replace(mut self.overview_bands, [])
    var ov_idx = mem.replace(mut self.ov_idx_scratch, map.Map.new())
    var ov_seen = mem.replace(mut self.ov_seen_scratch, [])
    ov_targets.clear()
    ov_bands.clear()
    if ov_t > 0.001 {
        self.desktop.compute_overview(mut ov_targets, mut ov_bands)
        ov_idx.clear()
        ov_seen.clear()
        ov_seen.reserve(ov_targets.len())
        for oi_idx in 0..ov_targets.len() {
            discard ov_idx.insert(ov_targets[oi_idx].id, oi_idx)
            ov_seen.push(false)
        }
    }
    self.overview_bands = ov_bands

    var place_wins = mem.replace(mut self.place_scratch, [])
    place_wins.clear()
    var out_effects = mem.replace(mut self.out_effects_scratch, [])
    var out_closing = mem.replace(mut self.out_closing_scratch, [])
    var out_tabs = mem.replace(mut self.out_tabs_scratch, [])
    var out_frames = mem.replace(mut self.out_frames_scratch, [])
    let n_outs = self.cached_outputs.len()
    while out_effects.len() < n_outs {
        out_effects.push([])
        out_closing.push([])
        out_tabs.push([])
        out_frames.push([])
    }
    out_effects.truncate(n_outs)
    out_closing.truncate(n_outs)
    out_tabs.truncate(n_outs)
    out_frames.truncate(n_outs)
    for oi in 0..n_outs {
        out_effects[oi].clear()
        out_closing[oi].clear()
        out_tabs[oi].clear()
        out_frames[oi].clear()
    }

    // Overview workspace backdrop frames (drawn below thumbnails on each output).
    if ov_t > 0.001 {
        let f_alpha = f32(ov_t)
        let band_fill_act = core.Color.rgba(wc.active_color.r, wc.active_color.g, wc.active_color.b, 0.14 * f_alpha).as_vec4()
        let band_fill_inact = core.Color.rgba(wc.inactive_color.r, wc.inactive_color.g, wc.inactive_color.b, 0.10 * f_alpha).as_vec4()
        let band_bd_act = core.Color.rgba(wc.active_color.r, wc.active_color.g, wc.active_color.b, wc.active_color.a * f_alpha).as_vec4()
        let band_bd_inact = core.Color.rgba(wc.inactive_color.r, wc.inactive_color.g, wc.inactive_color.b, wc.inactive_color.a * 0.65 * f_alpha).as_vec4()
        for band in self.overview_bands {
            guard band.monitor_idx >= 0 and band.monitor_idx < self.mon_to_out.len() else {
                continue
            }
            let oi = self.mon_to_out[band.monitor_idx]
            guard oi >= 0 and oi < n_outs else {
                continue
            }
            let (ox, oy, _, _, scale, _) = self.cached_outputs[oi]
            let bw = if band.active { max(wc.border_width, 2.0) } else { max(wc.border_width * 0.5, 1.0) }
            out_frames[oi].push(ren.OverviewFrame {
                x: f32(((band.rect.x - ox) * scale).round()),
                y: f32(((band.rect.y - oy) * scale).round()),
                w: f32((band.rect.w * scale).round()),
                h: f32((band.rect.h * scale).round()),
                border_width: bw * f32(scale),
                border_color: if band.active { band_bd_act } else { band_bd_inact },
                fill_color: if band.active { band_fill_act } else { band_fill_inact },
                radius: wc.corner_radius * f32(scale),
            })
        }
    }

    // Per-monitor workspace vertical slide offset
    var ws_off_y = mem.replace(mut self.ws_off_scratch, [])
    ws_off_y.clear()
    for mi in 0..self.desktop.monitors.len() {
        ws_off_y.push(self.anims.tick_output_y(self.desktop.monitors[mi].id, anim_ns))
    }

    let shadow_col_v4 = wc.shadow_color.as_vec4()
    let act_col_v4 = wc.active_color.as_vec4()
    let inact_col_v4 = wc.inactive_color.as_vec4()
    let tab_inact_v4 = core.Color.rgba(wc.inactive_color.r, wc.inactive_color.g, wc.inactive_color.b, 0.45).as_vec4()

    for i in 0..targets.len() {
        let t = targets[i]
        let (w_opt, rule_op, rule_blur, rule_cr, rule_bw, rule_block) = win_draws[i]
        guard let Some(w) = w_opt else {
            continue
        }
        let ticked = self.anims.tick_window(t.id, anim_ns)
        var r = t.rect
        var open_sc: f32 = 1.0
        var op = rule_op
        var bc = if t.focused { wc.active_color } else { wc.inactive_color }
        if let Some((ar, asc, aop, abc)) = ticked {
            r = ar
            open_sc = asc
            op = aop
            bc = abc
        }
        let bell_a = self.anims.bell_alpha(t.id, anim_ns)
        if bell_a > 0.001 {
            bc = bc.lerp(core.Color.rgb(1.0, 1.0, 1.0), bell_a * 0.75)
        }
        let loc_mi = t.monitor_idx
        let owner_oi = if loc_mi >= 0 and loc_mi < self.mon_to_out.len() { self.mon_to_out[loc_mi] } else { -1 }
        // Slide by whole physical pixels from a pixel-aligned target: windows
        // moving together keep exact gaps and borders instead of shimmering.
        let k = if owner_oi >= 0 and owner_oi < n_outs and self.cached_outputs[owner_oi].4 > 0.0 { self.cached_outputs[owner_oi].4 } else { 1.0 }
        r.x = snap_px(t.rect.x, k) + snap_px(r.x - t.rect.x, k)
        r.y = snap_px(t.rect.y, k) + snap_px(r.y - t.rect.y, k)
        let wy = if loc_mi >= 0 and loc_mi < ws_off_y.len() and not t.fullscreen { ws_off_y[loc_mi] } else { 0.0 }
        // Center open-scale subtly around the window midpoint.
        var sx = r.x + r.w * (1.0 - f64(open_sc)) * 0.5
        var sy = r.y + wy + r.h * (1.0 - f64(open_sc)) * 0.5
        var ov_sc = 1.0
        if ov_t > 0.001 {
            if let Some(oidx) = ov_idx.get(t.id) {
                let ot = ov_targets[oidx]
                sx = sx + (ot.rect.x - sx) * ov_t
                sy = sy + (ot.rect.y - sy) * ov_t
                ov_sc = 1.0 + (ot.overview_scale - 1.0) * ov_t
                ov_seen[oidx] = true
            }
        }
        let total_sc = f32(f64(open_sc) * ov_sc)

        // Use the client's committed logical geometry size when available so borders
        // hug cell-snapping terminals and floating dialogs tightly.
        let (cw_actual, ch_actual) = self.d.size(w)
        let eff_w = if cw_actual > 0 { f64(cw_actual) } else { r.w }
        let eff_h = if ch_actual > 0 { f64(ch_actual) } else { r.h }
        let vis_w = eff_w * f64(total_sc)
        let vis_h = eff_h * f64(total_sc)

        // Prevent off-screen scrolled columns on one monitor from bleeding onto neighboring monitors.
        let has_owner = loc_mi >= 0 and loc_mi < self.desktop.monitors.len()
        if not t.floating and not t.fullscreen and has_owner {
            let mrect = self.desktop.monitors[loc_mi].full_rect
            if sx >= mrect.right() or sx + vis_w <= mrect.x or sy >= mrect.bottom() or sy + vis_h <= mrect.y {
                continue
            }
        }

        let in_ov = ov_t > 0.05
        let radius = if t.fullscreen and not in_ov { f32(0.0) } else { rule_cr * f32(ov_sc) }
        let shadow = if t.fullscreen and not in_ov { f32(0.0) } else { wc.shadow_size * f32(ov_sc) }
        let bw = if t.fullscreen and not in_ov { f32(0.0) } else { rule_bw }
        let want_blur = not t.fullscreen and not in_ov and wc.blur and rule_blur
        let scoped = (not t.floating or in_ov) and owner_oi >= 0 and owner_oi < n_outs
        let scoped_out = if scoped { Some(self.cached_out_handles[owner_oi]) } else { None }
        place_wins.push((w, scoped_out, sx, sy, op, radius, shadow, total_sc, rule_block))

        let wkey = self.d.window_key(w)
        let bc_v4 = bc.as_vec4()
        let blur_xr = wc.blur_xray and not t.floating
        let show_tab = t.tabbed and not in_ov and not t.fullscreen and not t.floating
        if scoped {
            let (ox, oy, ow, oh, scale, _) = self.cached_outputs[owner_oi]
            if sx < ox + ow and sy < oy + oh and sx + vis_w > ox and sy + vis_h > oy {
                out_effects[owner_oi].push(ren.WindowEffect {
                    key: wkey,
                    x: f32(((sx - ox) * scale).round()),
                    y: f32(((sy - oy) * scale).round()),
                    w: f32((vis_w * scale).round()),
                    h: f32((vis_h * scale).round()),
                    radius: radius * f32(scale),
                    border_width: bw * f32(scale),
                    border_color: bc_v4,
                    shadow_size: shadow * f32(scale),
                    shadow_color: shadow_col_v4,
                    blur: want_blur,
                    blur_xray: blur_xr,
                    blur_opacity: op,
                    is_overlay: t.floating,
                })
                if show_tab {
                    out_tabs[owner_oi].push(ren.TabBar {
                        x: f32(((sx - ox) * scale).round()),
                        y: f32(((sy - 6.0 - oy) * scale).round()),
                        w: f32((vis_w * scale).round()),
                        h: f32((4.0 * scale).round()),
                        count: t.tab_count,
                        active_idx: t.tab_index,
                        active_color: if t.focused { act_col_v4 } else { inact_col_v4 },
                        inactive_color: tab_inact_v4,
                        radius: min(rule_cr, 2.0) * f32(scale),
                    })
                }
            }
        } else {
            for oi in 0..n_outs {
                let (ox, oy, ow, oh, scale, _) = self.cached_outputs[oi]
                if sx < ox + ow and sy < oy + oh and sx + vis_w > ox and sy + vis_h > oy {
                    out_effects[oi].push(ren.WindowEffect {
                        key: wkey,
                        x: f32(((sx - ox) * scale).round()),
                        y: f32(((sy - oy) * scale).round()),
                        w: f32((vis_w * scale).round()),
                        h: f32((vis_h * scale).round()),
                        radius: radius * f32(scale),
                        border_width: bw * f32(scale),
                        border_color: bc_v4,
                        shadow_size: shadow * f32(scale),
                        shadow_color: shadow_col_v4,
                        blur: want_blur,
                        blur_xray: blur_xr,
                        blur_opacity: op,
                        is_overlay: t.floating,
                    })
                }
            }
        }
    }

    // 2a. Non-active workspace thumbnails shown during Overview (zero extra VRAM, uses Style.scale).
    if ov_t > 0.001 {
        for oi_idx in 0..ov_targets.len() {
            if ov_seen[oi_idx] {
                continue
            }
            let ot = ov_targets[oi_idx]
            guard let Some(w) = self.win_by_id.get(ot.id) else {
                continue
            }
            let vis = if has_rules {
                self.win_rules.with(ot.id, fn(r) => (r.opacity, r.blur, r.corner_radius, r.border_width, r.block_out_from_screencast)).unwrap_or(def_vis)
            } else {
                def_vis
            }
            let (cw_actual, ch_actual) = self.d.size(w)
            let ov_sc = ot.overview_scale
            let vis_w = if cw_actual > 0 { f64(cw_actual) * ov_sc } else { ot.rect.w }
            let vis_h = if ch_actual > 0 { f64(ch_actual) * ov_sc } else { ot.rect.h }
            let op = vis.0 * f32(ov_t)
            let radius = vis.2 * f32(ov_sc)
            let shadow = wc.shadow_size * f32(ov_sc)
            let loc_mi = ot.monitor_idx
            let owner_oi = if loc_mi >= 0 and loc_mi < self.mon_to_out.len() { self.mon_to_out[loc_mi] } else { -1 }
            let scoped_out = if owner_oi >= 0 and owner_oi < n_outs { Some(self.cached_out_handles[owner_oi]) } else { None }
            place_wins.push((w, scoped_out, ot.rect.x, ot.rect.y, op, radius, shadow, f32(ov_sc), vis.4))
            let wkey = self.d.window_key(w)
            if owner_oi >= 0 and owner_oi < n_outs {
                let (ox, oy, ow, oh, scale, _) = self.cached_outputs[owner_oi]
                if ot.rect.x < ox + ow and ot.rect.y < oy + oh and ot.rect.x + vis_w > ox and ot.rect.y + vis_h > oy {
                    out_effects[owner_oi].push(ren.WindowEffect {
                        key: wkey,
                        x: f32(((ot.rect.x - ox) * scale).round()),
                        y: f32(((ot.rect.y - oy) * scale).round()),
                        w: f32((vis_w * scale).round()),
                        h: f32((vis_h * scale).round()),
                        radius: radius * f32(scale),
                        border_width: vis.3 * f32(scale),
                        border_color: inact_col_v4,
                        shadow_size: shadow * f32(scale),
                        shadow_color: shadow_col_v4,
                        blur: false,
                        blur_xray: false,
                        blur_opacity: op,
                        is_overlay: ot.floating,
                    })
                }
            }
        }
    }

    // 2b. Closing-window fade+scale ghost animations (`[animation].window-close`).
    var closing_frames = mem.replace(mut self.closing_scratch, [])
    self.anims.tick_closing(anim_ns, mut closing_frames)
    if not closing_frames.is_empty() {
        let close_fill = core.Color.rgba(self.cfg.background.r, self.cfg.background.g, self.cfg.background.b, 0.35).as_vec4()
        for cf in closing_frames {
            let sx = cf.rect.x + cf.rect.w * (1.0 - f64(cf.scale)) * 0.5
            let sy = cf.rect.y + cf.rect.h * (1.0 - f64(cf.scale)) * 0.5
            let sw = cf.rect.w * f64(cf.scale)
            let sh = cf.rect.h * f64(cf.scale)
            let owner_oi = if cf.monitor_idx >= 0 and cf.monitor_idx < self.mon_to_out.len() { self.mon_to_out[cf.monitor_idx] } else { -1 }
            if owner_oi >= 0 and owner_oi < n_outs {
                let (ox, oy, ow, oh, scale, _) = self.cached_outputs[owner_oi]
                if sx < ox + ow and sy < oy + oh and sx + sw > ox and sy + sh > oy {
                    out_closing[owner_oi].push(ren.ClosingEffect {
                        x: f32(((sx - ox) * scale).round()),
                        y: f32(((sy - oy) * scale).round()),
                        w: f32((sw * scale).round()),
                        h: f32((sh * scale).round()),
                        radius: cf.radius * f32(scale),
                        border_width: cf.border_width * f32(scale),
                        border_color: cf.border_color.as_vec4(),
                        shadow_size: cf.shadow_size * f32(scale),
                        shadow_color: cf.shadow_color.as_vec4(),
                        fill_color: close_fill,
                        opacity: cf.opacity,
                    })
                }
            } else {
                for oi in 0..n_outs {
                    let (ox, oy, ow, oh, scale, _) = self.cached_outputs[oi]
                    if sx < ox + ow and sy < oy + oh and sx + sw > ox and sy + sh > oy {
                        out_closing[oi].push(ren.ClosingEffect {
                            x: f32(((sx - ox) * scale).round()),
                            y: f32(((sy - oy) * scale).round()),
                            w: f32((sw * scale).round()),
                            h: f32((sh * scale).round()),
                            radius: cf.radius * f32(scale),
                            border_width: cf.border_width * f32(scale),
                            border_color: cf.border_color.as_vec4(),
                            shadow_size: cf.shadow_size * f32(scale),
                            shadow_color: cf.shadow_color.as_vec4(),
                            fill_color: close_fill,
                            opacity: cf.opacity,
                        })
                    }
                }
            }
        }
    }
    self.closing_scratch = closing_frames

    // 3. Hotkey overlay placement & visually unified effect (inherits [window] & [overlay] styling).
    let (ov_alpha, ov_slide) = self.anims.tick_overlay(anim_ns)
    let ov_eff_alpha = ov_alpha * self.cfg.overlay.opacity
    var show_ov = false
    var ov_x = 0.0
    var ov_y = 0.0
    var ov_w = self.overlay_w
    var ov_h = self.overlay_h
    if ov_eff_alpha > 0.005 {
        if let Some(ov_img) = self.overlay_img {
            if not self.desktop.monitors.is_empty() {
                let u = self.desktop.monitors[self.desktop.active_monitor].usable_rect
                let max_w = max(u.w - 24.0, 120.0)
                let max_h = max(u.h - 24.0, 120.0)
                if ov_w > 0.0 and ov_h > 0.0 {
                    let fit = min(1.0, min(max_w / ov_w, max_h / ov_h))
                    ov_w *= fit
                    ov_h *= fit
                }
                ov_x = u.x + (u.w - ov_w) * 0.5
                ov_y = max(u.y + (u.h - ov_h) * 0.5 + ov_slide, u.y + 8.0)
                show_ov = true
                let ok = ikey(ov_img)
                for oi in 0..n_outs {
                    let (ox, oy, ow, oh, scale, _) = self.cached_outputs[oi]
                    if ov_x < ox + ow and ov_y < oy + oh and ov_x + ov_w > ox and ov_y + ov_h > oy {
                        out_effects[oi].push(ren.WindowEffect {
                            key: ok,
                            x: f32(((ov_x - ox) * scale).round()),
                            y: f32(((ov_y - oy) * scale).round()),
                            w: f32((ov_w * scale).round()),
                            h: f32((ov_h * scale).round()),
                            radius: wc.corner_radius * f32(scale),
                            border_width: wc.border_width * f32(scale),
                            border_color: act_col_v4,
                            shadow_size: wc.shadow_size * f32(scale),
                            shadow_color: shadow_col_v4,
                            blur: wc.blur,
                            blur_xray: false,
                            blur_opacity: ov_eff_alpha,
                            is_overlay: true,
                        })
                    }
                }
            }
        }
    } else if not self.overlay_visible and not self.anims.overlay_alpha.active {
        // Release GPU overlay texture once its hide animation completes to minimize VRAM/RSS.
        if let Some(old) = self.overlay_img.take() {
            self.d.drop_image(old)
            self.overlay_w = 0.0
            self.overlay_h = 0.0
            self.overlay_dirty = true
        }
    }

    // 4. Push visual effects sheet to PastelRenderer before updating luminaria's placement list.
    let blur_cfg = ren.BlurSettings {
        enabled: wc.blur,
        xray: wc.blur_xray,
        passes: wc.blur_passes,
        offset: wc.blur_offset,
    }
    for oi in 0..n_outs {
        self.sheet.set_output_all(oi, self.cfg.background, blur_cfg, mem.replace(mut out_effects[oi], []), mem.replace(mut out_closing[oi], []), mem.replace(mut out_tabs[oi], []), mem.replace(mut out_frames[oi], []))
    }

    // 5. Commit placement list to luminaria.
    let ov_img_opt = self.overlay_img
    let ov_rad = wc.corner_radius
    let ov_shd = wc.shadow_size
    self.d.layout(fn(mut l) {
        for (w, scoped_out, x, y, op, rad, shd, sc, block_cap) in place_wins {
            let st = lum.Style { opacity: op, radius: rad, shadow: shd, scale: sc, transition_ms: 0, block_capture: block_cap }
            if let Some(so) = scoped_out {
                l.window_on(w, so, x, y, st)
            } else {
                l.window(w, x, y, st)
            }
        }
        if show_ov {
            if let Some(img) = ov_img_opt {
                l.image(img, ov_x, ov_y, ov_w, ov_h, lum.Style { opacity: ov_eff_alpha, radius: ov_rad, shadow: ov_shd, scale: 1.0, transition_ms: 0 })
            }
        }
    })
    // Running animations ask for the next frame; idle, none is drawn.
    if self.anims.is_active() {
        self.d.want_frame()
    }
    if any_size_txn {
        self.d.end(25)
    }
    self.targets_scratch = targets
    self.overview_targets_scratch = ov_targets
    self.win_draw_scratch = win_draws
    self.place_scratch = place_wins
    self.ws_off_scratch = ws_off_y
    self.out_effects_scratch = out_effects
    self.out_closing_scratch = out_closing
    self.out_tabs_scratch = out_tabs
    self.out_frames_scratch = out_frames
    self.ov_idx_scratch = ov_idx
    self.ov_seen_scratch = ov_seen
}

/// `v` on the physical pixel grid of scale `k`.
fn snap_px(v: f64, k: f64) -> f64 {
    return (v * k).round() / k
}

fn Pastel[O, R].send_ipc(mut self, fd: int, payload: str) -> bool {
    guard let Some(got) = self.ipc_srv.take() else {
        return false
    }
    var srv = got
    let ok = srv.send(fd, payload)
    if not ok {
        srv.disconnect(fd)
        self.d.unwatch(fd)
    }
    self.ipc_srv = Some(srv)
    return ok
}

/// Dispatch readable IPC socket fd (`tok_ipc_listen` or client token) in exact request arrival order.
pub fn Pastel[O, R].handle_ipc_ready(mut self, token: int) {
    guard let Some(got) = self.ipc_srv.take() else {
        return
    }
    var srv = got
    if token == tok_ipc_listen {
        let fds = srv.accept_all()
        for fd in fds {
            self.d.watch(fd, tok_ipc_client_base + fd)
        }
        self.ipc_srv = Some(srv)
        return
    }
    if token >= tok_ipc_client_base {
        let fd = token - tok_ipc_client_base
        let (lines, closed) = srv.read_lines(fd)
        self.ipc_srv = Some(srv)

        var alive = true
        for line in lines {
            if not alive {
                break
            }
            match ipc.server.decode_request(line) {
                Ok(Action(act_str)) => {
                    let reply = match cfg.Action.parse(act_str) {
                        Ok(act) => match input.dispatch_action(mut self, act) {
                            Ok => ipc.server.encode_ok()
                            Err(e) => ipc.server.encode_err(e)
                        }
                        Err(e) => ipc.server.encode_err(e)
                    }
                    alive = self.send_ipc(fd, reply)
                }
                Ok(State) => {
                    let st = self.state_json()
                    alive = self.send_ipc(fd, st)
                }
                Ok(Subscribe) => {
                    if let Some(got2) = self.ipc_srv.take() {
                        var s2 = got2
                        s2.mark_subscribed(fd)
                        self.ipc_srv = Some(s2)
                    }
                }
                Err(e) => {
                    alive = self.send_ipc(fd, ipc.server.encode_err(e))
                }
            }
        }
        if closed and alive {
            self.d.unwatch(fd)
            if let Some(got2) = self.ipc_srv.take() {
                var s2 = got2
                s2.disconnect(fd)
                self.ipc_srv = Some(s2)
            }
        }
        return
    }
    self.ipc_srv = Some(srv)
}

/// Process a single luminaria `Event`.
pub fn Pastel[O, R].handle_event(mut self, e: lum.Event) {
    match e {
        OutputAdded(o) => outputs.on_output_added(mut self, o)
        OutputChanged(o) => outputs.on_output_changed(mut self, o)
        OutputRemoved(o) => outputs.on_output_removed(mut self, o)
        OutputArea => {
            outputs.sync_outputs(mut self)
            self.needs_layout = true
        }
        DeviceAdded(dev, desc) => {
            var found = false
            for i in 0..self.input_devices.len() {
                if self.input_devices[i].0 == dev {
                    self.input_devices[i] = (dev, desc.clone())
                    found = true
                    break
                }
            }
            if not found {
                self.input_devices.push((dev, desc.clone()))
            }
            outputs.apply_input_config(mut self, dev, desc)
        }
        DeviceRemoved(dev) => {
            for i in 0..self.input_devices.len() {
                if self.input_devices[i].0 == dev {
                    discard self.input_devices.remove(i)
                    break
                }
            }
        }
        Locked(on) => {
            if on {
                let now = time.now_ns()
                if self.overlay_visible {
                    self.set_overlay_visible(false, now)
                }
                if self.overview_open {
                    self.set_overview_open(false, now)
                }
            }
            if self.has_ipc_subscribers() {
                self.broadcast_event("locked", json.obj().with("locked", json.Value.Bool(on)))
            }
            self.needs_layout = true
        }
        Bell(w_opt) => {
            let wid = w_opt.map(fn(w) => windows.window_id(w)).unwrap_or(u64(0))
            if wid != 0 {
                self.anims.trigger_bell(wid, time.now_ns())
                self.needs_layout = true
            }
            if self.has_ipc_subscribers() {
                self.broadcast_event("bell", json.obj().with("window_id", json.Value.Int(int(wid))))
            }
        }
        Timer(tok) => {
            if tok == tok_cursor_hide {
                self.cursor_timer_pending = false
                let ms = self.cfg.cursor.hide_after_inactive_ms
                if ms > 0 and not self.cursor_hidden {
                    let elapsed_ms = (time.now_ns() - self.cursor_last_motion_ns) / 1000000
                    let rem = ms - elapsed_ms
                    if rem <= 20 {
                        self.d.hide_cursor()
                        self.cursor_hidden = true
                    } else {
                        self.cursor_timer_pending = true
                        self.d.timer(rem, tok_cursor_hide)
                    }
                }
            }
        }
        Frame(_, vblank_ns) => {
            if self.held_since > 0 or not self.pending_fixed_check.is_empty() {
                let now = time.now_ns()
                if self.held_since > 0 {
                    // No frame was drawn while the transaction waited for clients.
                    self.anims.delay(now - self.held_since)
                    self.held_since = 0
                }
                if not self.pending_fixed_check.is_empty() {
                    windows.check_late_auto_float(mut self, now)
                }
            }
            if self.anims.is_active() or self.needs_layout {
                self.sync_layout(vblank_ns)
            }
        }
        WindowNew(w) => windows.on_window_new(mut self, w)
        WindowMapped(w) => windows.on_window_mapped(mut self, w)
        WindowUnmapped(w) => windows.on_window_unmapped(mut self, w)
        WindowClosed(w) => windows.on_window_unmapped(mut self, w)
        WindowTitle(w) => {
            let id = windows.window_id(w)
            if not self.has_title_rules and self.meta_rule_done.get(id).unwrap_or(false) {
                var can_skip = self.auto_float_done.get(id).unwrap_or(false)
                if not can_skip {
                    let (mnw, mnh, mxw, mxh) = self.d.size_hints(w)
                    can_skip = self.d.parent(w).is_none() and not self.d.modal(w) and not windows.is_fixed_size(mnw, mnh, mxw, mxh)
                }
                if can_skip {
                    if self.desktop.locate(id).is_some() {
                        self.broadcast_window_changed(id)
                    }
                } else {
                    windows.on_window_meta(mut self, w)
                }
            } else {
                windows.on_window_meta(mut self, w)
            }
        }
        WindowAppId(w) => windows.on_window_meta(mut self, w)
        WindowParent(w) => windows.on_window_parent(mut self, w)
        WindowResized(w, _, _) => windows.on_window_resized(mut self, w)
        WindowDecoration(w, _) => self.d.decorate(w, true)
        RequestActivate(w) => {
            let id = windows.window_id(w)
            var prev_target_ws = -1
            if let Some(loc) = self.desktop.locate(id) {
                if loc.monitor_idx < self.desktop.monitors.len() {
                    prev_target_ws = self.desktop.monitors[loc.monitor_idx].active_ws
                }
            }
            if self.desktop.focus_window(id) {
                let cur_mon = self.desktop.active_monitor
                let cur_ws = if cur_mon < self.desktop.monitors.len() { self.desktop.monitors[cur_mon].active_ws } else { -1 }
                if prev_target_ws >= 0 and cur_ws != prev_target_ws {
                    input.notify_ws_change(mut self, time.now_ns())
                } else {
                    self.sync_focus()
                    self.needs_layout = true
                }
            }
        }
        OutputConfig(c, only_test) => {
            let ok = self.d.apply_output_config(c, only_test)
            self.d.output_config_done(c, ok)
            if ok and not only_test {
                outputs.sync_outputs(mut self)
                if (outputs.active_output_scale(self) - self.overlay_scale).abs() > 0.05 {
                    self.invalidate_overlay()
                }
                self.needs_layout = true
            }
        }
        RequestMaximize(w, on) => windows.on_request_maximize(mut self, w, on)
        RequestFullscreen(w, target_out, on) => windows.on_request_fullscreen(mut self, w, target_out, on)
        Moved(w, dx, dy) => windows.on_moved(mut self, w, dx, dy)
        WindowDragged(w) => windows.on_window_dragged(mut self, w)
        RequestClose(w) => input.close_window(mut self, w)
        Resized(w, dx, dy, width, height) => windows.on_resized(mut self, w, dx, dy, width, height)
        Panned(dx, _) => {
            if not self.desktop.monitors.is_empty() {
                let mi = self.desktop.active_monitor
                let wi = self.desktop.monitors[mi].active_ws
                let area = self.desktop.monitors[mi].usable_rect
                let gap = self.desktop.gap
                self.desktop.monitors[mi].workspaces[wi].strip.pan(-dx)
                self.desktop.monitors[mi].workspaces[wi].strip.pan_end(area, gap)
                self.sync_focus()
                self.needs_layout = true
            }
        }
        Key(k) => {
            if not input.on_key(mut self, k) {
                self.d.accept(e)
            }
        }
        Button(b) => {
            if not input.on_button(mut self, b) {
                self.d.accept(e)
            }
        }
        Motion(m) => {
            input.on_motion(mut self, m)
            self.d.accept(e)
        }
        Scroll(s) => {
            if not input.on_scroll(mut self, s) {
                self.d.accept(e)
            }
        }
        Gesture(g) => {
            if not input.on_gesture(mut self, g) {
                self.d.accept(e)
            }
        }
        GpuReset => {
            self.invalidate_overlay()
            self.needs_layout = true
        }
        Ready(token) => {
            if token == tok_cfg_watch {
                if let Some(got) = self.cfg_watch.take() {
                    var watcher = got
                    let changed = watcher.poll_changed()
                    self.cfg_watch = Some(watcher)
                    if changed {
                        if let Err(err) = reload.reload_config(mut self) {
                            io.eprint("pastel: auto-reload failed: {err}")
                        }
                    }
                }
            } else if token == tok_sighup {
                if let Some(got) = self.sig_watch.take() {
                    let triggered = got.drain()
                    self.sig_watch = Some(got)
                    if triggered {
                        if let Err(err) = reload.reload_config(mut self) {
                            io.eprint("pastel: reload failed: {err}")
                        }
                    }
                }
            } else {
                self.handle_ipc_ready(token)
            }
        }
        _ => self.d.accept(e)
    }
    if self.needs_layout {
        self.sync_layout(time.now_ns())
    }
}

/// Clean shutdown of IPC socket, watchers, xwayland-satellite, and overlay textures.
pub fn Pastel[O, R].shutdown(mut self) {
    spawn.stop_xwayland(self.xwayland_pid)
    self.xwayland_pid = 0
    if let Some(got) = self.sig_watch.take() {
        var sw = got
        if sw.fd >= 0 {
            self.d.unwatch(sw.fd)
        }
        sw.close()
    }
    if let Some(got) = self.cfg_watch.take() {
        var watcher = got
        if watcher.fd >= 0 {
            self.d.unwatch(watcher.fd)
        }
        watcher.close()
    }
    if let Some(got) = self.ipc_srv.take() {
        var srv = got
        srv.close()
    }
    if let Some(img) = self.overlay_img.take() {
        self.d.drop_image(img)
    }
}
