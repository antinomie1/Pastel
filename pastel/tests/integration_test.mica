// End-to-end headless Wayland integration tests for Pastel.

import std.env
import std.fs
import std.io
import std.json
import std.os
import std.sync
import std.time
import luminaria as lum
import luminaria_wire as wire
import luminaria_proto as proto
import luminaria_proto.wayland as wl
import luminaria_proto.xdg_shell as xdg
import luminaria_proto.ext_session_lock as slock
import luminaria_proto.color_management as cm
import luminaria_proto.wlr_gamma_control_unstable as gamma
import luminaria_proto.wlr_virtual_pointer_unstable as vptr
import pastel_config as cfg
import pastel_render as ren
import pastel_ipc as ipc
import pastel

struct ClientFx {
    c: wire.Conn
    reg: wl.Registry = wl.Registry { id: 0 }
    globals: List[(u32, u16)] = []
}

fn pump[O: lum.plug.Output, R: lum.plug.Renderer](mut p: pastel.compositor.Pastel[O, R], mut fx: ClientFx, ms: int) {
    let end = time.now_ns() + ms * 1000000
    while time.now_ns() < end {
        discard fx.c.flush()
        while true {
            guard let Some(e) = p.d.poll().expect("poll") else {
                break
            }
            p.handle_event(e)
        }
        discard fx.c.read()
        while true {
            match proto.next_event(mut fx.c) {
                Ok(Some(ev)) => {
                    match ev {
                        WlRegistry(_, Global(n, i, _)) => fx.globals.push((n, proto.ifaces.by_name(i)))
                        XdgSurface(xs, Configure(serial)) => xs.ack_configure(mut fx.c, serial)
                        _ => {}
                    }
                }
                Ok(None) => {
                    break
                }
                Err(err) => panic("client protocol error: {err}")
            }
        }
        time.sleep_ms(2)
    }
}

fn bind_global[O: lum.plug.Output, R: lum.plug.Renderer](mut p: pastel.compositor.Pastel[O, R], mut fx: ClientFx, iface: u16, ver: u32) -> u32 {
    if fx.reg.id == 0 {
        fx.reg = wl.Display { id: 1 }.get_registry(mut fx.c)
        pump(mut p, mut fx, 40)
    }
    for (n, i) in fx.globals.clone() {
        if i == iface {
            return fx.reg.bind(mut fx.c, n, iface, ver)
        }
    }
    panic("missing global {proto.ifaces.name(iface)}")
}

fn map_shm_window[O: lum.plug.Output, R: lum.plug.Renderer](mut p: pastel.compositor.Pastel[O, R], mut fx: ClientFx, comp: wl.Compositor, shm: wl.Shm, wm: xdg.WmBase, app_id: str, title: str, w: i32, h: i32) {
    let s = comp.create_surface(mut fx.c)
    let xs = wm.get_xdg_surface(mut fx.c, s)
    let tl = xs.get_toplevel(mut fx.c)
    tl.set_app_id(mut fx.c, app_id)
    tl.set_title(mut fx.c, title)
    s.commit(mut fx.c)
    pump(mut p, mut fx, 30)
    let fd = os.memfd("shm-win", int(w * h * 4)).expect("memfd")
    let pool = shm.create_pool(mut fx.c, fd, w * h * 4)
    os.close(fd)
    let buf = pool.create_buffer(mut fx.c, 0, w, h, w * 4, wl.ShmFormat.Argb8888)
    s.attach(mut fx.c, Some(buf), 0, 0)
    s.commit(mut fx.c)
    pump(mut p, mut fx, 40)
}

test "end-to-end headless Pastel tiles Wayland clients, animates scrolling, toggles overlay, and serves IPC" {
    let dir = fs.create_temp_dir("pastel-e2e").expect("temp dir")
    discard env.set("XDG_RUNTIME_DIR", dir)

    let sheet = ren.EffectSheet.new()
    guard let Ok(comp_ren) = ren.PastelRenderer.open(false, sheet.clone()) else {
        io.eprint("skipped: no Vulkan device")
        return
    }
    let mode = lum.Mode { width: 1280, height: 720, refresh_mhz: 120000 }
    let opts = lum.Options { backend: lum.Kind.Headless, headless: [mode], title: "Pastel-Test" }
    let be = lum.backend.Backend.open(lum.backend.Options { kind: lum.Kind.Headless, headless: [mode] }).expect("headless backend")
    let disp = lum.display.Display.with(opts, be, comp_ren).expect("display")

    let cfg_text = """
    [overlay]
    at-startup = true

    [[window-rule]]
    app-id = "foot"
    opacity = 0.88
    blur = true
    """
    let config = cfg.from_toml(cfg_text).expect("config")
    var p = pastel.compositor.Pastel.new(disp, config, "", false, sheet)
    defer p.shutdown()
    p.enable_ipc()

    assert(p.overlay_visible)

    // Connect a real Wayland client and map two windows.
    let conn = wire.connect(p.d.socket()).expect("connect wayland")
    var fx = ClientFx { c: conn }
    let comp = wl.Compositor { id: bind_global(mut p, mut fx, wl.compositor_iface, 6) }
    let shm = wl.Shm { id: bind_global(mut p, mut fx, wl.shm_iface, 1) }
    let wm = xdg.WmBase { id: bind_global(mut p, mut fx, xdg.wm_base_iface, 2) }

    map_shm_window(mut p, mut fx, comp, shm, wm, "foot", "Terminal 1", 600, 680)
    map_shm_window(mut p, mut fx, comp, shm, wm, "editor", "Editor 2", 600, 680)

    assert_eq(p.win_by_id.len(), 2)
    assert_eq(p.desktop.monitors[0].workspaces[0].strip.columns.len(), 2)

    // Dismiss startup overlay with an action, then verify IPC state & action dispatch.
    pastel.input.dispatch_action(mut p, cfg.Action.ToggleHotkeyOverlay).expect("toggle overlay")
    assert(not p.overlay_visible)

    let sock = p.ipc_socket_path.clone()
    let ch: sync.Chan[str] = sync.chan(2)
    let ch1 = ch.clone()
    let h = go {
        let s1 = ipc.client.query_state(sock.clone()).expect("ipc state")
        discard ch1.send(s1)
        let s2 = ipc.client.send_action(sock, "focus-column-left").expect("ipc action")
        discard ch1.send(s2)
    }
    pump(mut p, mut fx, 80)
    h.join()
    let st_raw = ch.recv().unwrap()
    let act_raw = ch.recv().unwrap()
    let st = json.parse(st_raw).expect("state json")
    assert_eq(st.get_bool("ok"), Some(true))
    assert_eq(st.get("windows").unwrap().len(), 2)
    let act = json.parse(act_raw).expect("action json")
    assert_eq(act.get_bool("ok"), Some(true))
    assert_eq(p.desktop.monitors[0].workspaces[0].strip.active_col, 0)

    // Render a few frames and verify clean non-empty headless framebuffer readback.
    pump(mut p, mut fx, 60)
    let out = p.d.outputs()[0]
    let fb = p.d.read_output(out).expect("read headless fb")
    assert_eq(fb.len(), 1280 * 720 * 4)
}

test "RequestActivate syncs desktop workspace/focus and inotify auto-reloads config on save" {
    let dir = fs.create_temp_dir("pastel-e2e-watch").expect("temp dir")
    discard env.set("XDG_RUNTIME_DIR", dir.clone())
    let cfg_path = "{dir}/config.toml"
    discard fs.write(cfg_path.clone(), "[layout]\ngap = 12.0\n").expect("write initial config")

    let sheet = ren.EffectSheet.new()
    guard let Ok(comp_ren) = ren.PastelRenderer.open(false, sheet.clone()) else {
        io.eprint("skipped: no Vulkan device")
        return
    }
    let mode = lum.Mode { width: 1280, height: 720, refresh_mhz: 120000 }
    let opts = lum.Options { backend: lum.Kind.Headless, headless: [mode], title: "Pastel-Watch-Test" }
    let be = lum.backend.Backend.open(lum.backend.Options { kind: lum.Kind.Headless, headless: [mode] }).expect("headless")
    let disp = lum.display.Display.with(opts, be, comp_ren).expect("display")

    let config = cfg.load(cfg_path.clone()).expect("load config")
    var p = pastel.compositor.Pastel.new(disp, config, cfg_path.clone(), false, sheet)
    defer p.shutdown()
    p.enable_config_watch()

    let conn = wire.connect(p.d.socket()).expect("connect wayland")
    var fx = ClientFx { c: conn }
    let comp = wl.Compositor { id: bind_global(mut p, mut fx, wl.compositor_iface, 6) }
    let shm = wl.Shm { id: bind_global(mut p, mut fx, wl.shm_iface, 1) }
    let wm = xdg.WmBase { id: bind_global(mut p, mut fx, xdg.wm_base_iface, 2) }

    // Map window on workspace 1, switch to workspace 2, then send RequestActivate for window 1.
    map_shm_window(mut p, mut fx, comp, shm, wm, "app1", "Win 1", 600, 680)
    let w1_id = p.desktop.focused_window().unwrap()
    let w1 = p.win_by_id.get(w1_id).unwrap()
    pastel.input.dispatch_action(mut p, cfg.Action.FocusWorkspace(2)).expect("ws 2")
    assert_eq(p.desktop.monitors[0].active_ws, 1)
    assert(p.desktop.focused_window().is_none())

    p.handle_event(lum.Event.RequestActivate(w1))
    assert_eq(p.desktop.monitors[0].active_ws, 0)
    assert_eq(p.desktop.focused_window(), Some(w1_id))

    // Modify config.toml on disk and verify inotify auto-reload updates gap and repeat-rate live.
    assert_eq(p.desktop.gap, 12.0)
    discard fs.write(cfg_path.clone(), "[layout]\ngap = 24.0\n[input]\nrepeat-rate = 40\nrepeat-delay = 300\n").expect("write updated config")
    pump(mut p, mut fx, 60)
    assert_eq(p.desktop.gap, 24.0)
    assert_eq(p.cfg.input.repeat_rate, 40)
    assert_eq(p.cfg.input.repeat_delay, 300)

    // Verify exact window_key is emitted into EffectSheet (non-zero, no geometry guessing).
    let snap = p.sheet.snapshot(0)
    assert(not snap.items.is_empty())
    assert_eq(snap.items[0].key, p.d.window_key(w1))
    assert(snap.items[0].key != u64(0))

    // Invalid config write must preserve the working gap = 24.0 without crashing.
    discard fs.write(cfg_path, "[layout]\nunknown-bad-key = 1\n").expect("write bad config")
    pump(mut p, mut fx, 60)
    assert_eq(p.desktop.gap, 24.0)

    // Verify rotation-invariant output_scale for portrait 90° outputs (e.g. 2560x1440 rotated to 1440x2560 or 720x1280).
    let mode_4k = lum.Mode { width: 2560, height: 1440, refresh_mhz: 144000 }
    assert((pastel.outputs.output_scale(2560.0, 1440.0, mode_4k) - 1.0).abs() < 0.001)
    assert((pastel.outputs.output_scale(1440.0, 2560.0, mode_4k) - 1.0).abs() < 0.001)
    assert((pastel.outputs.output_scale(720.0, 1280.0, mode_4k) - 2.0).abs() < 0.001)
}

test "end-to-end lock-screen guard, DPMS wake, Overview, tabbed columns, HDR, on-demand VRR, privacy redaction, bell, and new Wayland globals" {
    let dir = fs.create_temp_dir("pastel-e2e-ext").expect("temp dir")
    discard env.set("XDG_RUNTIME_DIR", dir)

    let sheet = ren.EffectSheet.new()
    guard let Ok(comp_ren) = ren.PastelRenderer.open(false, sheet.clone()) else {
        io.eprint("skipped: no Vulkan device")
        return
    }
    let mode = lum.Mode { width: 1280, height: 720, refresh_mhz: 120000 }
    let opts = lum.Options { backend: lum.Kind.Headless, headless: [mode], title: "Pastel-Ext-Test" }
    let be = lum.backend.Backend.open(lum.backend.Options { kind: lum.Kind.Headless, headless: [mode] }).expect("headless")
    let disp = lum.display.Display.with(opts, be, comp_ren).expect("display")

    let cfg_text = """
    [layout]
    always-center-single-column = true

    [input.mouse]
    accel-profile = "flat"

    [cursor]
    hide-when-typing = true

    [[output]]
    name = "HEADLESS-1"
    vrr = "on-demand"
    hdr = true
    sdr-nits = 220.0
    max-nits = 1000.0

    [binds]
    "Mod+P" = \{ action = "power-off-monitors", allow-when-locked = true \}

    [[window-rule]]
    app-id = "secret-vault"
    block-out-from-screencast = true
    open-focused = false
    floating = true
    default-floating-size = [520, 340]

    [[window-rule]]
    app-id = "game-app"
    variable-refresh-rate = true
    """
    let config = cfg.from_toml(cfg_text).expect("extended config")
    var p = pastel.compositor.Pastel.new(disp, config, "", false, sheet)
    defer p.shutdown()

    // 1. Verify HDR enabled on HEADLESS-1 and all new Wayland globals advertised.
    let out0 = p.d.outputs()[0]
    assert(p.d.hdr(out0))
    let conn = wire.connect(p.d.socket()).expect("connect wayland")
    var fx = ClientFx { c: conn }
    let comp = wl.Compositor { id: bind_global(mut p, mut fx, wl.compositor_iface, 6) }
    let shm = wl.Shm { id: bind_global(mut p, mut fx, wl.shm_iface, 1) }
    let wm = xdg.WmBase { id: bind_global(mut p, mut fx, xdg.wm_base_iface, 2) }
    var has_cm = false
    var has_gamma = false
    var has_vptr = false
    var has_lock = false
    for (_, iface) in fx.globals {
        if iface == cm.color_manager_iface {
            has_cm = true
        }
        if iface == gamma.control_manager_iface {
            has_gamma = true
        }
        if iface == vptr.pointer_manager_iface {
            has_vptr = true
        }
        if iface == slock.lock_manager_iface {
            has_lock = true
        }
    }
    assert(has_cm and has_gamma and has_vptr and has_lock)

    // 2. Map game window + unfocused secret floating window with custom size & screencast redaction.
    map_shm_window(mut p, mut fx, comp, shm, wm, "game-app", "Game", 600, 680)
    let game_id = p.desktop.focused_window().unwrap()
    map_shm_window(mut p, mut fx, comp, shm, wm, "secret-vault", "Vault", 520, 340)
    // open-focused = false kept focus on game-app!
    assert_eq(p.desktop.focused_window(), Some(game_id))
    let st_val = json.parse(p.state_json()).expect("state json")
    assert_eq(st_val.get_bool("monitors_powered"), Some(true))
    assert_eq(st_val.get_bool("overview_open"), Some(false))

    // 3. On-demand VRR: OFF when tiled, ON when game-app goes fullscreen, OFF when un-fullscreened.
    let oid0 = pastel.outputs.output_id(out0)
    assert_eq(p.vrr_state.get(oid0), Some(false))
    pastel.input.dispatch_action(mut p, cfg.Action.ToggleFullscreen).expect("fs on")
    p.sync_layout(time.now_ns())
    assert_eq(p.vrr_state.get(oid0), Some(true))
    pastel.input.dispatch_action(mut p, cfg.Action.ToggleFullscreen).expect("fs off")
    p.sync_layout(time.now_ns())
    assert_eq(p.vrr_state.get(oid0), Some(false))

    // 4. Tabbed column emits TabBar into EffectSheet; Bell triggers visual pulse.
    map_shm_window(mut p, mut fx, comp, shm, wm, "editor", "Editor", 600, 680)
    pastel.input.dispatch_action(mut p, cfg.Action.ConsumeOrExpelLeft).expect("consume left")
    pastel.input.dispatch_action(mut p, cfg.Action.ToggleColumnTabbed).expect("tabbed")
    p.sync_layout(time.now_ns())
    let snap_tab = p.sheet.snapshot(0)
    assert_eq(snap_tab.tabs.len(), 1)
    assert_eq(snap_tab.tabs[0].count, 2)

    let game_w = p.win_by_id.get(game_id).unwrap()
    p.handle_event(lum.Event.Bell(Some(game_w)))
    assert(p.anims.bell_alpha(game_id, time.now_ns()) > 0.0)

    // 5. Overview toggle populates overview_bands + OverviewFrame, and 4-finger swipe closes it.
    pastel.input.dispatch_action(mut p, cfg.Action.ToggleOverview).expect("overview on")
    assert(p.overview_open)
    p.sync_layout(time.now_ns() + 500000000)
    assert(not p.overview_bands.is_empty())
    let snap_ov = p.sheet.snapshot(0)
    assert(not snap_ov.frames.is_empty())
    assert(pastel.input.on_gesture(mut p, lum.Gesture { kind: lum.GestureKind.SwipeBegin, fingers: 4 }))
    assert(pastel.input.on_gesture(mut p, lum.Gesture { kind: lum.GestureKind.SwipeUpdate, fingers: 4, dy: -60.0 }))
    assert(pastel.input.on_gesture(mut p, lum.Gesture { kind: lum.GestureKind.SwipeEnd, fingers: 4 }))
    assert(not p.overview_open)

    // 6. DPMS power-off disables outputs; any input auto-wakes them.
    pastel.input.dispatch_action(mut p, cfg.Action.PowerOffMonitors).expect("dpms off")
    assert(not p.monitors_powered)
    assert(not p.d.output_enabled(out0))
    pastel.input.on_motion(mut p, lum.Pointer { x: 100.0, y: 100.0 })
    assert(p.monitors_powered)
    assert(p.d.output_enabled(out0))

    // 7. Lock-screen security: lock via ext-session-lock-v1; normal Mod+O is blocked, allow-when-locked Mod+P fires!
    let lm = slock.LockManager { id: bind_global(mut p, mut fx, slock.lock_manager_iface, 1) }
    let lock_obj = lm.lock(mut fx.c)
    pump(mut p, mut fx, 40)
    assert(p.d.locked())
    let mod_super = lum.Mods { logo: true }
    // Normal shortcut Mod+O must NOT fire while locked.
    let consumed_o = pastel.input.on_key(mut p, lum.Key { code: 24, sym: u32(0x6f), base_sym: u32(0x6f), pressed: true, mods: mod_super })
    assert(not consumed_o)
    assert(not p.overview_open)
    // Explicitly allowed `Mod+P` (`allow-when-locked = true`) MUST fire while locked!
    let consumed_p = pastel.input.on_key(mut p, lum.Key { code: 25, sym: u32(0x70), base_sym: u32(0x70), pressed: true, mods: mod_super })
    assert(consumed_p)
    assert(not p.monitors_powered)
    lock_obj.unlock_and_destroy(mut fx.c)
    pump(mut p, mut fx, 40)
    assert(not p.d.locked())
}
