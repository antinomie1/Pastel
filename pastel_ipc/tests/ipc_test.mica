import std.fs
import std.json
import std.net
import std.path
import std.sync
import std.time
import pastel_ipc as ipc

test "IPC server handles action, state query, and subscriber broadcasts" {
    let dir = fs.create_temp_dir("pastel-ipc-test").expect("temp dir")
    let sock = path.join(dir, "pastel-test.sock")
    var srv = ipc.IpcServer.open(sock).expect("open ipc")
    defer srv.close()

    // Spawn a client sending an action request in a background thread.
    let ch: sync.Chan[str] = sync.chan(1)
    let ch_c = ch.clone()
    let h = go {
        let r = ipc.client.send_action(sock, "focus-workspace 2").expect("client reply")
        discard ch_c.send(r)
    }

    var handled = false
    for _ in 0..100 {
        let fds = srv.accept_all()
        for fd in fds {
            for _ in 0..50 {
                let (lines, _) = srv.read_lines(fd)
                for line in lines {
                    match ipc.server.decode_request(line).expect("decode") {
                        Action(act) => {
                            assert_eq(act, "focus-workspace 2")
                            assert(srv.send(fd, ipc.server.encode_ok()))
                            handled = true
                        }
                        _ => panic("unexpected request")
                    }
                }
                if handled {
                    break
                }
                time.sleep_ms(2)
            }
        }
        if handled {
            break
        }
        time.sleep_ms(2)
    }
    assert(handled)
    h.join()
    let resp = ch.recv().unwrap()
    let v = json.parse(resp).expect("json")
    assert_eq(v.get_bool("ok"), Some(true))
}

test "IPC server handles pipelined lines, subscriber count tracking, and multi-chunk buffered replies" {
    let dir = fs.create_temp_dir("pastel-ipc-pipe").expect("temp dir")
    let sock = path.join(dir, "pastel-pipe.sock")
    var srv = ipc.IpcServer.open(sock.clone()).expect("open ipc")
    defer srv.close()

    assert(not srv.has_subscribers())
    let c1 = net.unix_connect(sock.clone()).expect("connect 1")
    defer c1.close()
    var fd1 = -1
    for _ in 0..50 {
        let fds = srv.accept_all()
        if not fds.is_empty() {
            fd1 = fds[0]
            break
        }
        time.sleep_ms(1)
    }
    assert(fd1 >= 0)

    // Pipelined 3 lines in a single write (including CRLF).
    let batch = "\{\"cmd\":\"state\"\}\r\n\{\"cmd\":\"action\",\"action\":\"focus-column-left\"\}\n\{\"cmd\":\"subscribe\"\}\n"
    discard c1.write(batch).expect("write batch")
    var got: List[str] = []
    for _ in 0..50 {
        let (lines, _) = srv.read_lines(fd1)
        for l in lines {
            got.push(l.clone())
        }
        if got.len() >= 3 {
            break
        }
        time.sleep_ms(1)
    }
    assert_eq(got.len(), 3)
    assert(ipc.server.decode_request(got[0]).is_ok())
    assert(ipc.server.decode_request(got[1]).is_ok())
    assert(ipc.server.decode_request(got[2]).is_ok())

    // Duplicate mark_subscribed counts only once; disconnect drops sub_count back to 0.
    srv.mark_subscribed(fd1)
    srv.mark_subscribed(fd1)
    assert(srv.has_subscribers())
    discard srv.broadcast(ipc.server.encode_ok())
    srv.disconnect(fd1)
    assert(not srv.has_subscribers())

    // Verify buffered client LineReader handles >8 KiB responses cleanly.
    var big_msg = ""
    for _ in 0..300 {
        big_msg += "0123456789abcdef0123456789abcdef"
    }
    let big_payload = ipc.server.encode_event("big", json.Value.Str(big_msg.clone()))
    let ch: sync.Chan[str] = sync.chan(1)
    let ch2 = ch.clone()
    let h = go {
        let r = ipc.client.query_state(sock).expect("big query")
        discard ch2.send(r)
    }
    var answered = false
    for _ in 0..100 {
        for fd in srv.accept_all() {
            for _ in 0..50 {
                let (lines, _) = srv.read_lines(fd)
                if not lines.is_empty() {
                    assert(srv.send(fd, big_payload.clone()))
                    answered = true
                    break
                }
                time.sleep_ms(1)
            }
        }
        if answered {
            break
        }
        time.sleep_ms(1)
    }
    assert(answered)
    h.join()
    let received = ch.recv().unwrap()
    let parsed = json.parse(received).expect("parse big")
    assert_eq(parsed.get_str("event"), Some("big"))
    assert_eq(parsed.get("data").unwrap().as_str().unwrap().len(), big_msg.len())
}
